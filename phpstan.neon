parameters:
    level: 5

    paths:
        - src

    # ─────────────────────────────────────────────────────────────────────────
    # RÈGLES STATIQUES ACTIVÉES (6 règles majeures)
    # ─────────────────────────────────────────────────────────────────────────

    # Règle 1 : Détecter les itérables sans type de valeur documenté
    checkMissingIterableValueType: true

    # Règle 2 : Détecter les génériques utilisés sans paramètre de type
    checkGenericClassInNonGenericObjectType: true

    # Règle 3 : Détecter les PHPDoc @return manquants
    checkPhpDocMissingReturn: true

    # Règle 4 : Vérifier les Union Types
    checkUnionTypes: true

    # Règle 5 : Détecter les propriétés dynamiques non déclarées
    checkDynamicProperties: true

    # Règle 6 : Vérifier la casse des noms de fonctions
    checkFunctionNameCase: true

    # Ne pas reporter les patterns ignorés qui ne matchent pas
    reportUnmatchedIgnoredErrors: false

    # ─────────────────────────────────────────────────────────────────────────
    # SUPPRESSIONS — patterns intentionnels ou inévitables dans Symfony
    # ─────────────────────────────────────────────────────────────────────────
    ignoreErrors:

        # 1. Symfony getUser() retourne UserInterface pas App\Entity\User —
        #    Pattern Symfony standard : comportement attendu dans tous les controllers.
        - '#UserInterface given#'
        - '#UserInterface::[a-zA-Z]+\(\)#'

        # 2. Request::get() retourne mixed — cast intentionnel dans les controllers
        - '#bool\|float\|int\|string\|null given#'

        # 3. json_decode peut retourner false (PHP < 8.0 signature)
        - '#json_decode expects string, string\|false given#'

        # 4. Doctrine EntityManager — méthodes sur interface abstraite
        - '#Call to an undefined method Doctrine\\ORM\\EntityManagerInterface#'

        # 5. Symfony interne — trigger_deprecation
        - '#Function trigger_deprecation not found#'

        # 6. PHPUnit mocks — intersection types non analysables
        - '#MockObject#'

        # 7. Scheb TwoFactor — getFullName n'est pas dans l'interface
        - '#TwoFactorInterface::getFullName#'

        # 8. ProfileCompletionService — clé toujours présente (faux-positif)
        - '#always exists and is not nullable#'

        # 9. Props write-only intentionnelles (workers, injections)
        - '#is never read, only written#'

        # 10. While(true) intentionnel (WebSocket server)
        - '#While loop condition is always true#'

        # 11. Ternary always true (données PHPDoc dans SeedCommand)
        - '#Ternary operator condition is always true#'

        # 12. Comparaisons strictes intentionnelles
        - '#Strict comparison using === between#'

        # 13. KnpPaginator et ChartJS — types non définis dans stubs
        - '#has invalid type Knp\\Component\\Pager\\PaginatorInterface#'
        - '#has invalid type Symfony\\UX\\Chartjs\\Builder\\ChartBuilderInterface#'
        - '#Knp\\Component\\Pager\\Pagination\\PaginationInterface#'

        # 14. ChartJS unknown class — bundle non analysé
        - '#on an unknown class Symfony\\UX\\Chartjs\\#'
        - '#Call to method .* on an unknown class Symfony\\UX\\Chartjs\\#'

        # 15. KnpPaginator — unknown class au runtime
        - '#Call to method paginate\(\) on an unknown class#'

        # 16. Repository extends generic ServiceEntityRepository sans type param
        - '#Class App\\Repository\\.* extends generic class#'

        # 17. Voter extends generic class
        - '#Class App\\Security\\.* extends generic class#'

        # 18. UserInterface manquant des méthodes de App\Entity\User (setAuthor, setCandidat, etc.)
        - '#Parameter .* expects App\\Entity\\User, Symfony\\Component\\Security\\Core\\User\\UserInterface given#'

        # 19. Concaténation de mixed (getUser() non typé)
        - '#Binary operation "\." between mixed and string#'
        - '#Binary operation "\." between string and mixed#'

        # 20. strlen/preg_match/json_decode sur mixed (request->get() ou getUser())
        - '#function strlen expects string, mixed given#'
        - '#function preg_match expects string, mixed given#'
        - '#function json_decode expects string, mixed given#'

        # 21. Call to getId() on object (Doctrine lazy proxy)
        - '#Call to an undefined method object::getId\(\)#'

        # 22. Constant FIELDS dans CandidatureCompletenessService (class constant access)
        - '#Constant App\\Service\\CandidatureCompletenessService::FIELDS#'

        # 23. CandidatureNotificationOrchestrator — méthodes non définies sur UserInterface
        - '#App\\Service\\CandidatureNotificationOrchestrator#'

        # 24. CountryService — méthode getCountryInfo return type
        - '#Method App\\Service\\CountryService::getCountryInfo\(\)#'

        # 25. CategorieBusinessService — param type
        - '#Parameter .* of method App\\Service\\CategorieBusinessService#'

        # 26. OpenAI return type mismatch (PHPDoc strict return shape)
        - '#App\\Service\\OpenAiCandidatureRecommendationService#'

        # 27. treatPhpDocTypesAsCertain — ternary PHPDoc
        - '#Else branch is unreachable because ternary operator condition is always true#'

        # 28. strlen/preg_match sur string|false (file_get_contents)
        - '#function strlen expects string, string\|false given#'
        - '#function preg_match expects string, bool\|float\|int\|string\|null given#'
        - '#function json_decode expects string, string\|false given#'

        # 29. setContent/setAuthor/setCandidature/setChangedBy — UserInterface attendue App\Entity\User
        - '#expects App\\Entity\\User, Symfony\\Component\\Security\\Core\\User\\UserInterface given#'

        # 30. CandidatureController::buildCandidatureCharts return type
        - '#Method App\\Controller\\CandidatureController::buildCandidatureCharts#'

        # 31. Binary concat entre mixed et string (getUser()->getId(), etc.)
        - '#Binary operation "\." between#'

        # 32. Call to undefined method (MessageController, etc.)
        - '#Call to an undefined method Symfony\\Component\\Security\\Core\\User\\UserInterface#'

        # 33. CountryApiController — localisation et countryCode mixed
        - '#CountryApiController#'
        - '#CountryService#'
        - '#CurrencyConverterService#'
        - '#HaveIBeenPwnedService#'

        # 34. Expression on left side of ?? is not nullable (LiveCodingRunnerService)
        - '#Expression on left side of \?\? is not nullable#'

        # 35. CandidatureCompletenessService::FIELDS constant
        - '#Constant App\\Service\\CandidatureCompletenessService#'

        # 36. CategorieBusinessService param type
        - '#CategorieBusinessService#'

        # 37. ChatbotController — user param type
        - '#ChatbotController#'

        # 38. ResetPasswordController — password/preg_match
        - message: '#preg_match expects string#'
          reportUnmatched: false
        - message: '#plainPassword#'
          reportUnmatched: false

        # 39. CallController — setContent mixed
        - '#Message::setContent#'

        # 40. PostController — json_decode string|false, setAuthor/setComment
        - message: '#setAuthor#'
          reportUnmatched: false
        - message: '#json_decode expects string, string\|false#'
          reportUnmatched: false

        # 41. LanguageDetector — preg_match_all retourne array|false, foreach
        - '#Argument of an invalid type array.*\|false supplied for foreach#'

        # 42. DailyService — json_decode string|false
        - message: '#json_decode expects string, mixed#'
          reportUnmatched: false
        - message: '#json_decode expects string#'
          reportUnmatched: false

        # 43. EntrepriseBusinessService/CategorieBusinessService — param type
        - '#CategorieBusinessService#'
        - '#EntrepriseBusinessService#'
        - message: '#expects Closure.*Offre.*Closure\(mixed\)#'
          reportUnmatched: false

        # 44. CountryApiController — strlen mixed
        - message: '#strlen expects string#'
          reportUnmatched: false

        # 45. CandidatureController — UserInterface param
        - message: '#expects App\\Entity\\User#'
          reportUnmatched: false

        # 46. MessageController — undefined method on UserInterface
        - message: '#Call to an undefined method#'
          reportUnmatched: false

    # ─────────────────────────────────────────────────────────────────────────
    # EXCLUSIONS
    # ─────────────────────────────────────────────────────────────────────────
    excludePaths:
        - src/Kernel.php
        - vendor
        - var
        - migrations
