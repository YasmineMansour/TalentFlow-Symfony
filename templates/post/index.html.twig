        document.getElementById('newPostTitle').value = '';
        document.getElementById('newPostContent').value = '';
        newPostImageUrl = '';
        newPostAudioData = '';
        document.getElementById('newPostImagePreview').classList.remove('visible');
        document.getElementById('newPostImagePreview').innerHTML = '';
        const imgBtn = document.getElementById('newPostImageBtn');
        if (imgBtn) imgBtn.classList.remove('active');
