    function closeEditPostModal() {
        editPostOverlay.classList.remove('active');
        editingPostId = null;
    }

    function handleOpenEdit(e) {
        e.preventDefault();
        const id = this.dataset.id;
        if (id) openEditPostModal(id);
    }

    document.getElementById('closeEditPost').addEventListener('click', closeEditPostModal);
    document.getElementById('cancelEditPost').addEventListener('click', closeEditPostModal);
    editPostOverlay.addEventListener('click', function(e) {
        if (e.target === editPostOverlay) closeEditPostModal();
    });

    document.getElementById('submitEditPost').addEventListener('click', function() {
        const btn = this;
        const title = document.getElementById('editPostTitle').value.trim();
        const content = document.getElementById('editPostContent').value.trim();

        editPostErrors.innerHTML = '';
        btn.disabled = true;

        fetch('/post/edit-ajax/' + editingPostId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ title, content, imagePath: editPostImageUrl, audioPath: editPostAudioData === '__remove__' ? '' : (editPostAudioData || null) })
        })
        .then(r => r.json())
        .then(data => {
            btn.disabled = false;
            if (!data.success) {
                editPostErrors.innerHTML = data.errors.map(e => '<li>' + esc(e) + '</li>').join('');
                return;
            }
            closeEditPostModal();
            // Replace the card in the feed
            const card = document.querySelector(`.ln-post-card[data-post-id="${editingPostId}"]`);
            if (card) {
                card.outerHTML = renderPost(data.post);
                bindAll();
            }
            if (currentDisplayLang) {
                const updatedCard = document.querySelector(`.ln-post-card[data-post-id="${editingPostId}"]`);
                if (updatedCard) translateCard(updatedCard, currentDisplayLang);
            }
        })
        .catch(() => {
            btn.disabled = false;
            editPostErrors.innerHTML = '<li>Erreur réseau, réessayez.</li>';
        });
    });

    /* ══════════════════════════════════════════════
       MEDIA HELPERS (Image upload)
       ══════════════════════════════════════════════ */
    function uploadToImgBB(file) {
        return new Promise((resolve, reject) => {
            const fd = new FormData();
            fd.append('image', file);
            fetch('https://api.imgbb.com/1/upload?key=' + IMGBB_KEY, {
                method: 'POST',
                body: fd,
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) resolve(data.data.url);
                else reject(data.error?.message || 'Upload failed');
            })
            .catch(reject);
        });
    }

    function showImagePreview(containerId, url, prefix) {
        const c = document.getElementById(containerId);
        c.innerHTML = `<img src="${url}" alt="Preview"><button class="media-remove-btn" data-prefix="${prefix}" data-type="image">&times;</button>`;
        c.classList.add('visible');
        c.querySelector('.media-remove-btn').addEventListener('click', function() {
            if (prefix === 'new') newPostImageUrl = '';
            else editPostImageUrl = '';
            c.innerHTML = '';
            c.classList.remove('visible');
            document.getElementById(prefix + 'PostImageBtn').classList.remove('active');
        });
    }

    function setupImageButton(prefix) {
        const btn = document.getElementById(prefix + 'PostImageBtn');
        const input = document.getElementById(prefix + 'PostImageFile');
        const previewId = prefix + 'PostImagePreview';

        btn.addEventListener('click', () => input.click());
        input.addEventListener('change', function() {
            const file = this.files[0];
            if (!file) return;
            if (file.size > 10 * 1024 * 1024) {
                alert('Image trop grande (max 10 Mo).');
                return;
            }
            btn.classList.add('active');
            const prevEl = document.getElementById(previewId);
            prevEl.innerHTML = '<div class="media-uploading"><span class="spinner"></span> Upload en cours...</div>';
            prevEl.classList.add('visible');

            uploadToImgBB(file).then(url => {
                if (prefix === 'new') newPostImageUrl = url;
                else editPostImageUrl = url;
                showImagePreview(previewId, url, prefix);
            }).catch(err => {
                prevEl.innerHTML = '';
                prevEl.classList.remove('visible');
                btn.classList.remove('active');
                alert('Échec upload image : ' + err);
            });
            this.value = '';
        });
    }

    setupImageButton('new');
    setupImageButton('edit');

    /* ══════════════════════════════════════════════
       VOICE MEMO RECORDER
       ══════════════════════════════════════════════ */
    let newPostAudioData = '';
    let editPostAudioData = '';

    function setupVoiceRecorder(prefix) {
        const voiceBtn = document.getElementById(prefix + 'PostVoiceBtn');
        const wrap = document.getElementById(prefix + 'PostVoiceWrap');
        const recBtn = document.getElementById(prefix + 'PostRecBtn');
        const timer = document.getElementById(prefix + 'PostRecTimer');
        const preview = document.getElementById(prefix + 'PostRecPreview');

        let mediaRecorder = null;
        let audioChunks = [];
        let timerInterval = null;
        let seconds = 0;

        voiceBtn.addEventListener('click', function() {
            wrap.classList.toggle('hidden');
            voiceBtn.classList.toggle('active');
        });

        recBtn.addEventListener('click', async function() {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                // Stop recording
                mediaRecorder.stop();
                return;
            }
            // Start recording
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                audioChunks = [];
                seconds = 0;
                timer.textContent = '0:00';
                preview.innerHTML = '';
                recBtn.classList.add('recording');
                recBtn.innerHTML = '<i class="fas fa-stop"></i>';

                mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
                mediaRecorder.ondataavailable = function(e) {
                    if (e.data.size > 0) audioChunks.push(e.data);
                };
                mediaRecorder.onstop = function() {
                    clearInterval(timerInterval);
                    recBtn.classList.remove('recording');
                    recBtn.innerHTML = '<i class="fas fa-microphone"></i>';
                    stream.getTracks().forEach(t => t.stop());

                    const blob = new Blob(audioChunks, { type: 'audio/webm' });
                    const reader = new FileReader();
                    reader.onloadend = function() {
                        const dataUrl = reader.result;
                        if (prefix === 'new') newPostAudioData = dataUrl;
                        else editPostAudioData = dataUrl;

                        preview.innerHTML = `
                            <audio controls src="${dataUrl}" style="height:32px;flex:1;max-width:200px;"></audio>
                            <button type="button" class="voice-rec-remove" title="Supprimer">&times;</button>
                        `;
                        preview.querySelector('.voice-rec-remove').addEventListener('click', function() {
                            if (prefix === 'new') newPostAudioData = '';
                            else editPostAudioData = '';
                            preview.innerHTML = '';
                            timer.textContent = '0:00';
                        });
                    };
                    reader.readAsDataURL(blob);
                };
                mediaRecorder.start();
                timerInterval = setInterval(function() {
                    seconds++;
                    const m = Math.floor(seconds / 60);
                    const s = seconds % 60;
                    timer.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                }, 1000);
            } catch(err) {
                alert('Impossible d\'accéder au microphone. Vérifiez les permissions.');
            }
        });
    }

    setupVoiceRecorder('new');
    setupVoiceRecorder('edit');

    // Initial bind
    bindAll();

    /* ══════════════════════════════════════════════
       STATISTICS CHARTS (Chart.js)
       ══════════════════════════════════════════════ */
    const activityCtx = document.getElementById('activityChart');
    if (activityCtx) {
        const activityData = {{ postsPerDay|json_encode|raw }};
        const existingActivity = Chart.getChart(activityCtx);
        if (existingActivity) existingActivity.destroy();
        new Chart(activityCtx, {
            type: 'bar',
            data: {
                labels: activityData.map(d => d.label),
                datasets: [{
                    label: 'Posts',
                    data: activityData.map(d => d.count),
                    backgroundColor: 'rgba(212, 168, 67, 0.6)',
                    borderColor: 'var(--tf-gold)',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { color: 'var(--tf-gray)', stepSize: 1 },
                        grid: { color: 'var(--tf-border)' }
                    },
                    x: {
                        ticks: { color: 'var(--tf-gray)' },
                        grid: { color: 'var(--tf-border)' }
                    }
                }
            }
        });
    }

    const authorsCtx = document.getElementById('authorsChart');
    if (authorsCtx) {
        const topAuthorsData = {{ topAuthors|json_encode|raw }};
        const colors = ['#d4a843', '#5dade2', '#2ecc71', '#f39c12', '#e74c3c'];
        new Chart(authorsCtx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(topAuthorsData),
                datasets: [{
                    data: Object.values(topAuthorsData),
                    backgroundColor: colors.slice(0, Object.keys(topAuthorsData).length),
                    borderColor: 'var(--tf-card-bg)',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { color: 'var(--tf-gray)', padding: 12, font: { size: 11 } }
                    }
                }
            }
        });
    }

    /* ══════════════════════════════════════════════
       LANGUAGE PICKER
       ══════════════════════════════════════════════ */
    (function initLangPicker() {
        const pickerBtn = document.getElementById('langPickerBtn');
        const pickerMenu = document.getElementById('langPickerMenu');
        const pickerCurrent = document.getElementById('langPickerCurrent');
        const options = pickerMenu.querySelectorAll('.lang-picker-option[data-lang]');
        const showOriginalBtn = document.getElementById('langShowOriginal');

        // Load saved preference
        const saved = localStorage.getItem('tf-display-lang');
        if (saved && ['fr', 'en', 'ar'].includes(saved)) {
            currentDisplayLang = saved;
            pickerCurrent.textContent = saved.toUpperCase();
            updatePickerActive();
            // Translate existing cards
            translateAllCards(saved);
        }

        pickerBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            pickerMenu.classList.toggle('open');
        });

        document.addEventListener('click', function(e) {
            if (!pickerMenu.contains(e.target) && e.target !== pickerBtn) {
                pickerMenu.classList.remove('open');
            }
        });

        options.forEach(opt => {
            opt.addEventListener('click', function() {
                const lang = this.dataset.lang;
                currentDisplayLang = lang;
                localStorage.setItem('tf-display-lang', lang);
                pickerCurrent.textContent = lang.toUpperCase();
                updatePickerActive();
                pickerMenu.classList.remove('open');
                translateAllCards(lang);
            });
        });

        showOriginalBtn.addEventListener('click', function() {
            currentDisplayLang = null;
            localStorage.removeItem('tf-display-lang');
            pickerCurrent.textContent = '—';
            updatePickerActive();
            pickerMenu.classList.remove('open');
            translateAllCards(null);
        });

        function updatePickerActive() {
            options.forEach(o => {
                o.classList.toggle('active', o.dataset.lang === currentDisplayLang);
                const check = o.querySelector('.lang-check');
                if (check) check.style.visibility = (o.dataset.lang === currentDisplayLang) ? 'visible' : 'hidden';
            });
        }
        // Initial state
        updatePickerActive();
    })();

    // ── Chart.js: Sidebar Charts ──
    (function initSidebarCharts() {
        const postsPerDay = {{ postsPerDay|json_encode|raw }};
        const topAuthors = {{ topAuthors|json_encode|raw }};
        const isLight = document.body.classList.contains('light-mode');
        const gridColor = isLight ? 'rgba(0,0,0,0.08)' : 'rgba(255,255,255,0.08)';
        const textColor = isLight ? '#65676b' : '#b0b3b8';

        // Activity bar chart
        const actCtx = document.getElementById('activityChart');
        if (actCtx) {
            const prevActChart = Chart.getChart(actCtx);
            if (prevActChart) prevActChart.destroy();
            new Chart(actCtx, {
                type: 'bar',
                data: {
                    labels: postsPerDay.map(d => d.label),
                    datasets: [{
                        label: 'Posts',
                        data: postsPerDay.map(d => d.count),
                        backgroundColor: 'rgba(212, 168, 67, 0.6)',
                        borderColor: 'rgba(212, 168, 67, 1)',
                        borderWidth: 1,
                        borderRadius: 6,
                        borderSkipped: false,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: isLight ? '#fff' : '#1e1e2e',
                            titleColor: isLight ? '#1c1e21' : '#e4e6eb',
                            bodyColor: isLight ? '#333' : '#b0b3b8',
                            borderColor: 'rgba(212,168,67,0.3)',
                            borderWidth: 1,
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: textColor, font: { size: 10 } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: gridColor },
                            ticks: {
                                color: textColor,
                                font: { size: 10 },
                                stepSize: 1,
                                precision: 0
                            }
                        }
                    }
                }
            });
        }

        // Top authors doughnut
        const authCtx = document.getElementById('authorsChart');
        if (authCtx && Object.keys(topAuthors).length > 0) {
            const prevAuthChart = Chart.getChart(authCtx);
            if (prevAuthChart) prevAuthChart.destroy();
            const authNames = Object.keys(topAuthors);
            const authCounts = Object.values(topAuthors);
            const palette = [
                'rgba(212,168,67,0.85)',
                'rgba(67,160,212,0.85)',
                'rgba(212,67,100,0.85)',
                'rgba(67,212,150,0.85)',
                'rgba(160,67,212,0.85)',
            ];
            new Chart(authCtx, {
                type: 'doughnut',
                data: {
                    labels: authNames,
                    datasets: [{
                        data: authCounts,
                        backgroundColor: palette.slice(0, authNames.length),
                        borderColor: isLight ? '#fff' : '#1e1e2e',
                        borderWidth: 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '55%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: textColor,
                                font: { size: 10 },
                                padding: 8,
                                boxWidth: 12,
                                boxHeight: 12,
                                usePointStyle: true,
                                pointStyle: 'circle',
                            }
                        },
                        tooltip: {
                            backgroundColor: isLight ? '#fff' : '#1e1e2e',
                            titleColor: isLight ? '#1c1e21' : '#e4e6eb',
                            bodyColor: isLight ? '#333' : '#b0b3b8',
                            borderColor: 'rgba(212,168,67,0.3)',
                            borderWidth: 1,
                        }
                    }
                }
            });
        }
    })();
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const grid = document.getElementById('post-grid');
    if (!form || !grid) return;
    let debounceTimer;

    function fetchPosts() {
        const params = new URLSearchParams(new FormData(form)).toString();
        fetch("{{ path('post_search') }}?" + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => { grid.innerHTML = html; });
    }

    form.querySelectorAll('input.tf-search').forEach(input => {
        input.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(fetchPosts, 300);
        });
    });

    form.querySelectorAll('select.tf-search').forEach(sel => {
        sel.addEventListener('change', fetchPosts);
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        fetchPosts();
    });
});
</script>
{% endblock %}
