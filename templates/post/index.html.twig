{% block javascripts %}
<script>
(function() {
    /* ── Forum Rules Toggle ── */
    const rulesToggle = document.getElementById('rulesToggle');
    const rulesList = document.getElementById('rulesList');
    const rulesChevron = document.getElementById('rulesChevron');
    if (rulesToggle && rulesList) {
        const rulesKey = 'tf-rules-collapsed';
        if (localStorage.getItem(rulesKey) === '1') {
            rulesList.classList.add('hidden');
            rulesChevron.classList.add('collapsed');
        }
        rulesToggle.addEventListener('click', function() {
            const isHidden = rulesList.classList.toggle('hidden');
            rulesChevron.classList.toggle('collapsed', isHidden);
            localStorage.setItem(rulesKey, isHidden ? '1' : '0');
        });
    }

    /* ── Refs ── */
    const searchInput = document.getElementById('feedSearch');
    const filterChips = document.querySelectorAll('.ln-filter-chip');
    const feedContainer = document.getElementById('feedContainer');
    const noResults = document.getElementById('noResults');
    const feedLoading = document.getElementById('feedLoading');
    const resultCount = document.getElementById('resultCount');
    const searchUrl = '{{ path("post_search") }}';
    const createUrl = '{{ path("post_create_ajax") }}';
    const isAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
    const currentUserId = {{ app.user ? app.user.id : 'null' }};
    const hiddenPostMessage = 'This post was removed for violating community guidelines.';

    let debounceTimer = null;
    let currentSort = 'recent';
    let isSearchActive = false;
    let currentDetailPostId = null;
    let currentReportPostId = null;
    const speechSupported = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
    let activeTtsButton = null;
    let activeUtterance = null;
    const ttsUnsupportedMsg = 'Text-to-speech is not supported in your browser.';

    /* ── AI Summary state ── */
    const summaryCache = {};
    (function () {
        try {
            const stored = JSON.parse(localStorage.getItem('tf_ai_summaries') || '{}');
            Object.assign(summaryCache, stored);
        } catch (e) {}
    })();
    function saveSummaryCache() {
        try { localStorage.setItem('tf_ai_summaries', JSON.stringify(summaryCache)); } catch (e) {}
    }

    /* ── Media state ── */
    let newPostImageUrl = '';
    let editPostImageUrl = '';
    const IMGBB_KEY = '779afaf82155656af4e0e8e92c2970e0';

    /* ── Translation state ── */
    let currentDisplayLang = null; // null = show original
    const translationCache = {}; // key: "postId|srcLang|tgtLang|field" → translated text
    const LANG_LABELS = { fr: 'FR', en: 'EN', ar: 'AR' };

    async function translateText(text, srcLang, tgtLang) {
        if (!text || text.trim() === '' || srcLang === tgtLang) return text;
        const cacheKey = srcLang + '|' + tgtLang + '|' + text.substring(0, 80);
        if (translationCache[cacheKey]) return translationCache[cacheKey];
        try {
            const url = 'https://api.mymemory.translated.net/get?q=' +
                encodeURIComponent(text.substring(0, 500)) +
                '&langpair=' + encodeURIComponent(srcLang + '|' + tgtLang);
            const resp = await fetch(url);
            const data = await resp.json();
            if (data.responseStatus === 200 && data.responseData && data.responseData.translatedText) {
                let result = data.responseData.translatedText;
                // MyMemory returns uppercase "TRANSLATED" on failure
                if (result === result.toUpperCase() && result.length > 10) result = text;
                translationCache[cacheKey] = result;
                return result;
            }
        } catch (e) { /* fallback to original */ }
        return text;
    }

    async function translateAllCards(targetLang) {
        const cards = document.querySelectorAll('.ln-post-card[data-original-lang]');
        const promises = [];
        cards.forEach(card => {
            promises.push(translateCard(card, targetLang));
        });
        await Promise.all(promises);
    }

    async function translateCard(card, targetLang) {
        const origLang = card.dataset.originalLang;
        const origTitle = card.dataset.originalTitle || '';
        const origContent = card.dataset.originalContent || '';

        if (targetLang === null || targetLang === origLang) {
            // Restore original
            const titleEl = card.querySelector('.ln-post-title a');
            const contentEl = card.querySelector('.ln-post-content-text');
            if (titleEl) titleEl.textContent = origTitle;
            if (contentEl) contentEl.textContent = origContent;
            card.dataset.displayLang = origLang;
            return;
        }

        card.classList.add('translating');
        // Always translate from ORIGINAL language → target (never from intermediate)
        const [trTitle, trContent] = await Promise.all([
            translateText(origTitle, origLang, targetLang),
            origContent ? translateText(origContent, origLang, targetLang) : Promise.resolve(''),
        ]);

        const titleEl = card.querySelector('.ln-post-title a');
        const contentEl = card.querySelector('.ln-post-content-text');
        if (titleEl) titleEl.textContent = trTitle;
        if (contentEl) contentEl.textContent = trContent;
        card.dataset.displayLang = targetLang;
        card.classList.remove('translating');
    }

    /* ══════════════════════════════════════════════
       SEARCH TOGGLE (icon → expanded bar)
       ══════════════════════════════════════════════ */
    const searchToggleBtn = document.getElementById('searchToggle');
    const searchExpanded = document.getElementById('searchExpanded');

    if (searchToggleBtn && searchExpanded) {
        searchToggleBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            searchExpanded.classList.add('active');
            searchToggleBtn.style.display = 'none';
            setTimeout(() => searchInput.focus(), 50);
        });

        document.addEventListener('click', function(e) {
            if (!searchExpanded.classList.contains('active')) return;
            if (searchExpanded.contains(e.target)) return;
            // Collapse
            searchExpanded.classList.remove('active');
            searchToggleBtn.style.display = '';
        });

        // Prevent filter chip clicks from closing
        searchExpanded.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    }

    /* ══════════════════════════════════════════════
       SEARCH & FILTER
       ══════════════════════════════════════════════ */
    filterChips.forEach(chip => {
        chip.addEventListener('click', function() {
            filterChips.forEach(c => c.classList.remove('active'));
            this.classList.add('active');
            currentSort = this.dataset.sort;
            doSearch();
        });
    });

    searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(doSearch, 250);
    });

    function doSearch() {
        const q = searchInput.value.trim();
        if (!q && currentSort === 'recent' && !isSearchActive) return;
        isSearchActive = !!(q || currentSort !== 'recent');

        feedLoading.style.display = 'block';
        feedContainer.style.opacity = '0.4';
        noResults.style.display = 'none';

        const params = new URLSearchParams({ q, sort: currentSort });
        fetch(searchUrl + '?' + params.toString(), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(posts => {
            feedLoading.style.display = 'none';
            feedContainer.style.opacity = '1';

            if (posts.length === 0) {
                feedContainer.innerHTML = '';
                noResults.style.display = 'block';
                resultCount.textContent = '0 résultat';
                return;
            }

            noResults.style.display = 'none';
            resultCount.textContent = posts.length + ' post' + (posts.length > 1 ? 's' : '');
            feedContainer.innerHTML = posts.map(renderPost).join('');
            bindAll();
            if (currentDisplayLang) translateAllCards(currentDisplayLang);
        })
        .catch(() => {
            feedLoading.style.display = 'none';
            feedContainer.style.opacity = '1';
        });
    }

    /* ══════════════════════════════════════════════
       RENDER POST CARD
       ══════════════════════════════════════════════ */
    function esc(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function renderPost(p) {
        const lang = p.lang || 'fr';
        const hiddenForViewer = p.hidden && !p.canViewOriginal;
        if (hiddenForViewer) {
            return `
        <div class="ln-post-card is-hidden" data-post-id="${p.id}" data-original-lang="fr" data-display-lang="fr" data-original-title="Post retiré" data-original-content="${esc(p.hiddenMessage || hiddenPostMessage)}">
            <div class="ln-post-header">
                <span class="ln-avatar">${esc(p.authorInitial)}</span>
                <div class="ln-post-author-info">
                    <span class="ln-post-author-name">${esc(p.authorName)}</span>
                    <div class="ln-post-author-role">${esc(p.authorRole)}</div>
                    <div class="ln-post-time">${esc(p.timeLabel)}</div>
                </div>
            </div>
            <div class="ln-post-title"><a href="#">Post retiré</a></div>
            <div class="ln-post-content"><div class="ln-removed-card">${esc(p.hiddenMessage || hiddenPostMessage)}</div></div>
        </div>`;
        }
        const contentShort = p.content && p.content.length > 200;
        const contentHtml = p.content ? `<div class="ln-post-content-text">${esc(p.content)}</div>
                ${contentShort ? `<a href="#" class="ln-see-more open-detail-modal" data-id="${p.id}">...voir plus</a>` : ''}` : '';
        let mediaHtml = '';
        if (p.imagePath) {
            mediaHtml = '<div class="ln-post-media">';
            mediaHtml += `<img src="${esc(p.imagePath)}" alt="Post image" loading="lazy">`;
            mediaHtml += '</div>';
        }
        let audioHtml = '';
        if (p.audioPath) {
            audioHtml = `<div class="ln-post-audio">
                <i class="fas fa-microphone"></i>
                <audio controls preload="metadata" src="${esc(p.audioPath)}"></audio>
                <span class="audio-label">Mémo vocal</span>
            </div>`;
        }
        return `
        <div class="ln-post-card" data-post-id="${p.id}" data-original-lang="${lang}" data-display-lang="${lang}" data-original-title="${esc(p.title)}" data-original-content="${esc(p.content || '')}">
            <div class="ln-post-header">
                <span class="ln-avatar">${esc(p.authorInitial)}</span>
                <div class="ln-post-author-info">
                    <span class="ln-post-author-name">${esc(p.authorName)}</span>
                    <div class="ln-post-author-role">${esc(p.authorRole)}</div>
                    <div class="ln-post-time">
                        ${esc(p.timeLabel)} &bull; <i class="fas fa-globe-americas"></i>
                        <span class="ln-lang-badge" title="Langue originale"><i class="fas fa-language"></i> ${lang.toUpperCase()}</span>
                    </div>
                </div>
                <div class="ln-post-menu">
                    ${p.canReport ? `<button class="ln-report-btn open-report-modal" data-id="${p.id}" title="Signaler ce post"><i class="fas fa-flag"></i></button>` : ''}
                    ${p.canManage ? `
                    <div class="ln-dropdown">
                        <button class="ln-post-menu-btn" title="Plus d'options">
                            <i class="fas fa-ellipsis-h"></i>
                        </button>
                        <div class="ln-dropdown-menu">
                            <button class="ln-dropdown-item open-edit-modal" data-id="${p.id}">
                                <i class="fas fa-pen"></i> Modifier
                            </button>
                            <div class="ln-dropdown-sep"></div>
                            <form method="post" action="${esc(p.deleteUrl)}" onsubmit="return confirm('Supprimer ce post ?')">
                                <input type="hidden" name="_token" value="${esc(p.deleteToken)}">
                                <button type="submit" class="ln-dropdown-item danger">
                                    <i class="fas fa-trash-alt"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                    ` : ''}
                </div>
            </div>
            <div class="ln-post-title">
                <a href="#" class="open-detail-modal" data-id="${p.id}">${esc(p.title)}</a>
            </div>
            <div class="ln-post-content">${contentHtml}</div>
            ${mediaHtml}
            ${audioHtml}
            ${(p.upvotes !== 0 || p.commentCount > 0) ? `
            <div class="ln-post-stats">
                <div class="ln-post-stats-left">
                    ${p.upvotes !== 0 ? `
                        <span class="ln-reaction-icons">
                            <span class="ln-reaction-icon ${p.upvotes > 0 ? 'up' : 'down'}"><i class="fas fa-arrow-${p.upvotes > 0 ? 'up' : 'down'}"></i></span>
                        </span>
                        <span>${p.upvotes}</span>
                    ` : ''}
                </div>
                <div class="ln-post-stats-right">
                    ${p.commentCount > 0 ? `<button class="open-detail-modal" data-id="${p.id}">${p.commentCount} commentaire${p.commentCount > 1 ? 's' : ''}</button>` : ''}
                </div>
            </div>` : ''}
            <div class="ln-post-actions">
                <div class="ln-vote-group">
                    <button class="ln-vote-btn upvote${p.userVote === 'up' ? ' voted' : ''}" data-id="${p.id}" title="Upvote">
                        <i class="fas fa-arrow-up"></i>
                    </button>
                    <span class="ln-vote-count" data-vote-count="${p.id}">${p.upvotes}</span>
                    <button class="ln-vote-btn downvote${p.userVote === 'down' ? ' voted' : ''}" data-id="${p.id}" title="Downvote">
                        <i class="fas fa-arrow-down"></i>
                    </button>
                </div>
                <button class="ln-action-btn open-detail-modal" data-id="${p.id}" title="Commenter">
                    <i class="far fa-comment-dots"></i> <span>Commenter</span>
                </button>
                <button class="ln-action-btn ln-tts-btn" data-id="${p.id}" title="Lire ce post à voix haute">
                    <i class="fas fa-volume-up"></i> <span>Écouter</span>
                </button>
                ${(p.content || '').trim().split(/\s+/).filter(Boolean).length > 100 ? `
                <button class="ln-action-btn ln-summarize-btn" data-id="${p.id}" title="Résumer avec IA">
                    <i class="fas fa-wand-magic-sparkles"></i> <span>Résumer</span>
                </button>` : ''}
                ${p.authorId && p.authorId != currentUserId ? `<a href="/message/start/${p.authorId}" class="ln-action-btn" title="Envoyer un message"><i class="far fa-paper-plane"></i> <span>Message</span></a>` : ''}
            </div>
            ${(p.content || '').trim().split(/\s+/).filter(Boolean).length > 100 ? `<div class="ln-ai-summary" data-summary-id="${p.id}"></div>` : ''}
        </div>`;
    }

    /* ══════════════════════════════════════════════
       VOTE HANDLING
       ══════════════════════════════════════════════ */
    function handleVote(e) {
        const btn = e.currentTarget;
        const id = btn.dataset.id;
        const isUp = btn.classList.contains('upvote');
        const url = '/post/' + id + (isUp ? '/upvote' : '/downvote');

        btn.style.pointerEvents = 'none';
        fetch(url, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            // Update vote count
            document.querySelectorAll(`[data-vote-count="${id}"]`).forEach(el => {
                el.textContent = data.upvotes;
            });
            // Update active state on all matching vote buttons
            document.querySelectorAll(`.ln-vote-btn.upvote[data-id="${id}"]`).forEach(el => {
                el.classList.toggle('voted', data.userVote === 'up');
            });
            document.querySelectorAll(`.ln-vote-btn.downvote[data-id="${id}"]`).forEach(el => {
                el.classList.toggle('voted', data.userVote === 'down');
            });
            btn.style.pointerEvents = '';
        })
        .catch(() => { btn.style.pointerEvents = ''; });
    }

    function setTtsButtonState(btn, speaking) {
        if (!btn) return;

        const icon = btn.querySelector('i');
        const label = btn.querySelector('span');
        if (!speechSupported) {
            btn.disabled = true;
            btn.title = ttsUnsupportedMsg;
            if (icon) icon.className = 'fas fa-volume-up';
            if (label) label.textContent = 'Écouter';
            btn.classList.remove('speaking');
            return;
        }

        btn.disabled = false;
        btn.title = speaking ? 'Arrêter la lecture' : 'Lire ce post à voix haute';
        btn.classList.toggle('speaking', speaking);
        if (icon) icon.className = speaking ? 'fas fa-stop' : 'fas fa-volume-up';
        if (label) label.textContent = speaking ? '⏹ Stop' : 'Écouter';
    }

    function resetActiveTts() {
        if (activeTtsButton) {
            setTtsButtonState(activeTtsButton, false);
        }
        activeTtsButton = null;
        activeUtterance = null;
    }

    function stopSpeech() {
        if (!speechSupported) return;
        window.speechSynthesis.cancel();
        resetActiveTts();
    }

    function handleTtsClick(e) {
        e.preventDefault();
        const btn = e.currentTarget;
        if (!speechSupported) {
            setTtsButtonState(btn, false);
            return;
        }

        if (activeTtsButton === btn && window.speechSynthesis.speaking) {
            stopSpeech();
            return;
        }

        stopSpeech();

        const card = btn.closest('.ln-post-card');
        if (!card) return;
        const title = (card.querySelector('.ln-post-title a')?.textContent || '').trim();
        const content = (card.querySelector('.ln-post-content-text')?.textContent || '').trim();
        const fallback = (card.querySelector('.ln-removed-card')?.textContent || '').trim();
        const textToRead = [title, content || fallback].filter(Boolean).join('. ');

        if (!textToRead) return;

        const utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.rate = 1;
        utterance.pitch = 1;
        utterance.lang = document.documentElement.lang || 'fr-FR';

        utterance.onend = resetActiveTts;
        utterance.onerror = resetActiveTts;

        activeTtsButton = btn;
        activeUtterance = utterance;
        setTtsButtonState(btn, true);

        window.speechSynthesis.speak(utterance);
    }

    /* ══════════════════════════════════════════════
       AI POST SUMMARIZER
       ══════════════════════════════════════════════ */
    function showSummaryCard(id, state, text) {
        const card = document.querySelector(`.ln-ai-summary[data-summary-id="${id}"]`);
        if (!card) return;
        if (state === 'loading') {
            card.innerHTML = '<div class="ln-ai-summary-label"><i class="fas fa-wand-magic-sparkles"></i> AI Summary</div><div class="ln-ai-summary-text"></div>';
            card.className = 'ln-ai-summary visible loading';
        } else if (state === 'result') {
            card.innerHTML = '<div class="ln-ai-summary-label"><i class="fas fa-wand-magic-sparkles"></i> AI Summary</div><div class="ln-ai-summary-text">' + esc(text) + '</div>';
            card.className = 'ln-ai-summary visible';
        } else if (state === 'error') {
            card.innerHTML = '<div class="ln-ai-summary-label"><i class="fas fa-wand-magic-sparkles"></i> AI Summary</div><div class="ln-ai-summary-text">' + esc(text) + '</div>';
            card.className = 'ln-ai-summary visible error';
        } else {
            card.className = 'ln-ai-summary';
        }
    }

    function handleSummarizeClick(e) {
        e.preventDefault();
        const btn = e.currentTarget;
        const id = btn.dataset.id;
        if (!id) return;

        const summaryCard = document.querySelector(`.ln-ai-summary[data-summary-id="${id}"]`);
        // Toggle off if already showing a result
        if (summaryCard && summaryCard.classList.contains('visible') && !summaryCard.classList.contains('loading')) {
            showSummaryCard(id, 'hidden');
            btn.classList.remove('active');
            return;
        }

        // Return cached summary
        if (summaryCache[id]) {
            showSummaryCard(id, 'result', summaryCache[id]);
            btn.classList.add('active');
            return;
        }

        // Fetch from API
        btn.classList.add('active');
        showSummaryCard(id, 'loading');

        fetch('/post/' + id + '/summarize', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.summary) {
                summaryCache[id] = data.summary;
                saveSummaryCache();
                showSummaryCard(id, 'result', data.summary);
            } else {
                showSummaryCard(id, 'error', data.error || 'Summary unavailable right now.');
                btn.classList.remove('active');
            }
        })
        .catch(function () {
            showSummaryCard(id, 'error', 'Summary unavailable right now.');
            btn.classList.remove('active');
