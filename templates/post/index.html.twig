{% extends 'base_dashboard.html.twig' %}

{% block title %}Forum - TalentFlow{% endblock %}
{% block page_title %}{% endblock %}

{% block stylesheets %}
<style>
    /* ── LinkedIn-style Feed Layout (3 columns) ── */
    .ln-feed-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }
    .ln-feed-left {
        width: 280px;
        flex-shrink: 0;
        position: sticky;
        top: 76px;
    }
    .ln-feed-main {
        flex: 1;
        min-width: 0;
        max-width: 620px;
    }
    .ln-feed-sidebar {
        width: 280px;
        flex-shrink: 0;
        position: sticky;
        top: 76px;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }
    @media (max-width: 1100px) {
        .ln-feed-left { display: none; }
    }
    @media (max-width: 960px) {
        .ln-feed-sidebar { display: none; }
        .ln-feed-main { max-width: 100%; }
    }

    /* ── Forum Rules Card (left sidebar) ── */
    .ln-rules-card {
        background: var(--tf-card-bg);
        border: 1px solid var(--tf-border);
        border-radius: 12px;
        padding: 0.75rem 0.8rem;
    }
    .ln-rules-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        cursor: pointer;
        user-select: none;
    }
    .ln-rules-header i.fa-shield-alt {
        color: var(--tf-gold);
        font-size: 1rem;
    }
    .ln-rules-header h3 {
        font-size: 0.86rem;
        font-weight: 700;
        color: var(--tf-white);
        margin: 0;
        flex: 1;
    }
    .ln-rules-header .ln-rules-toggle {
        color: var(--tf-gray);
        font-size: 0.65rem;
        transition: transform 0.25s;
    }
    .ln-rules-header .ln-rules-toggle.collapsed {
        transform: rotate(-90deg);
    }
    .ln-rules-list {
        list-style: none;
        padding: 0;
        margin: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }
    .ln-rules-list.hidden {
        max-height: 0 !important;
    }
    .ln-rules-list li {
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
        padding: 0.22rem 0;
        font-size: 0.72rem;
        color: var(--tf-text-muted);
        line-height: 1.35;
    }
    .ln-rules-list li i {
        color: var(--tf-gold);
        font-size: 0.55rem;
        margin-top: 0.2rem;
        flex-shrink: 0;
    }
    .ln-rules-list li strong {
        color: var(--tf-text);
        font-weight: 600;
    }
    .ln-rules-footer {
        margin-top: 0.55rem;
        padding-top: 0.5rem;
        border-top: 1px solid var(--tf-border);
        font-size: 0.65rem;
        color: var(--tf-gray);
        text-align: center;
        font-style: italic;
    }

    /* ── Start a Post Card ── */
    .ln-start-post {
        background: var(--tf-card-bg);
        border: 1px solid var(--tf-border);
        border-radius: 12px;
        padding: 1rem 1.2rem;
        margin-bottom: 1rem;
    }
    .ln-start-post-top {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }
    .ln-start-post-top .ln-avatar {
        width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
        color: var(--tf-midnight); display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem;
    }
    .ln-start-post-btn {
        flex: 1; padding: 0.7rem 1.2rem; border-radius: 35px;
        border: 1px solid var(--tf-border); background: transparent;
        color: var(--tf-gray); font-size: 0.9rem; text-align: left;
        cursor: pointer; transition: background 0.2s, border-color 0.2s;
        text-decoration: none; display: block;
    }
    .ln-start-post-btn:hover {
        background: rgba(212, 168, 67, 0.06); border-color: var(--tf-gold);
        color: var(--tf-white);
    }

    /* ── Inline Feed Search Bar ── */
    .ln-feed-search-bar {
        background: var(--tf-card-bg); border: 1px solid var(--tf-border);
        border-radius: 12px; padding: 0.5rem 0.8rem; margin-bottom: 0.8rem;
        display: flex; align-items: center; gap: 0.55rem;
    }
    .ln-feed-search-inner {
        display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0;
        flex: 1; min-width: 180px;
    }
    .ln-feed-search-input {
        flex: 1; padding: 0.35rem 0.5rem; border: none;
        background: transparent; color: var(--tf-white); font-size: 0.88rem;
        outline: none;
    }
    .ln-feed-search-input::placeholder { color: var(--tf-gray); }
    .ln-feed-filter-chips {
        display: flex; gap: 0.35rem; flex-wrap: nowrap; overflow-x: auto;
        scrollbar-width: thin;
    }
    [data-theme="light"] .ln-feed-search-bar { background: #ffffff; border-color: #e2e6ef; }
    [data-theme="light"] .ln-feed-search-input { color: #1a1a2e; }
    [data-theme="light"] .ln-feed-search-input::placeholder { color: #65676b; }
    .ln-feed-filter-chips .ln-filter-chip { /* inherits .ln-filter-chip styles */ }
    /* Keep topbar search for backward-compat */
    .topbar-filter-chips {
        display: flex; gap: 0.3rem; align-items: center; flex-shrink: 0;
    }
    .ln-filter-chip {
        padding: 0.28rem 0.65rem; border-radius: 20px; font-size: 0.72rem;
        font-weight: 600; border: 1px solid var(--tf-border); background: transparent;
        color: var(--tf-gray); cursor: pointer; transition: all 0.2s;
        white-space: nowrap;
    }
    .ln-filter-chip:hover { border-color: var(--tf-gold); color: var(--tf-white); }
    .ln-filter-chip.active {
        background: var(--tf-gold); color: var(--tf-midnight);
        border-color: var(--tf-gold);
    }
    [data-theme="light"] .ln-filter-chip { border-color: #dddfe2; color: #65676b; }
    [data-theme="light"] .ln-filter-chip:hover { border-color: var(--tf-gold); color: #1c1e21; }
    [data-theme="light"] .ln-filter-chip.active { background: var(--tf-gold); color: #1a1a2e; border-color: var(--tf-gold); }
    .ln-result-count {
        font-size: 0.72rem; color: var(--tf-gray); white-space: nowrap; flex-shrink: 0;
    }

    @media (max-width: 880px) {
        .ln-feed-search-bar { flex-wrap: wrap; }
        .ln-feed-filter-chips { width: 100%; }
    }

    /* ── Sort bar ── */
    .ln-sort-bar {
        display: flex; align-items: center; gap: 0.5rem;
        margin-bottom: 0.8rem; padding: 0 0.2rem;
    }
    .ln-sort-bar hr { flex: 1; border: none; border-top: 1px solid var(--tf-border); }

    /* ── Post Card ── */
    .ln-post-card {
        background: var(--tf-card-bg);
        border: 1px solid var(--tf-border);
        border-radius: 12px;
        margin-bottom: 0.8rem;
        overflow: hidden;
        transition: box-shadow 0.2s;
    }
    .ln-post-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.25); }

    .ln-post-header {
        display: flex; align-items: flex-start; gap: 0.8rem;
        padding: 1rem 1.2rem 0;
    }
    .ln-post-header .ln-avatar {
        width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
        color: var(--tf-midnight); display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem;
    }
    .ln-post-author-info { flex: 1; min-width: 0; }
    .ln-post-author-name {
        font-weight: 700; font-size: 0.92rem; color: var(--tf-white);
        text-decoration: none; display: block;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ln-post-author-name:hover { color: var(--tf-gold); text-decoration: underline; }
    .ln-post-author-role {
        font-size: 0.78rem; color: var(--tf-gray); margin-top: 0.1rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ln-post-time {
        font-size: 0.72rem; color: var(--tf-gray); display: flex;
        align-items: center; gap: 0.3rem; margin-top: 0.15rem;
    }
    .ln-post-time i { font-size: 0.6rem; }
    .ln-post-menu { flex-shrink: 0; display: flex; gap: 0.3rem; }
    .ln-report-btn {
        width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(212, 168, 67, 0.22);
        background: rgba(212, 168, 67, 0.08); color: var(--tf-gold);
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    }
    .ln-report-btn:hover { background: rgba(212, 168, 67, 0.16); border-color: rgba(212, 168, 67, 0.36); transform: translateY(-1px); }
    .ln-post-menu-btn {
        background: none; border: none; color: var(--tf-gray);
        padding: 0.3rem 0.5rem; border-radius: 50%; cursor: pointer;
        transition: background 0.2s, color 0.2s; font-size: 0.95rem;
    }
    .ln-post-menu-btn:hover { background: rgba(255,255,255,0.08); color: var(--tf-white); }

    /* Post body */
    .ln-post-title {
        padding: 0.6rem 1.2rem 0;
        font-size: 1rem; font-weight: 700; color: var(--tf-gold);
    }
    .ln-post-title a { color: var(--tf-gold); text-decoration: none; }
    .ln-post-title a:hover { text-decoration: underline; }
    .ln-post-content {
        padding: 0.4rem 1.2rem 0.8rem;
        font-size: 0.88rem; color: var(--tf-light, #ccc); line-height: 1.6;
    }
    .ln-post-content-text {
        overflow: hidden; display: -webkit-box;
        -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    }
    .ln-see-more {
        color: var(--tf-gray); font-weight: 600; font-size: 0.82rem;
        cursor: pointer; text-decoration: none; margin-left: 0.2rem;
    }
    .ln-see-more:hover { color: var(--tf-gold); text-decoration: underline; }
    .ln-removed-card {
        margin: 0.4rem 1.2rem 1rem;
        padding: 1rem 1.05rem;
        border: 1px solid rgba(148, 163, 184, 0.26);
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(148, 163, 184, 0.14), rgba(148, 163, 184, 0.08));
        color: #d4d7dd;
        line-height: 1.6;
        font-size: 0.88rem;
    }
    .ln-post-card.is-hidden .ln-post-title {
        color: #e6e8eb;
        padding-bottom: 0.2rem;
    }
    .ln-post-card.is-hidden .ln-post-title a {
        color: #e6e8eb;
        pointer-events: none;
        text-decoration: none;
    }

    /* Stats row */
    .ln-post-stats {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.4rem 1.2rem; font-size: 0.78rem; color: var(--tf-gray);
    }
    .ln-post-stats-left { display: flex; align-items: center; gap: 0.4rem; }
    .ln-post-stats-left .ln-reaction-icons { display: flex; }
    .ln-post-stats-left .ln-reaction-icon {
        width: 18px; height: 18px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.6rem; border: 1.5px solid var(--tf-card-bg);
        margin-right: -4px;
    }
    .ln-reaction-icon.up { background: #0a66c2; color: white; }
    .ln-reaction-icon.down { background: #e74c3c; color: white; }
    .ln-post-stats-right a, .ln-post-stats-right button {
        color: var(--tf-gray); text-decoration: none; background: none;
        border: none; cursor: pointer; font-size: 0.78rem; padding: 0;
    }
    .ln-post-stats-right a:hover, .ln-post-stats-right button:hover {
        color: var(--tf-gold); text-decoration: underline;
    }

    /* Action buttons row */
    .ln-post-actions {
        display: flex; border-top: 1px solid var(--tf-border);
        padding: 0.2rem 0.5rem;
    }
    .ln-action-btn {
        flex: 1; display: flex; align-items: center; justify-content: center;
        gap: 0.5rem; padding: 0.7rem 0; border: none; background: none;
        color: var(--tf-gray); font-size: 0.82rem; font-weight: 600;
        cursor: pointer; border-radius: 8px; transition: background 0.2s, color 0.2s;
        text-decoration: none;
    }
    .ln-action-btn:hover { background: rgba(255,255,255,0.06); color: var(--tf-white); }
    .ln-action-btn i { font-size: 1.05rem; }
    .ln-tts-btn.speaking {
        color: var(--tf-gold);
        background: rgba(212, 168, 67, 0.14);
        animation: ttsPulse 1s ease-in-out infinite;
    }
    .ln-tts-btn[disabled] {
        cursor: not-allowed;
        opacity: 0.58;
    }
    @keyframes ttsPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(212, 168, 67, 0.36); }
        50% { box-shadow: 0 0 0 7px rgba(212, 168, 67, 0); }
    }

    /* ── AI Summarize Button ── */
    .ln-summarize-btn { color: var(--tf-gold); }
    .ln-summarize-btn:hover { background: rgba(212, 168, 67, 0.1); color: var(--tf-gold); }
    .ln-summarize-btn.active { color: var(--tf-gold); background: rgba(212, 168, 67, 0.12); }

    /* ── AI Summary Card ── */
    .ln-ai-summary {
        display: none;
        margin: 0 1.2rem 0.8rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        border-left: 3px solid var(--tf-gold);
    }
    .ln-ai-summary.visible { display: block; }
    .ln-ai-summary-label {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.07em; color: var(--tf-gold);
        margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.3rem;
    }
    .ln-ai-summary-text {
        font-size: 0.83rem; font-style: italic;
        color: var(--tf-gray); line-height: 1.5;
    }
    .ln-ai-summary.loading .ln-ai-summary-text { display: none; }
    .ln-ai-summary.loading::after {
        content: '';
        display: block; height: 13px; border-radius: 6px;
        background: linear-gradient(90deg,
            rgba(255,255,255,0.06) 25%,
            rgba(255,255,255,0.13) 50%,
            rgba(255,255,255,0.06) 75%);
        background-size: 200% 100%;
        animation: skeletonLoad 1.4s infinite;
        width: 88%;
    }
    @keyframes skeletonLoad {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    .ln-ai-summary.error .ln-ai-summary-text { color: #e88; font-style: normal; }
    [data-theme="light"] .ln-summarize-btn { color: var(--tf-gold-dark); }
    [data-theme="light"] .ln-summarize-btn:hover { background: rgba(201,162,39,0.1); }
    [data-theme="light"] .ln-ai-summary { background: rgba(0,0,0,0.03); }
    [data-theme="light"] .ln-ai-summary-text { color: #555; }
    [data-theme="light"] .ln-ai-summary.loading::after {
        background: linear-gradient(90deg,
            rgba(0,0,0,0.05) 25%, rgba(0,0,0,0.12) 50%, rgba(0,0,0,0.05) 75%);
        background-size: 200% 100%;
    }

    /* Vote buttons */
    .ln-vote-group {
        display: flex; align-items: center; gap: 0;
        border-right: 1px solid var(--tf-border);
        margin-right: 0.2rem;
    }
    .ln-vote-btn {
        display: flex; align-items: center; justify-content: center;
        gap: 0.35rem; padding: 0.7rem 0.8rem; border: none; background: none;
        color: var(--tf-gray); font-size: 0.82rem; font-weight: 600;
        cursor: pointer; border-radius: 8px; transition: background 0.15s, color 0.15s;
    }
    .ln-vote-btn:hover { background: rgba(255,255,255,0.06); }
    .ln-vote-btn.upvote:hover { color: #0a66c2; }
    .ln-vote-btn.downvote:hover { color: #e74c3c; }
    .ln-vote-btn.upvote.voted { color: #0a66c2; }
    .ln-vote-btn.downvote.voted { color: #e74c3c; }
    .ln-vote-btn i { font-size: 1.1rem; }
    .ln-vote-count {
        font-size: 0.82rem; font-weight: 700; color: var(--tf-white);
        min-width: 20px; text-align: center; padding: 0 0.1rem;
    }

    /* Admin dropdown */
    .ln-dropdown { position: relative; display: inline-block; }
    .ln-dropdown-menu {
        display: none; position: absolute; right: 0; top: 110%;
        background: var(--tf-navy); border: 1px solid var(--tf-border);
        border-radius: 10px; min-width: 180px; z-index: 50;
        box-shadow: 0 8px 30px rgba(0,0,0,0.4); overflow: hidden;
    }
    .ln-dropdown:hover .ln-dropdown-menu,
    .ln-dropdown:focus-within .ln-dropdown-menu { display: block; }
    .ln-dropdown-item {
        display: flex; align-items: center; gap: 0.6rem;
        padding: 0.65rem 1rem; color: var(--tf-white); text-decoration: none;
        font-size: 0.82rem; transition: background 0.15s; border: none;
        background: none; width: 100%; cursor: pointer;
    }
    .ln-dropdown-item:hover { background: rgba(212, 168, 67, 0.1); color: var(--tf-gold); }
    .ln-dropdown-item.danger { color: #e74c3c; }
    .ln-dropdown-item.danger:hover { background: rgba(231, 76, 60, 0.12); }
    .ln-dropdown-sep { border-top: 1px solid var(--tf-border); margin: 0; }

    /* Empty state */
    .ln-empty {
        text-align: center; padding: 4rem 2rem; color: var(--tf-gray);
    }
    .ln-empty i { font-size: 3.5rem; color: var(--tf-border); margin-bottom: 1rem; display: block; }
    .ln-empty p { font-size: 1rem; margin-bottom: 1rem; }

    /* No results */
    .ln-no-results {
        text-align: center; padding: 2.5rem 1.5rem; color: var(--tf-gray);
        display: none;
    }
    .ln-no-results i { font-size: 2.5rem; color: var(--tf-border); margin-bottom: 0.8rem; display: block; }

    /* Loading spinner */
    .ln-loading {
        text-align: center; padding: 2rem; display: none;
    }
    .ln-loading .spinner {
        display: inline-block; width: 28px; height: 28px;
        border: 3px solid var(--tf-border); border-top-color: var(--tf-gold);
        border-radius: 50%; animation: spin 0.7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ══════════════════════════════════════════
       MODAL OVERLAY & SHARED
       ══════════════════════════════════════════ */
    .modal-overlay {
        display: none; position: fixed; inset: 0; z-index: 9000;
        background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px);
        align-items: center; justify-content: center;
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
        background: var(--tf-card-bg); border: 1px solid var(--tf-border);
        border-radius: 14px; box-shadow: 0 20px 60px rgba(0,0,0,0.6);
        max-height: 90vh; overflow: hidden; position: relative;
        animation: modalIn 0.2s ease-out;
    }
    @keyframes modalIn {
        from { opacity: 0; transform: translateY(20px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .modal-close {
        position: absolute; top: 0.8rem; right: 0.8rem; z-index: 10;
        background: none; border: none; color: var(--tf-gray);
        font-size: 1.3rem; cursor: pointer; padding: 0.3rem;
        border-radius: 50%; transition: background 0.2s, color 0.2s;
        line-height: 1; width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center;
    }
    .modal-close:hover { background: rgba(255,255,255,0.1); color: var(--tf-white); }

    /* ── New Post Modal ── */
    .modal-new-post { width: 540px; max-width: 95vw; }
    .modal-new-post-header {
        padding: 1.2rem 1.5rem 0.8rem;
        border-bottom: 1px solid var(--tf-border);
        display: flex; align-items: center; gap: 0.8rem;
    }
    .modal-new-post-header .ln-avatar {
        width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
        color: var(--tf-midnight); display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.95rem;
    }
    .modal-new-post-header h3 {
        margin: 0; font-size: 1.05rem; color: var(--tf-white); font-weight: 700;
    }
    .modal-new-post-body {
        padding: 1.2rem 1.5rem; max-height: 60vh; overflow-y: auto;
    }
    .modal-field { margin-bottom: 1rem; }
    .modal-field label {
        display: block; font-size: 0.82rem; font-weight: 600;
        color: var(--tf-gray); margin-bottom: 0.35rem;
    }
    .modal-field input,
    .modal-field textarea,
    .modal-field select {
        width: 100%; padding: 0.65rem 0.9rem; border-radius: 10px;
        border: 1px solid var(--tf-border); background: var(--tf-navy);
        color: var(--tf-white); font-size: 0.88rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        font-family: inherit;
    }
    .modal-field input:focus,
    .modal-field textarea:focus,
    .modal-field select:focus {
        outline: none; border-color: var(--tf-gold);
        box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15);
    }
    .modal-field textarea { min-height: 120px; resize: vertical; }
    .modal-field select option { background: var(--tf-navy); color: var(--tf-white); }
    .modal-new-post-footer {
        padding: 0.8rem 1.5rem 1.2rem;
        border-top: 1px solid var(--tf-border);
        display: flex; justify-content: flex-end; gap: 0.6rem;
    }
    .modal-btn {
        padding: 0.55rem 1.4rem; border-radius: 25px; font-size: 0.85rem;
        font-weight: 600; border: none; cursor: pointer; transition: all 0.2s;
    }
    .modal-btn-cancel {
        background: transparent; color: var(--tf-gray);
        border: 1px solid var(--tf-border);
    }
    .modal-btn-cancel:hover { border-color: var(--tf-white); color: var(--tf-white); }
    .modal-btn-submit {
        background: var(--tf-gold); color: var(--tf-midnight);
    }
    .modal-btn-submit:hover { background: var(--tf-gold-dark); }
    .modal-btn-submit:disabled {
        opacity: 0.5; cursor: not-allowed;
    }
    .modal-errors {
        list-style: none; padding: 0; margin: 0 0 0.8rem;
    }
    .modal-errors li {
        background: rgba(231,76,60,0.12); color: #e74c3c;
        padding: 0.45rem 0.8rem; border-radius: 8px; font-size: 0.82rem;
        margin-bottom: 0.3rem;
    }

    /* ── Detail / Comment Modal (split view) ── */
    .modal-detail { width: 900px; max-width: 95vw; display: flex; flex-direction: column; }
    .modal-detail-body {
        display: flex; flex: 1; min-height: 0; max-height: 80vh;
    }
    /* Left: post details */
    .modal-detail-left {
        flex: 1; padding: 1.5rem; overflow-y: auto;
        border-right: 1px solid var(--tf-border);
    }
    .mdl-author-row {
        display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem;
    }
    .mdl-author-row .ln-avatar {
        width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
        color: var(--tf-midnight); display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem;
    }
    .mdl-author-name { font-weight: 700; color: var(--tf-white); font-size: 0.95rem; }
    .mdl-author-role { font-size: 0.78rem; color: var(--tf-gray); }
    .mdl-author-time { font-size: 0.72rem; color: var(--tf-gray); margin-top: 0.1rem; }
    .mdl-post-title {
        font-size: 1.15rem; font-weight: 700; color: var(--tf-gold);
        margin-bottom: 0.8rem; line-height: 1.4;
    }
    .mdl-post-content {
        font-size: 0.9rem; color: var(--tf-light, #ccc); line-height: 1.7;
        .mdl-removed-card {
            border: 1px solid rgba(148, 163, 184, 0.26);
            border-radius: 14px;
            padding: 1rem 1.1rem;
            background: linear-gradient(180deg, rgba(148, 163, 184, 0.14), rgba(148, 163, 184, 0.08));
            color: #d4d7dd;
            line-height: 1.6;
            margin-bottom: 1rem;
        }
        white-space: pre-wrap; margin-bottom: 1.2rem;
    }
    .mdl-post-meta {
        display: flex; gap: 1.2rem; font-size: 0.8rem; color: var(--tf-gray);
        padding-top: 0.8rem; border-top: 1px solid var(--tf-border);
    }
    .mdl-post-meta span { display: flex; align-items: center; gap: 0.4rem; }
    .mdl-post-meta i { font-size: 0.85rem; }

    /* Right: comments panel */
    .modal-detail-right {
        flex: 1; display: flex; flex-direction: column;
        min-width: 0;
    }
    .mdl-comments-header {
        padding: 1rem 1.2rem; border-bottom: 1px solid var(--tf-border);
        font-weight: 700; font-size: 0.95rem; color: var(--tf-white);
        flex-shrink: 0;
    }
    .mdl-comments-list {
        flex: 1; overflow-y: auto; padding: 0.8rem 1.2rem;
    }
    .mdl-comment {
        display: flex; gap: 0.6rem; margin-bottom: 0.9rem;
    }
    .mdl-comment .ln-avatar {
        width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
        color: var(--tf-midnight); display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.75rem;
    }
    .mdl-comment-bubble {
        background: var(--tf-navy); border-radius: 10px; padding: 0.6rem 0.9rem;
        flex: 1; min-width: 0;
    }
    .mdl-comment-author {
        font-weight: 700; font-size: 0.82rem; color: var(--tf-white);
        margin-bottom: 0.15rem;
    }
    .mdl-comment-text {
        font-size: 0.85rem; color: var(--tf-light, #ccc); line-height: 1.5;
    }
    .mdl-comment-time {
        font-size: 0.7rem; color: var(--tf-gray); margin-top: 0.25rem;
    }

    /* Comment 3-dot dropdown */
    .mdl-comment-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 0.15rem;
    }
    .mdl-comment-menu { position: relative; display: inline-block; flex-shrink: 0; }
    .mdl-comment-menu-btn {
        background: none; border: none; color: var(--tf-gray);
        padding: 0.15rem 0.35rem; border-radius: 50%; cursor: pointer;
        transition: background 0.2s, color 0.2s; font-size: 0.78rem; line-height: 1;
    }
    .mdl-comment-menu-btn:hover { background: rgba(255,255,255,0.1); color: var(--tf-white); }
    .mdl-comment-dropdown {
        display: none; position: absolute; right: 0; top: 110%;
        background: var(--tf-navy); border: 1px solid var(--tf-border);
        border-radius: 8px; min-width: 140px; z-index: 60;
        box-shadow: 0 6px 20px rgba(0,0,0,0.4); overflow: hidden;
    }
    .mdl-comment-menu:hover .mdl-comment-dropdown,
    .mdl-comment-menu:focus-within .mdl-comment-dropdown { display: block; }
    .mdl-comment-dropdown-item {
        display: flex; align-items: center; gap: 0.5rem;
        padding: 0.5rem 0.8rem; color: var(--tf-white); text-decoration: none;
        font-size: 0.78rem; transition: background 0.15s; border: none;
        background: none; width: 100%; cursor: pointer;
    }
    .mdl-comment-dropdown-item:hover { background: rgba(212,168,67,0.1); color: var(--tf-gold); }
    .mdl-comment-dropdown-item.danger { color: #e74c3c; }
    .mdl-comment-dropdown-item.danger:hover { background: rgba(231,76,60,0.12); }

    /* Inline edit mode */
    .mdl-comment-edit-area {
        width: 100%; padding: 0.45rem 0.7rem; border-radius: 8px;
        border: 1px solid var(--tf-gold); background: var(--tf-midnight);
        color: var(--tf-white); font-size: 0.85rem; resize: none;
        font-family: inherit; min-height: 40px; margin-top: 0.3rem;
    }
    .mdl-comment-edit-actions {
        display: flex; gap: 0.4rem; margin-top: 0.35rem; justify-content: flex-end;
    }
    .mdl-comment-edit-actions button {
        padding: 0.3rem 0.8rem; border-radius: 15px; font-size: 0.75rem;
        font-weight: 600; border: none; cursor: pointer; transition: all 0.2s;
    }
    .mdl-edit-save { background: var(--tf-gold); color: var(--tf-midnight); }
    .mdl-edit-save:hover { background: var(--tf-gold-dark); }
    .mdl-edit-cancel { background: transparent; color: var(--tf-gray); border: 1px solid var(--tf-border) !important; }
    .mdl-edit-cancel:hover { border-color: var(--tf-white) !important; color: var(--tf-white); }

    .mdl-no-comments {
        text-align: center; padding: 2rem 1rem; color: var(--tf-gray);
        font-size: 0.88rem;
    }
    .mdl-no-comments i {
        display: block; font-size: 2rem; color: var(--tf-border);
        margin-bottom: 0.6rem;
    }

    /* Comment input area */
    .mdl-comment-form {
        padding: 0.8rem 1.2rem; border-top: 1px solid var(--tf-border);
        flex-shrink: 0;
    }
    .mdl-comment-form-row {
        display: flex; gap: 0.5rem; align-items: flex-end;
    }
    .mdl-comment-form select {
        width: 100%; padding: 0.5rem 0.7rem; border-radius: 8px;
        border: 1px solid var(--tf-border); background: var(--tf-navy);
        color: var(--tf-white); font-size: 0.82rem; margin-bottom: 0.5rem;
        font-family: inherit;
    }
    .mdl-comment-form select:focus {
        outline: none; border-color: var(--tf-gold);
    }
    .mdl-comment-form textarea {
        flex: 1; padding: 0.55rem 0.8rem; border-radius: 20px;
        border: 1px solid var(--tf-border); background: var(--tf-navy);
        color: var(--tf-white); font-size: 0.85rem; resize: none;
        min-height: 38px; max-height: 100px; font-family: inherit;
        transition: border-color 0.2s;
    }
    .mdl-comment-form textarea:focus {
        outline: none; border-color: var(--tf-gold);
    }
    .mdl-comment-send {
        width: 38px; height: 38px; border-radius: 50%; border: none;
        background: var(--tf-gold); color: var(--tf-midnight);
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        font-size: 0.9rem; flex-shrink: 0; transition: background 0.2s;
    }
    .mdl-comment-send:hover { background: var(--tf-gold-dark); }
    .mdl-comment-send:disabled { opacity: 0.4; cursor: not-allowed; }
    .mdl-comment-errors {
        list-style: none; padding: 0; margin: 0 0 0.5rem;
    }
    .mdl-comment-errors li {
        background: rgba(231,76,60,0.12); color: #e74c3c;
        padding: 0.35rem 0.7rem; border-radius: 6px; font-size: 0.78rem;
        margin-bottom: 0.25rem;
    }

    /* Responsive: stack on mobile */
    @media (max-width: 700px) {
        .modal-detail-body { flex-direction: column; }
        .modal-detail-left { border-right: none; border-bottom: 1px solid var(--tf-border); }
        .modal-detail { max-height: 95vh; }
    }
    @media (max-width: 992px) {
        .topbar-filter-chips { display: none; }
    }

    /* ── Light mode overrides for feed ── */
    [data-theme="light"] .ln-post-card,
    [data-theme="light"] .ln-start-post {
        background: #ffffff; border-color: #dddfe2;
    }
    [data-theme="light"] .ln-post-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
    [data-theme="light"] .ln-post-author-name { color: #1c1e21; }
    [data-theme="light"] .ln-post-author-name:hover { color: var(--tf-gold-dark); }
    [data-theme="light"] .ln-post-title a { color: var(--tf-gold-dark); }
    [data-theme="light"] .ln-post-content { color: #333; }
    [data-theme="light"] .ln-post-actions { border-color: #dddfe2; }
    [data-theme="light"] .ln-vote-btn { color: #65676b; }
    [data-theme="light"] .ln-vote-btn:hover { background: rgba(0,0,0,0.04); }
    [data-theme="light"] .ln-vote-count { color: #1c1e21; }
    [data-theme="light"] .ln-action-btn { color: #65676b; }
    [data-theme="light"] .ln-action-btn:hover { background: rgba(0,0,0,0.04); color: #1c1e21; }
    [data-theme="light"] .ln-tts-btn.speaking {
        color: var(--tf-gold-dark);
        background: rgba(201, 162, 39, 0.16);
    }
    [data-theme="light"] .ln-start-post-btn { border-color: #dddfe2; color: #65676b; }
    [data-theme="light"] .ln-start-post-btn:hover { background: #f0f2f5; border-color: var(--tf-gold); color: #1c1e21; }
    [data-theme="light"] .ln-sort-bar hr { border-color: #dddfe2; }
    [data-theme="light"] .ln-dropdown-menu { background: #fff; border-color: #dddfe2; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
    [data-theme="light"] .ln-dropdown-item { color: #1c1e21; }
    [data-theme="light"] .ln-dropdown-item:hover { background: #f0f2f5; color: var(--tf-gold-dark); }
    [data-theme="light"] .ln-dropdown-item.danger { color: #e74c3c; }
    [data-theme="light"] .ln-post-stats { color: #65676b; }
    [data-theme="light"] .ln-post-stats-right button { color: #65676b; }
    [data-theme="light"] .ln-post-stats-right button:hover { color: var(--tf-gold-dark); }
    [data-theme="light"] .ln-empty { color: #65676b; }
    [data-theme="light"] .ln-empty i { color: #ccc; }
    [data-theme="light"] .ln-report-btn { background: rgba(212, 168, 67, 0.1); border-color: rgba(212, 168, 67, 0.22); color: var(--tf-gold-dark); }
    [data-theme="light"] .ln-removed-card,
    [data-theme="light"] .mdl-removed-card { background: #f1f3f5; border-color: #d7dbe0; color: #495057; }
    [data-theme="light"] .ln-post-card.is-hidden .ln-post-title,
    [data-theme="light"] .ln-post-card.is-hidden .ln-post-title a { color: #495057; }

    /* Light mode: modals */
    [data-theme="light"] .modal-overlay { background: rgba(0,0,0,0.35); }
    [data-theme="light"] .modal-box { background: #fff; border-color: #dddfe2; }
    [data-theme="light"] .modal-new-post-header { border-color: #dddfe2; }
    [data-theme="light"] .modal-new-post-header h3 { color: #1c1e21; }
    [data-theme="light"] .modal-field label { color: #65676b; }
    [data-theme="light"] .modal-field input,
    [data-theme="light"] .modal-field textarea,
    [data-theme="light"] .modal-field select { background: #f0f2f5; border-color: #dddfe2; color: #1c1e21; }
    [data-theme="light"] .modal-field input:focus,
    [data-theme="light"] .modal-field textarea:focus,
    [data-theme="light"] .modal-field select:focus { border-color: var(--tf-gold); }
    [data-theme="light"] .modal-new-post-footer { border-color: #dddfe2; }
    [data-theme="light"] .modal-btn-cancel { color: #65676b; border-color: #dddfe2; }
    [data-theme="light"] .modal-close { color: #65676b; }
    [data-theme="light"] .modal-close:hover { background: rgba(0,0,0,0.06); color: #1c1e21; }

    /* Light mode: detail modal */
    [data-theme="light"] .modal-detail-left { border-color: #dddfe2; }
    [data-theme="light"] .mdl-author-name { color: #1c1e21; }
    [data-theme="light"] .mdl-post-title { color: var(--tf-gold-dark); }
    [data-theme="light"] .mdl-post-content { color: #333; }
    [data-theme="light"] .mdl-post-meta { border-color: #dddfe2; color: #65676b; }
    [data-theme="light"] .mdl-comments-header { color: #1c1e21; border-color: #dddfe2; }
    [data-theme="light"] .mdl-comment-bubble { background: #f0f2f5; }
    [data-theme="light"] .mdl-comment-author { color: #1c1e21; }
    [data-theme="light"] .mdl-comment-text { color: #333; }
    [data-theme="light"] .mdl-comment-form { border-color: #dddfe2; }
    [data-theme="light"] .mdl-comment-form textarea { background: #f0f2f5; border-color: #dddfe2; color: #1c1e21; }
    [data-theme="light"] .mdl-comment-form textarea:focus { border-color: var(--tf-gold); }
    [data-theme="light"] .mdl-comment-edit-area { background: #fff; border-color: var(--tf-gold); color: #1c1e21; }
    [data-theme="light"] .mdl-comment-dropdown { background: #fff; border-color: #dddfe2; }
    [data-theme="light"] .mdl-comment-dropdown-item { color: #1c1e21; }
    [data-theme="light"] .mdl-comment-dropdown-item:hover { background: #f0f2f5; }

    /* ── Sidebar Widgets ── */
    .sidebar-widget {
        background: var(--tf-card-bg);
        border: 1px solid var(--tf-border);
        border-radius: 12px;
        padding: 0.75rem 0.8rem;
    }
    .sidebar-widget-title {
        font-size: 0.86rem;
        font-weight: 700;
        color: var(--tf-white);
        margin: 0 0 0.6rem 0;
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }
    .sidebar-widget-title i {
        color: var(--tf-gold);
        font-size: 0.7rem;
    }
    .sidebar-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.45rem;
    }
    .sidebar-stat-card {
        background: rgba(212, 168, 67, 0.08);
        border: 1px solid rgba(212, 168, 67, 0.2);
        border-radius: 8px;
        padding: 0.5rem 0.35rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        transition: transform 0.2s, border-color 0.2s;
    }
    .sidebar-stat-card:hover {
        transform: translateY(-2px);
        border-color: var(--tf-gold);
    }
    .sidebar-stat-card i {
        font-size: 0.8rem;
        color: var(--tf-gold);
    }
    .sidebar-stat-value {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--tf-white);
        line-height: 1.1;
    }
    .sidebar-stat-label {
        font-size: 0.68rem;
        color: var(--tf-gray);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .sidebar-chart-container {
        position: relative;
        width: 100%;
        height: 170px;
    }
    .sidebar-chart-container canvas {
        width: 100% !important;
        height: 100% !important;
    }

    /* Ad Placeholder */
    .sidebar-ad {
        background: linear-gradient(135deg, rgba(212,168,67,0.08), rgba(212,168,67,0.02));
        border: 1px dashed rgba(212,168,67,0.35);
    }
    .sidebar-ad-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 0.4rem;
        gap: 0.25rem;
    }
    .sidebar-ad-inner i {
        font-size: 1.1rem;
        color: var(--tf-gold);
        opacity: 0.5;
    }
    .sidebar-ad-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--tf-gold);
        opacity: 0.7;
    }
    .sidebar-ad-sub {
        font-size: 0.62rem;
        color: var(--tf-gray);
    }

    /* Light mode sidebar overrides */
    [data-theme="light"] .sidebar-widget { background: #fff; border-color: #e2e6ef; }
    [data-theme="light"] .sidebar-widget-title { color: #1a1a2e; }
    [data-theme="light"] .sidebar-stat-card { background: rgba(212,168,67,0.08); border-color: rgba(212,168,67,0.2); }
    [data-theme="light"] .sidebar-stat-value { color: #1a1a2e; }
    [data-theme="light"] .sidebar-stat-label { color: #5a5f7a; }
    [data-theme="light"] .sidebar-ad { background: linear-gradient(135deg, rgba(212,168,67,0.06), rgba(212,168,67,0.02)); border-color: rgba(212,168,67,0.3); }
    [data-theme="light"] .ln-rules-header h3 { color: #1a1a2e; }
    [data-theme="light"] .ln-rules-list li strong { color: #1a1a2e; }

    /* ── Media Toolbar (Create/Edit modals) ── */
    .modal-media-toolbar {
        display: flex; gap: 0.4rem; padding: 0.4rem 0; border-top: 1px solid var(--tf-border);
    }
    .media-tool-btn {
        display: flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.7rem;
        border-radius: 20px; border: 1px solid var(--tf-border); background: transparent;
        color: var(--tf-gray); font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
    }
    .media-tool-btn:hover { border-color: var(--tf-gold); color: var(--tf-gold); }
    .media-tool-btn.active { border-color: var(--tf-gold); color: var(--tf-gold); background: rgba(212,168,67,0.1); }
    .media-tool-btn i { font-size: 0.9rem; }

    /* Media previews in modals */
    .modal-media-preview {
        margin-top: 0.5rem; display: none; position: relative;
    }
    .modal-media-preview.visible { display: block; }
    .modal-media-preview img {
        max-width: 100%; max-height: 220px; border-radius: 8px; object-fit: cover;
        border: 1px solid var(--tf-border);
    }
    .media-remove-btn {
        position: absolute; top: 4px; right: 4px; width: 24px; height: 24px;
        border-radius: 50%; background: rgba(0,0,0,0.7); color: #fff; border: none;
        cursor: pointer; font-size: 0.75rem; display: flex; align-items: center;
        justify-content: center; z-index: 2;
    }
    .media-remove-btn:hover { background: #e74c3c; }
    .media-uploading {
        display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem;
        font-size: 0.8rem; color: var(--tf-gold);
    }
    .media-uploading .spinner { width: 16px; height: 16px; border-width: 2px; }

    /* ── Post media in feed cards ── */
    .ln-post-media { margin: 0.6rem 0 0; }
    .ln-post-media img {
        width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px;
        border: 1px solid var(--tf-border); cursor: pointer;
    }

    /* ── Light mode media overrides ── */
    [data-theme="light"] .media-tool-btn { color: #65676b; border-color: #dddfe2; }
    [data-theme="light"] .media-tool-btn:hover { color: var(--tf-gold-dark); border-color: var(--tf-gold-dark); }
    [data-theme="light"] .media-tool-btn.active { color: var(--tf-gold-dark); border-color: var(--tf-gold-dark); background: rgba(212,168,67,0.1); }

    /* ── Language Badge on Posts ── */
    .ln-lang-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
        padding: 0.15rem 0.45rem; border-radius: 10px;
        background: rgba(212, 168, 67, 0.1); color: var(--tf-gold);
        border: 1px solid rgba(212, 168, 67, 0.25);
        letter-spacing: 0.5px; line-height: 1;
    }
    .ln-lang-badge i { font-size: 0.55rem; }
    [data-theme="light"] .ln-lang-badge {
        background: rgba(212, 168, 67, 0.08); border-color: rgba(212, 168, 67, 0.3);
        color: var(--tf-gold-dark);
    }

    /* ── Floating Language Picker ── */
    .lang-picker {
        position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 8000;
    }
    .lang-picker-btn {
        width: 48px; height: 48px; border-radius: 50%;
        background: var(--tf-gold); color: var(--tf-midnight);
        border: none; cursor: pointer; font-size: 1.1rem;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .lang-picker-btn:hover { transform: scale(1.1); box-shadow: 0 6px 24px rgba(0,0,0,0.4); }
    .lang-picker-btn .lang-picker-current {
        font-size: 0.6rem; font-weight: 800; position: absolute;
        bottom: -2px; right: -2px; background: var(--tf-midnight);
        color: var(--tf-gold); padding: 0.1rem 0.3rem; border-radius: 6px;
        line-height: 1; border: 1.5px solid var(--tf-gold);
    }
    [data-theme="light"] .lang-picker-btn .lang-picker-current {
        background: #fff; color: var(--tf-gold-dark); border-color: var(--tf-gold-dark);
    }
    .lang-picker-menu {
        display: none; position: absolute; bottom: 56px; left: 0;
        background: var(--tf-card-bg); border: 1px solid var(--tf-border);
        border-radius: 12px; overflow: hidden; min-width: 170px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.4);
        animation: modalIn 0.15s ease-out;
    }
    .lang-picker-menu.open { display: block; }
    .lang-picker-menu-title {
        padding: 0.6rem 0.9rem 0.4rem; font-size: 0.7rem; font-weight: 700;
        color: var(--tf-gray); text-transform: uppercase; letter-spacing: 0.5px;
    }
    .lang-picker-option {
        display: flex; align-items: center; gap: 0.6rem;
        padding: 0.55rem 0.9rem; cursor: pointer; transition: background 0.15s;
        border: none; background: none; width: 100%; color: var(--tf-white);
        font-size: 0.85rem; text-align: left;
    }
    .lang-picker-option:hover { background: rgba(212, 168, 67, 0.1); }
    .lang-picker-option.active { color: var(--tf-gold); font-weight: 700; }
    .lang-picker-option .lang-flag { font-size: 1.1rem; }
    .lang-picker-option .lang-name { flex: 1; }
    .lang-picker-option .lang-check { font-size: 0.7rem; color: var(--tf-gold); }
    .lang-picker-sep { border-top: 1px solid var(--tf-border); margin: 0.2rem 0; }
    .lang-picker-option.original-btn {
        font-size: 0.78rem; color: var(--tf-gray); justify-content: center; gap: 0.4rem;
    }
    .lang-picker-option.original-btn:hover { color: var(--tf-white); }
    [data-theme="light"] .lang-picker-menu { background: #fff; border-color: #dddfe2; }
    [data-theme="light"] .lang-picker-option { color: #1c1e21; }
    [data-theme="light"] .lang-picker-option:hover { background: #f0f2f5; }
    [data-theme="light"] .lang-picker-option.active { color: var(--tf-gold-dark); }

    /* Translation loading state */
    .ln-post-card.translating { opacity: 0.6; pointer-events: none; }
    .ln-post-card.translating::after {
        content: ''; position: absolute; inset: 0; z-index: 2;
        background: rgba(0,0,0,0.03);
    }
    /* RTL support for Arabic */
    .ln-post-card[data-display-lang="ar"] .ln-post-title,
    .ln-post-card[data-display-lang="ar"] .ln-post-content-text,
    .ln-post-card[data-display-lang="ar"] .mdl-post-title,
    .ln-post-card[data-display-lang="ar"] .mdl-post-content {
        direction: rtl; text-align: right;
    }

    /* ── Voice Memo Recorder ── */
    .voice-recorder-wrap {
        display: flex; align-items: center; gap: 0.5rem;
        padding: 0.5rem 0; margin-top: 0.3rem;
    }
    .voice-recorder-wrap.hidden { display: none; }
    .voice-rec-btn {
        width: 36px; height: 36px; border-radius: 50%; border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        background: var(--tf-border); color: var(--tf-text); font-size: 0.9rem;
        transition: all 0.2s;
    }
    .voice-rec-btn.recording {
        background: #e74c3c; color: #fff;
        animation: pulse-rec 1s ease-in-out infinite;
    }
    @keyframes pulse-rec { 0%,100%{transform:scale(1)} 50%{transform:scale(1.12)} }
    .voice-rec-timer { font-size: 0.78rem; color: var(--tf-gray); font-variant-numeric: tabular-nums; min-width: 38px; }
    .voice-rec-preview {
        flex: 1; display: flex; align-items: center; gap: 0.4rem;
    }
    .voice-rec-preview audio { height: 32px; flex: 1; max-width: 220px; }
    .voice-rec-remove {
        background: none; border: none; color: #e74c3c; cursor: pointer; font-size: 0.85rem;
        padding: 0.2rem; border-radius: 4px;
    }
    .voice-rec-remove:hover { background: rgba(231,76,60,0.1); }

    /* ── Audio player in post card ── */
    .ln-post-audio {
        margin: 0.5rem 0 0.2rem;
        padding: 0.5rem 0.7rem;
        background: var(--tf-border);
        border-radius: 10px;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .ln-post-audio i { color: var(--tf-gold); font-size: 0.95rem; flex-shrink: 0; }
    .ln-post-audio audio { height: 32px; flex: 1; }
    .ln-post-audio .audio-label { font-size: 0.72rem; color: var(--tf-gray); white-space: nowrap; }
</style>
{% endblock %}

{% block topbar_center %}{% endblock %}

{% block body %}
<div class="ln-feed-wrapper">

{# ── Left Sidebar: Rules ── #}
<div class="ln-feed-left">
    <div class="ln-rules-card sidebar-widget">
        <div class="ln-rules-header" id="rulesToggle">
            <h3 class="sidebar-widget-title" style="margin: 0;"><i class="fas fa-shield-alt"></i> Règles du Forum</h3>
            <i class="fas fa-chevron-down ln-rules-toggle" id="rulesChevron"></i>
        </div>
        <ul class="ln-rules-list" id="rulesList">
            <li><i class="fas fa-check-circle"></i> <span><strong>Respect</strong> — Restez courtois.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>Pas d'insultes</strong> — Langage poli exigé.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>Pas de spam</strong> — Pas de doublons.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>Pro uniquement</strong> — Contenu RH/emploi.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>0 discrimination</strong> — Tolérance zéro.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>Données privées</strong> — Rien de sensible.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>Qualité</strong> — Titres clairs, contenu utile.</span></li>
            <li><i class="fas fa-check-circle"></i> <span><strong>Signaler</strong> — Alertez un admin.</span></li>
        </ul>
        <div class="ln-rules-footer">
            <i class="fas fa-info-circle"></i> Tout abus sera sanctionné.
        </div>
    </div>

    {# Ad Placeholder #}
    <div class="sidebar-widget sidebar-ad" style="margin-top:0.8rem;">
        <div class="sidebar-ad-inner">
            <i class="fas fa-bullhorn"></i>
            <span class="sidebar-ad-label">Espace publicitaire</span>
            <span class="sidebar-ad-sub">Votre annonce ici</span>
        </div>
    </div>
</div>

<div class="ln-feed-main">

    {# ── Search & Filters ── #}
    <div class="ln-feed-search-bar">
        <div class="ln-feed-search-inner">
            <i class="fas fa-search" style="color:var(--tf-gray); font-size:0.85rem; flex-shrink:0;"></i>
            <input type="text" class="ln-feed-search-input" id="feedSearch"
                   placeholder="Rechercher un post, un auteur..." autocomplete="off">
            <span class="ln-result-count" id="resultCount"></span>
        </div>
        <div class="ln-feed-filter-chips">
            <button class="ln-filter-chip active" data-sort="recent"><i class="fas fa-clock"></i> Récents</button>
            <button class="ln-filter-chip" data-sort="top"><i class="fas fa-fire"></i> Top</button>
            <button class="ln-filter-chip" data-sort="oldest"><i class="fas fa-history"></i> Anciens</button>
            <button class="ln-filter-chip" data-sort="comments"><i class="fas fa-comments"></i> Commentés</button>
        </div>
    </div>

    {# ── Start a Post (opens modal) ── #}
    <div class="ln-start-post">
        <div class="ln-start-post-top">
            <span class="ln-avatar">
                {% if app.user %}
                    {{ app.user.prenom|default('U')|first|upper }}
                {% else %}
                    <i class="fas fa-user" style="font-size: 0.9rem;"></i>
                {% endif %}
            </span>
            <button type="button" class="ln-start-post-btn" id="openNewPostModal">
                Commencer un post...
            </button>
        </div>
    </div>

    {# ── Sort Bar ── #}
    <div class="ln-sort-bar">
        <hr>
    </div>

    {# ── Loading ── #}
    <div class="ln-loading" id="feedLoading">
        <span class="spinner"></span>
    </div>

    {# ── Posts container ── #}
    <div id="feedContainer">
        {% if posts|length > 0 %}
            {% for post in posts %}
            {% set postHiddenForViewer = post.hidden and not is_granted('ROLE_ADMIN') %}
            {% set renderedTitle = postHiddenForViewer ? 'Post retiré' : post.title %}
            {% set renderedContent = postHiddenForViewer ? 'This post was removed for violating community guidelines.' : post.content|default('') %}
            <div class="ln-post-card{{ postHiddenForViewer ? ' is-hidden' : '' }}" data-post-id="{{ post.id }}" data-original-lang="{{ postHiddenForViewer ? 'fr' : postLangs[post.id]|default('fr') }}" data-display-lang="{{ postHiddenForViewer ? 'fr' : postLangs[post.id]|default('fr') }}" data-original-title="{{ renderedTitle }}" data-original-content="{{ renderedContent }}">
                <div class="ln-post-header">
                    <span class="ln-avatar">{{ post.authorName|first|upper }}</span>
                    <div class="ln-post-author-info">
                        <span class="ln-post-author-name">{{ post.authorName }}</span>
                        <div class="ln-post-author-role">{{ post.authorRole }}</div>
                        <div class="ln-post-time">
                            {% if post.createdAt %}
                                {% set diff = date().timestamp - post.createdAt.timestamp %}
                                {% if diff < 60 %}à l'instant
                                {% elseif diff < 3600 %}il y a {{ (diff / 60)|round(0, 'floor') }} min
                                {% elseif diff < 86400 %}il y a {{ (diff / 3600)|round(0, 'floor') }} h
                                {% elseif diff < 604800 %}il y a {{ (diff / 86400)|round(0, 'floor') }} j
                                {% else %}{{ post.createdAt|date('d/m/Y') }}
                                {% endif %}
                            {% endif %}
                            &bull; <i class="fas fa-globe-americas"></i>
                            <span class="ln-lang-badge" title="Langue originale"><i class="fas fa-language"></i> {{ postLangs[post.id]|default('fr')|upper }}</span>
                        </div>
                    </div>
                    <div class="ln-post-menu">
                        {% if app.user and not is_granted('ROLE_ADMIN') and not post.hidden %}
                        <button class="ln-report-btn open-report-modal" data-id="{{ post.id }}" title="Signaler ce post">
                            <i class="fas fa-flag"></i>
                        </button>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') or (app.user and post.author is same as(app.user)) %}
                        <div class="ln-dropdown">
                            <button class="ln-post-menu-btn" title="Plus d'options">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                            <div class="ln-dropdown-menu">
                                <button class="ln-dropdown-item open-edit-modal" data-id="{{ post.id }}">
                                    <i class="fas fa-pen"></i> Modifier
                                </button>
                                <div class="ln-dropdown-sep"></div>
                                <form method="post" action="{{ path('post_delete', {id: post.id}) }}" onsubmit="return confirm('Supprimer ce post ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                    <button type="submit" class="ln-dropdown-item danger">
                                        <i class="fas fa-trash-alt"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <div class="ln-post-title">
                    <a href="#" class="open-detail-modal" data-id="{{ post.id }}">{{ renderedTitle }}</a>
                </div>
                <div class="ln-post-content">
                    {% if postHiddenForViewer %}
                    <div class="ln-removed-card">This post was removed for violating community guidelines.</div>
                    {% elseif post.content %}
                    <div class="ln-post-content-text">{{ post.content }}</div>
                    {% if post.content|length > 200 %}
                        <a href="#" class="ln-see-more open-detail-modal" data-id="{{ post.id }}">...voir plus</a>
                    {% endif %}
                    {% endif %}
                </div>
                {% if post.imagePath and not postHiddenForViewer %}
                <div class="ln-post-media">
                    <img src="{{ post.imagePath }}" alt="Post image" loading="lazy">
                </div>
                {% endif %}
                {% if post.audioPath and not postHiddenForViewer %}
                <div class="ln-post-audio">
                    <i class="fas fa-microphone"></i>
                    <audio controls preload="metadata" src="{{ post.audioPath }}"></audio>
                    <span class="audio-label">Mémo vocal</span>
                </div>
                {% endif %}

                {% if not postHiddenForViewer and (post.upvotes != 0 or post.commentCount > 0) %}
                <div class="ln-post-stats">
                    <div class="ln-post-stats-left">
                        {% if post.upvotes != 0 %}
                            <span class="ln-reaction-icons">
                                <span class="ln-reaction-icon {{ post.upvotes > 0 ? 'up' : 'down' }}"><i class="fas fa-arrow-{{ post.upvotes > 0 ? 'up' : 'down' }}"></i></span>
                            </span>
                            <span>{{ post.upvotes }}</span>
                        {% endif %}
                    </div>
                    <div class="ln-post-stats-right">
                        {% if post.commentCount > 0 %}
                            <button class="open-detail-modal" data-id="{{ post.id }}">{{ post.commentCount }} commentaire{{ post.commentCount > 1 ? 's' : '' }}</button>
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                {% if not postHiddenForViewer %}
                <div class="ln-ai-summary" data-summary-id="{{ post.id }}"></div>
                <div class="ln-post-actions">
                    <div class="ln-vote-group">
                        <button class="ln-vote-btn upvote{{ userVotes[post.id] is defined and userVotes[post.id] == 'up' ? ' voted' : '' }}" data-id="{{ post.id }}" title="Upvote">
                            <i class="fas fa-arrow-up"></i>
                        </button>
                        <span class="ln-vote-count" data-vote-count="{{ post.id }}">{{ post.upvotes }}</span>
                        <button class="ln-vote-btn downvote{{ userVotes[post.id] is defined and userVotes[post.id] == 'down' ? ' voted' : '' }}" data-id="{{ post.id }}" title="Downvote">
                            <i class="fas fa-arrow-down"></i>
                        </button>
                    </div>
                    <button class="ln-action-btn open-detail-modal" data-id="{{ post.id }}" title="Commenter">
                        <i class="far fa-comment-dots"></i> <span>Commenter</span>
                    </button>
                    <button class="ln-action-btn ln-tts-btn" data-id="{{ post.id }}" title="Lire ce post à voix haute">
                        <i class="fas fa-volume-up"></i> <span>Écouter</span>
                    </button>
                    {% if (post.content|default('')|split(' ')|length) > 100 %}
                    <button class="ln-action-btn ln-summarize-btn" data-id="{{ post.id }}" title="Résumer avec IA">
                        <i class="fas fa-wand-magic-sparkles"></i> <span>Résumer</span>
                    </button>
                    {% endif %}
                    {% if app.user and post.author and post.author.id != app.user.id %}
                    <a href="{{ path('message_start', {id: post.author.id}) }}" class="ln-action-btn" title="Envoyer un message">
                        <i class="far fa-paper-plane"></i> <span>Message</span>
                    </a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        {% else %}
            <div class="ln-post-card">
                <div class="ln-empty">
                    <i class="fas fa-newspaper"></i>
                    <p>Aucun post pour le moment</p>
                    <button type="button" class="btn-gold" id="openNewPostModalEmpty">
                        <i class="fas fa-plus"></i> Créer le premier post
                    </button>
                </div>
            </div>
        {% endif %}
    </div>

    {# ── No results ── #}
    <div class="ln-post-card ln-no-results" id="noResults">
        <i class="fas fa-search"></i>
        <p>Aucun post ne correspond à votre recherche</p>
    </div>
</div><!-- /ln-feed-main -->

{# ── Right Sidebar ── #}
<div class="ln-feed-sidebar">
    {# Mini Stat Cards #}
    <div class="sidebar-widget">
        <h4 class="sidebar-widget-title"><i class="fas fa-chart-pie"></i> Statistiques</h4>
        <div class="sidebar-stats-grid">
            <div class="sidebar-stat-card">
                <i class="fas fa-file-alt"></i>
                <span class="sidebar-stat-value">{{ totalPosts }}</span>
                <span class="sidebar-stat-label">Posts</span>
            </div>
            <div class="sidebar-stat-card">
                <i class="fas fa-comments"></i>
                <span class="sidebar-stat-value">{{ totalComments }}</span>
                <span class="sidebar-stat-label">Commentaires</span>
            </div>
            <div class="sidebar-stat-card">
                <i class="fas fa-users"></i>
                <span class="sidebar-stat-value">{{ totalUsers }}</span>
                <span class="sidebar-stat-label">Membres</span>
            </div>
            <div class="sidebar-stat-card">
                <i class="fas fa-thumbs-up"></i>
                <span class="sidebar-stat-value">{{ totalVotes }}</span>
                <span class="sidebar-stat-label">Votes</span>
            </div>
        </div>
    </div>

    {# Activity Chart #}
    <div class="sidebar-widget">
        <h4 class="sidebar-widget-title"><i class="fas fa-chart-bar"></i> Activité (7 jours)</h4>
        <div class="sidebar-chart-container">
            <canvas id="activityChart"></canvas>
        </div>
    </div>

    {# Top Authors Chart #}
    <div class="sidebar-widget">
        <h4 class="sidebar-widget-title"><i class="fas fa-trophy"></i> Top contributeurs</h4>
        <div class="sidebar-chart-container">
            <canvas id="authorsChart"></canvas>
        </div>
    </div>

</div><!-- /ln-feed-sidebar -->
</div><!-- /ln-feed-wrapper -->

{# ══════════════════════════════════════════════════
   MODAL: New Post
   ══════════════════════════════════════════════════ #}
<div class="modal-overlay" id="newPostOverlay">
    <div class="modal-box modal-new-post">
        <button class="modal-close" id="closeNewPost">&times;</button>
        <div class="modal-new-post-header">
            <span class="ln-avatar">
                {% if app.user %}
                    {{ app.user.prenom|default('U')|first|upper }}
                {% else %}
                    <i class="fas fa-user" style="font-size: 0.85rem;"></i>
                {% endif %}
            </span>
            <h3>Créer un post</h3>
        </div>
        <div class="modal-new-post-body">
            <ul class="modal-errors" id="newPostErrors"></ul>
            {% if is_granted('ROLE_ADMIN') %}
            <div class="modal-field">
                <label for="newPostAuthor"><i class="fas fa-user-tag"></i> Auteur</label>
                <select id="newPostAuthor">
                    <option value="">-- Sélectionner un auteur --</option>
                    {% for user in users %}
                        <option value="{{ user.id }}"
                            {% if app.user and app.user.id == user.id %} selected{% endif %}>
                            {{ user.fullName }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
            <div class="modal-field">
                <label for="newPostTitle"><i class="fas fa-heading"></i> Titre</label>
                <input type="text" id="newPostTitle" placeholder="De quoi voulez-vous parler ?" maxlength="255">
            </div>
            <div class="modal-field">
                <label for="newPostContent"><i class="fas fa-align-left"></i> Contenu</label>
                <textarea id="newPostContent" placeholder="Partagez vos idées, expériences ou questions..."></textarea>
            </div>
            <div class="modal-media-preview" id="newPostImagePreview"></div>
            <div class="modal-media-toolbar">
                <button type="button" class="media-tool-btn" id="newPostImageBtn" title="Ajouter une image">
                    <i class="fas fa-image"></i> Photo
                </button>
                <input type="file" id="newPostImageFile" accept="image/*" style="display:none;">
                <button type="button" class="media-tool-btn" id="newPostVoiceBtn" title="Mémo vocal">
                    <i class="fas fa-microphone"></i> Vocal
                </button>
            </div>
            <div class="voice-recorder-wrap hidden" id="newPostVoiceWrap">
                <button type="button" class="voice-rec-btn" id="newPostRecBtn" title="Enregistrer"><i class="fas fa-microphone"></i></button>
                <span class="voice-rec-timer" id="newPostRecTimer">0:00</span>
                <div class="voice-rec-preview" id="newPostRecPreview"></div>
            </div>
        </div>
        <div class="modal-new-post-footer">
            <button class="modal-btn modal-btn-cancel" id="cancelNewPost">Annuler</button>
            <button class="modal-btn modal-btn-submit" id="submitNewPost">
                <i class="fas fa-paper-plane"></i> Publier
            </button>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════
   MODAL: Edit Post
   ══════════════════════════════════════════════════ #}
<div class="modal-overlay" id="editPostOverlay">
    <div class="modal-box modal-new-post">
        <button class="modal-close" id="closeEditPost">&times;</button>
        <div class="modal-new-post-header">
            <span class="ln-avatar"><i class="fas fa-pen" style="font-size: 0.85rem;"></i></span>
            <h3>Modifier le post</h3>
        </div>
        <div class="modal-new-post-body">
            <ul class="modal-errors" id="editPostErrors"></ul>
            <div class="modal-field">
                <label for="editPostTitle"><i class="fas fa-heading"></i> Titre</label>
                <input type="text" id="editPostTitle" placeholder="Titre du post" maxlength="255">
            </div>
            <div class="modal-field">
                <label for="editPostContent"><i class="fas fa-align-left"></i> Contenu</label>
                <textarea id="editPostContent" placeholder="Contenu du post..."></textarea>
            </div>
            <div class="modal-media-preview" id="editPostImagePreview"></div>
            <div class="modal-media-toolbar">
                <button type="button" class="media-tool-btn" id="editPostImageBtn" title="Ajouter une image">
                    <i class="fas fa-image"></i> Photo
                </button>
                <input type="file" id="editPostImageFile" accept="image/*" style="display:none;">
                <button type="button" class="media-tool-btn" id="editPostVoiceBtn" title="Mémo vocal">
                    <i class="fas fa-microphone"></i> Vocal
                </button>
            </div>
            <div class="voice-recorder-wrap hidden" id="editPostVoiceWrap">
                <button type="button" class="voice-rec-btn" id="editPostRecBtn" title="Enregistrer"><i class="fas fa-microphone"></i></button>
                <span class="voice-rec-timer" id="editPostRecTimer">0:00</span>
                <div class="voice-rec-preview" id="editPostRecPreview"></div>
            </div>
        </div>
        <div class="modal-new-post-footer">
            <button class="modal-btn modal-btn-cancel" id="cancelEditPost">Annuler</button>
            <button class="modal-btn modal-btn-submit" id="submitEditPost">
                <i class="fas fa-check"></i> Enregistrer
            </button>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════
   MODAL: Post Detail + Comments (split view)
   ══════════════════════════════════════════════════ #}
<div class="modal-overlay" id="detailOverlay">
    <div class="modal-box modal-detail">
        <button class="modal-close" id="closeDetail">&times;</button>
        <div class="modal-detail-body">
            {# Left: post details #}
            <div class="modal-detail-left" id="detailLeft">
                <div class="ln-loading" id="detailLoading" style="display:block;">
                    <span class="spinner"></span>
                </div>
            </div>
            {# Right: comments #}
            <div class="modal-detail-right">
                <div class="mdl-comments-header">
                    <i class="far fa-comment-dots"></i> Commentaires (<span id="detailCommentCount">0</span>)
                </div>
