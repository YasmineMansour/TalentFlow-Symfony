{% extends 'base_dashboard.html.twig' %}

{% block title %}Forum - Posts{% endblock %}
{% block page_title %}Gestion des Posts{% endblock %}

{% block body %}
<div class="tf-card">
    <div class="tf-card-header">
        <h3><i class="fas fa-newspaper"></i> Liste des Posts <span style="color: var(--tf-gray); font-weight: 400; font-size: 0.9rem;">({{ posts|length }})</span></h3>
        <a href="{{ path('post_new') }}" class="btn-gold">
            <i class="fas fa-plus"></i> Nouveau Post
        </a>
    </div>

    {% if posts|length > 0 %}
    <div class="table-responsive">
        <table class="tf-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th><i class="fas fa-thumbs-up"></i> Votes</th>
                    <th><i class="fas fa-comments"></i> Commentaires</th>
                    <th>Créé le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                <tr>
                    <td>
                        <a href="{{ path('post_show', {id: post.id}) }}" style="color: var(--tf-gold); text-decoration: none; font-weight: 600;">
                            {{ post.title }}
                        </a>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="tf-avatar" style="width: 30px; height: 30px; font-size: 0.65rem;">
                                {{ post.authorName|first|upper }}
                            </span>
                            <span>{{ post.authorName }}</span>
                        </div>
                    </td>
                    <td>
                        <span style="color: var(--tf-gold); font-weight: 600;">
                            <i class="fas fa-arrow-up" style="font-size: 0.75rem;"></i> {{ post.upvotes }}
                        </span>
                    </td>
                    <td>
                        <span class="badge-role badge-rh" style="font-size: 0.75rem;">{{ post.commentCount }}</span>
                    </td>
                    <td style="color: var(--tf-gray);">{{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    <td>
                        <div class="tf-actions">
                            <a href="{{ path('post_show', {id: post.id}) }}" class="btn-outline-gold btn-sm-tf" title="Voir">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('post_edit', {id: post.id}) }}" class="btn-gold btn-sm-tf" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('post_delete', {id: post.id}) }}" style="display:inline" onsubmit="event.preventDefault(); confirmDelete(this, '{{ post.title|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button type="submit" class="btn-danger-tf btn-sm-tf" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div style="text-align: center; padding: 3rem; color: var(--tf-gray);">
        <i class="fas fa-newspaper" style="font-size: 3rem; color: var(--tf-border); margin-bottom: 1rem; display: block;"></i>
        <p style="font-size: 1.1rem;">Aucun post pour le moment</p>
        <a href="{{ path('post_new') }}" class="btn-gold" style="margin-top: 0.5rem;">
            <i class="fas fa-plus"></i> Créer le premier post
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
