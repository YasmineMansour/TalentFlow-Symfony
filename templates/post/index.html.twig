    let editingPostId = null;

    function openEditPostModal(postId) {
        editingPostId = postId;
        editPostErrors.innerHTML = '';
        document.getElementById('editPostTitle').value = '';
        document.getElementById('editPostContent').value = '';
        editPostImageUrl = '';
        editPostAudioData = '';
        document.getElementById('editPostImagePreview').classList.remove('visible');
        document.getElementById('editPostImagePreview').innerHTML = '';
        document.getElementById('editPostImageBtn').classList.remove('active');
        document.getElementById('editPostVoiceBtn').classList.remove('active');
        document.getElementById('editPostVoiceWrap').classList.add('hidden');
        document.getElementById('editPostRecPreview').innerHTML = '';
        document.getElementById('editPostRecTimer').textContent = '0:00';
        editPostOverlay.classList.add('active');

        // Load current post data
        fetch('/post/' + postId + '/detail', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            document.getElementById('editPostTitle').value = data.post.title;
            document.getElementById('editPostContent').value = data.post.content || '';
            if (data.post.imagePath) {
                editPostImageUrl = data.post.imagePath;
                showImagePreview('editPostImagePreview', data.post.imagePath, 'edit');
                document.getElementById('editPostImageBtn').classList.add('active');
            }
            if (data.post.audioPath) {
                editPostAudioData = data.post.audioPath;
                document.getElementById('editPostVoiceBtn').classList.add('active');
                document.getElementById('editPostVoiceWrap').classList.remove('hidden');
                const prev = document.getElementById('editPostRecPreview');
                prev.innerHTML = `
                    <audio controls src="${data.post.audioPath}" style="height:32px;flex:1;max-width:200px;"></audio>
                    <button type="button" class="voice-rec-remove" title="Supprimer">&times;</button>
                `;
                prev.querySelector('.voice-rec-remove').addEventListener('click', function() {
                    editPostAudioData = '__remove__';
                    prev.innerHTML = '';
                    document.getElementById('editPostRecTimer').textContent = '0:00';
                });
            }
            setTimeout(() => document.getElementById('editPostTitle').focus(), 50);
        });
