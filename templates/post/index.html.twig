    /* ══════════════════════════════════════════════
       DETAIL / COMMENT MODAL
       ══════════════════════════════════════════════ */
    const detailOverlay = document.getElementById('detailOverlay');
    const detailLeft = document.getElementById('detailLeft');
    const detailLoading = document.getElementById('detailLoading');
    const detailCommentsList = document.getElementById('detailCommentsList');
    const detailCommentCount = document.getElementById('detailCommentCount');
    const commentErrors = document.getElementById('commentErrors');
    const detailCommentForm = document.getElementById('detailCommentForm');

    function toggleDetailCommentForm(visible) {
        detailCommentForm.style.display = visible ? '' : 'none';
    }

    function openDetailModal(postId) {
        currentDetailPostId = postId;
        commentErrors.innerHTML = '';
        document.getElementById('commentContent').value = '';
        toggleDetailCommentForm(true);
        detailLeft.innerHTML = '<div class="ln-loading" style="display:block;"><span class="spinner"></span></div>';
        detailCommentsList.innerHTML = '';
        detailCommentCount.textContent = '0';
        detailOverlay.classList.add('active');

        fetch('/post/' + postId + '/detail', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            const p = data.post;
            toggleDetailCommentForm(!(p.hidden && !p.canViewOriginal));
            const pLang = p.lang || 'fr';
            // Store original for translation
            detailLeft.dataset.originalLang = pLang;
            detailLeft.dataset.originalTitle = p.title;
            detailLeft.dataset.originalContent = p.content || '';

            const displayLang = currentDisplayLang || pLang;
            const showTranslated = currentDisplayLang && currentDisplayLang !== pLang;

            if (showTranslated) {
                Promise.all([
                    translateText(p.title, pLang, displayLang),
                    p.content ? translateText(p.content, pLang, displayLang) : Promise.resolve(''),
                ]).then(([trTitle, trContent]) => {
                    renderDetailContent(p, trTitle, trContent, pLang, displayLang);
                });
            } else {
                renderDetailContent(p, p.title, p.content, pLang, pLang);
            }

            detailCommentCount.textContent = data.comments.length;
            if (data.comments.length === 0) {
                detailCommentsList.innerHTML = '<div class="mdl-no-comments"><i class="far fa-comment-dots"></i>Aucun commentaire pour le moment</div>';
            } else {
                detailCommentsList.innerHTML = data.comments.map(renderComment).join('');
            }
            // Scroll to bottom of comments
            detailCommentsList.scrollTop = detailCommentsList.scrollHeight;
            bindCommentActions();
        })
        .catch(() => {
            detailLeft.innerHTML = '<div class="mdl-no-comments"><i class="fas fa-exclamation-triangle"></i>Erreur de chargement</div>';
        });
    }

    function renderComment(c) {
        const showMenu = c.canManage;
        return `
        <div class="mdl-comment" data-comment-id="${c.id}">
            <span class="ln-avatar">${esc(c.authorInitial)}</span>
            <div class="mdl-comment-bubble">
                <div class="mdl-comment-header">
                    <div class="mdl-comment-author">${esc(c.authorName)}</div>
                    ${showMenu ? `
                    <div class="mdl-comment-menu">
                        <button class="mdl-comment-menu-btn" title="Options"><i class="fas fa-ellipsis-h"></i></button>
                        <div class="mdl-comment-dropdown">
                            <button class="mdl-comment-dropdown-item comment-edit-btn" data-id="${c.id}">
                                <i class="fas fa-pen"></i> Modifier
                            </button>
                            <button class="mdl-comment-dropdown-item danger comment-delete-btn" data-id="${c.id}" data-token="${esc(c.deleteToken || '')}">
                                <i class="fas fa-trash-alt"></i> Supprimer
                            </button>
                        </div>
                    </div>
                    ` : ''}
                </div>
                <div class="mdl-comment-text" data-comment-text="${c.id}">${esc(c.content)}</div>
                <div class="mdl-comment-time">${esc(c.timeLabel)}</div>
            </div>
        </div>`;
    }

    /* ── Comment Edit ── */
    function handleCommentEdit(e) {
        const id = e.currentTarget.dataset.id;
        const commentEl = document.querySelector(`.mdl-comment[data-comment-id="${id}"]`);
        const textEl = commentEl.querySelector(`[data-comment-text="${id}"]`);
        const currentText = textEl.textContent;

        textEl.innerHTML = `
            <textarea class="mdl-comment-edit-area">${esc(currentText)}</textarea>
            <div class="mdl-comment-edit-actions">
                <button class="mdl-edit-cancel">Annuler</button>
                <button class="mdl-edit-save" data-id="${id}">Enregistrer</button>
            </div>
        `;

        const textarea = textEl.querySelector('textarea');
        textarea.focus();
        textarea.selectionStart = textarea.value.length;

        textEl.querySelector('.mdl-edit-cancel').addEventListener('click', function() {
            textEl.textContent = currentText;
        });

        textEl.querySelector('.mdl-edit-save').addEventListener('click', function() {
            const newContent = textarea.value.trim();
            if (newContent.length < 2) { textarea.style.borderColor = '#e74c3c'; return; }
            this.disabled = true;

            fetch('/post/comment/' + id + '/edit-ajax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ content: newContent })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    textEl.textContent = data.comment.content;
                } else {
                    textarea.style.borderColor = '#e74c3c';
                    this.disabled = false;
                }
            })
            .catch(() => { this.disabled = false; });
        });
    }

    /* ── Comment Delete ── */
    function handleCommentDelete(e) {
        const btn = e.currentTarget;
        const id = btn.dataset.id;
        const token = btn.dataset.token;
        if (!confirm('Supprimer ce commentaire ?')) return;

        fetch('/post/comment/' + id + '/delete-ajax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ _token: token })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const commentEl = document.querySelector(`.mdl-comment[data-comment-id="${id}"]`);
                if (commentEl) commentEl.remove();
                detailCommentCount.textContent = data.commentCount;

                // Update feed card
                if (currentDetailPostId) {
                    const card = document.querySelector(`.ln-post-card[data-post-id="${currentDetailPostId}"]`);
                    if (card) {
                        const statsRight = card.querySelector('.ln-post-stats-right');
                        if (statsRight) {
                            const countBtn = statsRight.querySelector('.open-detail-modal');
                            if (countBtn) {
                                if (data.commentCount > 0) {
                                    countBtn.textContent = data.commentCount + ' commentaire' + (data.commentCount > 1 ? 's' : '');
                                } else {
                                    countBtn.remove();
                                }
                            }
                        }
                    }
                }

                if (detailCommentsList.querySelectorAll('.mdl-comment').length === 0) {
                    detailCommentsList.innerHTML = '<div class="mdl-no-comments"><i class="far fa-comment-dots"></i>Aucun commentaire pour le moment</div>';
                }
            }
        });
    }

    function bindCommentActions() {
        document.querySelectorAll('.comment-edit-btn').forEach(btn => {
            btn.removeEventListener('click', handleCommentEdit);
            btn.addEventListener('click', handleCommentEdit);
        });
        document.querySelectorAll('.comment-delete-btn').forEach(btn => {
            btn.removeEventListener('click', handleCommentDelete);
            btn.addEventListener('click', handleCommentDelete);
        });
    }

    function closeDetailModal() {
        detailOverlay.classList.remove('active');
        currentDetailPostId = null;
    }

    function renderDetailContent(p, title, content, origLang, displayLang) {
        if (p.hidden && !p.canViewOriginal) {
            detailLeft.innerHTML = `
                <div class="mdl-author-row">
                    <span class="ln-avatar">${esc(p.authorInitial)}</span>
                    <div>
                        <div class="mdl-author-name">${esc(p.authorName)}</div>
                        <div class="mdl-author-role">${esc(p.authorRole)}</div>
                        <div class="mdl-author-time"><i class="far fa-clock"></i> ${esc(p.timeLabel)}</div>
                    </div>
                </div>
                <div class="mdl-post-title">Post retiré</div>
                <div class="mdl-removed-card">${esc(p.hiddenMessage || hiddenPostMessage)}</div>
            `;
            return;
        }

        const dir = displayLang === 'ar' ? ' style="direction:rtl;text-align:right;"' : '';
        detailLeft.innerHTML = `
            <div class="mdl-author-row">
                <span class="ln-avatar">${esc(p.authorInitial)}</span>
                <div>
                    <div class="mdl-author-name">${esc(p.authorName)}</div>
                    <div class="mdl-author-role">${esc(p.authorRole)}</div>
                    <div class="mdl-author-time"><i class="far fa-clock"></i> ${esc(p.timeLabel)}
                        <span class="ln-lang-badge" title="Langue originale"><i class="fas fa-language"></i> ${origLang.toUpperCase()}</span>
                    </div>
                </div>
            </div>
            <div class="mdl-post-title"${dir}>${esc(title)}</div>
            ${content ? `<div class="mdl-post-content"${dir}>${esc(content)}</div>` : ''}
            ${p.imagePath ? `<div class="ln-post-media" style="margin:0.8rem 0;">
                <img src="${esc(p.imagePath)}" alt="Post image" style="max-height:300px;">
            </div>` : ''}
            ${p.audioPath ? `<div class="ln-post-audio" style="margin:0.5rem 0;">
                <i class="fas fa-microphone"></i>
                <audio controls preload="metadata" src="${esc(p.audioPath)}"></audio>
                <span class="audio-label">Mémo vocal</span>
            </div>` : ''}
            <div class="mdl-post-meta">
                <span><i class="fas fa-arrow-up"></i> ${p.upvotes} votes</span>
                <span><i class="far fa-comment-dots"></i> ${p.commentCount} commentaire${p.commentCount !== 1 ? 's' : ''}</span>
            </div>
        `;
    }

    document.getElementById('closeDetail').addEventListener('click', closeDetailModal);
    detailOverlay.addEventListener('click', function(e) {
        if (e.target === detailOverlay) closeDetailModal();
    });

    // Submit comment
    document.getElementById('submitComment').addEventListener('click', function() {
        if (!currentDetailPostId) return;
        const btn = this;
        const content = document.getElementById('commentContent').value.trim();
        const authorSelect = document.getElementById('commentAuthor');
        const author = authorSelect ? authorSelect.value : '';
        commentErrors.innerHTML = '';
        btn.disabled = true;

        fetch('/post/' + currentDetailPostId + '/comment-ajax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ content, author })
        })
        .then(r => r.json())
        .then(data => {
            btn.disabled = false;
            if (!data.success) {
                commentErrors.innerHTML = data.errors.map(e => '<li>' + esc(e) + '</li>').join('');
                return;
            }
            // Remove "no comments" message if present
            const noMsg = detailCommentsList.querySelector('.mdl-no-comments');
            if (noMsg) noMsg.remove();

            // Append new comment
            detailCommentsList.insertAdjacentHTML('beforeend', renderComment(data.comment));
            detailCommentsList.scrollTop = detailCommentsList.scrollHeight;
            detailCommentCount.textContent = data.commentCount;
            bindCommentActions();
            document.getElementById('commentContent').value = '';

            // Update comment count in feed card
            const card = document.querySelector(`.ln-post-card[data-post-id="${currentDetailPostId}"]`);
            if (card) {
                const statsRight = card.querySelector('.ln-post-stats-right');
                if (statsRight) {
                    const countBtn = statsRight.querySelector('.open-detail-modal');
                    if (countBtn) {
                        countBtn.textContent = data.commentCount + ' commentaire' + (data.commentCount > 1 ? 's' : '');
                    }
                }
            }
        })
        .catch(() => {
            btn.disabled = false;
            commentErrors.innerHTML = '<li>Erreur réseau, réessayez.</li>';
        });
    });

    // Allow Enter to submit comment (Shift+Enter for new line)
    document.getElementById('commentContent').addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            document.getElementById('submitComment').click();
        }
    });

    /* ══════════════════════════════════════════════
       BIND ALL INTERACTIVE ELEMENTS
       ══════════════════════════════════════════════ */
    function bindAll() {
        // Vote buttons
        document.querySelectorAll('.ln-vote-btn').forEach(btn => {
            btn.removeEventListener('click', handleVote);
            btn.addEventListener('click', handleVote);
        });
        // Detail modal openers
        document.querySelectorAll('.open-detail-modal').forEach(el => {
            el.removeEventListener('click', handleOpenDetail);
            el.addEventListener('click', handleOpenDetail);
        });
        // Edit modal openers
        document.querySelectorAll('.open-edit-modal').forEach(el => {
            el.removeEventListener('click', handleOpenEdit);
            el.addEventListener('click', handleOpenEdit);
        });
        document.querySelectorAll('.open-report-modal').forEach(el => {
            el.removeEventListener('click', handleOpenReport);
            el.addEventListener('click', handleOpenReport);
        });
        document.querySelectorAll('.ln-tts-btn').forEach(btn => {
            btn.removeEventListener('click', handleTtsClick);
            btn.addEventListener('click', handleTtsClick);
            setTtsButtonState(btn, activeTtsButton === btn && window.speechSynthesis?.speaking);
        });
        document.querySelectorAll('.ln-summarize-btn').forEach(btn => {
            btn.removeEventListener('click', handleSummarizeClick);
            btn.addEventListener('click', handleSummarizeClick);
        });
        // Restore cached summaries for visible cards
        document.querySelectorAll('.ln-ai-summary[data-summary-id]').forEach(card => {
            const id = card.dataset.summaryId;
            if (summaryCache[id] && !card.classList.contains('visible')) {
                // Don't auto-show on bind; only restore if user already had it open (card is visible)
            }
            const btn = document.querySelector(`.ln-summarize-btn[data-id="${id}"]`);
            if (btn) btn.classList.toggle('active', summaryCache[id] !== undefined && card.classList.contains('visible'));
        });
    }

    function handleOpenDetail(e) {
        e.preventDefault();
        const id = this.dataset.id;
        if (id) openDetailModal(id);
    }

    const reportOverlay = document.getElementById('reportOverlay');
    const reportErrors = document.getElementById('reportErrors');

    function openReportModal(postId) {
        currentReportPostId = postId;
        reportErrors.innerHTML = '';
        document.getElementById('reportReason').value = '';
        document.getElementById('reportDescription').value = '';
        reportOverlay.classList.add('active');
    }

    function closeReportModal() {
        reportOverlay.classList.remove('active');
        currentReportPostId = null;
    }

    function handleOpenReport(e) {
        e.preventDefault();
        const id = this.dataset.id;
        if (id) openReportModal(id);
    }

    document.getElementById('closeReport').addEventListener('click', closeReportModal);
    document.getElementById('cancelReport').addEventListener('click', closeReportModal);
    reportOverlay.addEventListener('click', function(e) {
        if (e.target === reportOverlay) closeReportModal();
    });

    document.getElementById('submitReport').addEventListener('click', function() {
        if (!currentReportPostId) return;
        const btn = this;
        const reason = document.getElementById('reportReason').value;
        const description = document.getElementById('reportDescription').value.trim();

        reportErrors.innerHTML = '';
        btn.disabled = true;

        fetch('/post/' + currentReportPostId + '/report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ reason, description })
        })
        .then(async r => ({ status: r.status, body: await r.json() }))
        .then(({ body }) => {
            btn.disabled = false;
            if (!body.success) {
                reportErrors.innerHTML = (body.errors || ['Erreur réseau, réessayez.']).map(e => '<li>' + esc(e) + '</li>').join('');
                return;
            }
            const postId = currentReportPostId;
            closeReportModal();
            const trigger = document.querySelector(`.open-report-modal[data-id="${postId}"]`);
            if (trigger) {
                trigger.disabled = true;
                trigger.innerHTML = '<i class="fas fa-check"></i>';
                trigger.title = 'Signalement envoyé';
            }
        })
        .catch(() => {
            btn.disabled = false;
            reportErrors.innerHTML = '<li>Erreur réseau, réessayez.</li>';
        });
    });

    // Keyboard: Escape to close modals
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (detailOverlay.classList.contains('active')) closeDetailModal();
            else if (reportOverlay.classList.contains('active')) closeReportModal();
            else if (editPostOverlay.classList.contains('active')) closeEditPostModal();
            else if (newPostOverlay.classList.contains('active')) closeNewPostModal();
            else if (speechSupported && window.speechSynthesis.speaking) stopSpeech();
        }
    });

    window.addEventListener('beforeunload', function() {
        if (speechSupported && window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
        }
    });

