{# Partial pour le tbody AJAX des posts #}
{% for post in posts %}
    <tr>
        <td>{{ post.id }}</td>
        <td>{{ post.title }}</td>
        <td>{{ post.author.nom }} {{ post.author.prenom }}</td>
        <td>{{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '' }}</td>
        <td>{{ post.upvotes }}</td>
        <td>
            <a href="{{ path('post_show', {'id': post.id}) }}" class="btn-table"><i class="fas fa-eye"></i></a>
            <a href="{{ path('post_edit', {'id': post.id}) }}" class="btn-table"><i class="fas fa-edit"></i></a>
        </td>
    </tr>
{% else %}
    <tr><td colspan="6" style="text-align:center;color:#888;">Aucun post trouvé.</td></tr>
{% endfor %}
