<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme="light">
    <head>
        <script>(function(){var t=localStorage.getItem('tf-theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);if(t==='dark')document.documentElement.classList.add('dark');})()</script>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TalentFlow{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>💼</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
        <style>
            :root {
                --tf-midnight: #1a1a2e;
                --tf-navy: #16213e;
                --tf-dark-blue: #0f3460;
                --tf-gold: #d4a843;
                --tf-gold-light: #e8c96d;
                --tf-gold-dark: #b8922f;
                --tf-white: #f5f5f5;
                --tf-gray: #a0a0b0;
                --tf-light: #d0d0dd;
                --tf-card-bg: #1e2a3a;
                --tf-border: #2a3a4e;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--tf-midnight);
                color: var(--tf-white);
                min-height: 100vh;
            }

            /* ==================== NAVBAR ==================== */
            .tf-navbar {
                position: fixed;
                top: 0; left: 0; right: 0;
                height: 64px;
                background: linear-gradient(90deg, var(--tf-navy) 0%, #0d1b2a 100%);
                border-bottom: 1px solid var(--tf-border);
                display: flex;
                align-items: center;
                padding: 0 2rem;
                z-index: 1000;
                gap: 1rem;
            }
            .tf-navbar-brand {
                font-size: 1.4rem;
                font-weight: 800;
                color: var(--tf-gold);
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-right: 2rem;
                flex-shrink: 0;
            }
            .tf-navbar-brand:hover { color: var(--tf-gold-light); }

            .tf-navbar-nav {
                display: flex;
                align-items: center;
                gap: 0.3rem;
                list-style: none;
                padding: 0;
                margin: 0;
                flex: 1;
            }
            .tf-navbar-nav a {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 1rem;
                color: var(--tf-gray);
                text-decoration: none;
                border-radius: 8px;
                font-weight: 500;
                font-size: 0.88rem;
                transition: all 0.2s;
                white-space: nowrap;
            }
            .tf-navbar-nav a:hover {
                background: rgba(212, 168, 67, 0.08);
                color: var(--tf-gold);
            }
            .tf-navbar-nav a.active {
                background: rgba(212, 168, 67, 0.15);
                color: var(--tf-gold);
                font-weight: 600;
            }
            .tf-navbar-nav a i { font-size: 0.9rem; }

            .tf-navbar-sep {
                width: 1px;
                height: 28px;
                background: var(--tf-border);
                margin: 0 0.5rem;
                flex-shrink: 0;
            }

            .tf-navbar-right {
                display: flex;
                align-items: center;
                gap: 1rem;
                margin-left: auto;
                flex-shrink: 0;
            }
            .tf-navbar-right .nav-user {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                color: var(--tf-white);
                font-size: 0.88rem;
            }
            .tf-navbar-right .tf-avatar-sm {
                width: 34px; height: 34px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight);
                display: flex; align-items: center; justify-content: center;
                font-weight: 700; font-size: 0.75rem;
                flex-shrink: 0;
            }
            .tf-navbar-right a.nav-logout {
                color: var(--tf-gray);
                text-decoration: none;
                font-size: 0.83rem;
                display: flex; align-items: center; gap: 0.3rem;
                transition: color 0.2s;
            }
            .tf-navbar-right a.nav-logout:hover { color: #e74c3c; }

            /* ==================== MAIN CONTENT ==================== */
            .tf-main-nb {
                margin-top: 64px;
                padding: 2rem;
                min-height: calc(100vh - 64px);
            }

            /* ==================== CARDS / WIDGETS ==================== */
            .tf-card {
                background: var(--tf-card-bg);
                border: 1px solid var(--tf-border);
                border-radius: 12px;
                padding: 1.5rem;
                margin-bottom: 1.5rem;
            }
            .tf-card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
                padding-bottom: 1rem;
                border-bottom: 1px solid var(--tf-border);
            }
            .tf-card-header h3 {
                font-size: 1.15rem;
                font-weight: 600;
                color: var(--tf-gold);
                margin: 0;
            }

            .tf-widget {
                background: var(--tf-card-bg);
                border: 1px solid var(--tf-border);
                border-radius: 12px;
                padding: 1.5rem;
                display: flex;
                align-items: center;
                gap: 1.2rem;
                transition: transform 0.2s, box-shadow 0.2s;
            }
            .tf-widget:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            }
            .tf-widget-icon {
                width: 55px; height: 55px;
                border-radius: 12px;
                display: flex; align-items: center; justify-content: center;
                font-size: 1.4rem; flex-shrink: 0;
            }
            .tf-widget-icon.gold { background: rgba(212, 168, 67, 0.15); color: var(--tf-gold); }
            .tf-widget-icon.blue { background: rgba(15, 52, 96, 0.4); color: #5dade2; }
            .tf-widget-icon.green { background: rgba(39, 174, 96, 0.15); color: #2ecc71; }
            .tf-widget-icon.red { background: rgba(192, 57, 43, 0.15); color: #e74c3c; }
            .tf-widget-icon.purple { background: rgba(142, 68, 173, 0.15); color: #9b59b6; }
            .tf-widget-info h3 { font-size: 1.8rem; font-weight: 700; color: var(--tf-white); margin: 0; line-height: 1; }
            .tf-widget-info p { font-size: 0.8rem; color: var(--tf-gray); margin: 0.2rem 0 0; }

            /* ==================== TABLE ==================== */
            .tf-table { width: 100%; border-collapse: separate; border-spacing: 0; }
            .tf-table thead th {
                background: var(--tf-navy);
                color: var(--tf-gold);
                padding: 0.9rem 1rem;
                font-size: 0.8rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-bottom: 2px solid var(--tf-gold-dark);
            }
            .tf-table tbody td {
                padding: 0.8rem 1rem;
                border-bottom: 1px solid var(--tf-border);
                color: var(--tf-white);
                font-size: 0.88rem;
                vertical-align: middle;
            }
            .tf-table tbody tr:hover { background: rgba(212, 168, 67, 0.04); }

            /* ==================== BADGES ==================== */
            .badge-role { padding: 0.35rem 0.8rem; border-radius: 20px; font-size: 0.72rem; font-weight: 600; }
            .badge-admin { background: rgba(212, 168, 67, 0.2); color: var(--tf-gold); }
            .badge-rh { background: rgba(15, 52, 96, 0.5); color: #5dade2; }
            .badge-candidat { background: rgba(39, 174, 96, 0.15); color: #2ecc71; }

            /* ==================== BUTTONS ==================== */
            .btn-gold {
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight); border: none; padding: 0.6rem 1.2rem;
                border-radius: 8px; font-weight: 600; font-size: 0.85rem;
                cursor: pointer; text-decoration: none;
                display: inline-flex; align-items: center; gap: 0.5rem;
                transition: all 0.2s;
            }
            .btn-gold:hover { filter: brightness(1.1); transform: translateY(-1px); color: var(--tf-midnight); }
            .btn-outline-gold {
                background: transparent; border: 1px solid var(--tf-gold);
                color: var(--tf-gold); padding: 0.6rem 1.2rem;
                border-radius: 8px; font-weight: 600; font-size: 0.85rem;
                cursor: pointer; text-decoration: none;
                display: inline-flex; align-items: center; gap: 0.5rem;
                transition: all 0.2s;
            }
            .btn-outline-gold:hover { background: rgba(212, 168, 67, 0.1); color: var(--tf-gold); }
            .btn-sm-tf { padding: 0.4rem 0.7rem; font-size: 0.78rem; }
            .btn-danger-tf {
                background: rgba(192, 57, 43, 0.2); border: 1px solid #c0392b;
                color: #e74c3c; padding: 0.4rem 0.7rem; border-radius: 8px;
                font-weight: 600; font-size: 0.78rem; cursor: pointer;
                display: inline-flex; align-items: center; gap: 0.4rem;
                transition: all 0.2s;
            }
            .btn-danger-tf:hover { background: rgba(192, 57, 43, 0.4); }

            /* ==================== FORMS ==================== */
            .tf-form-group { margin-bottom: 1.2rem; }
            .tf-label { display: block; color: var(--tf-gold); font-weight: 600; font-size: 0.85rem; margin-bottom: 0.4rem; }
            .tf-input {
                width: 100%; padding: 0.7rem 1rem;
                background: var(--tf-navy); border: 1px solid var(--tf-border);
                border-radius: 8px; color: var(--tf-white); font-size: 0.9rem;
                transition: border-color 0.2s;
            }
            .tf-input:focus { outline: none; border-color: var(--tf-gold); box-shadow: 0 0 0 2px rgba(212, 168, 67, 0.2); }
            .tf-input::placeholder { color: var(--tf-gray); }
            select.tf-input { appearance: auto; }

            /* ==================== SEARCH BAR ==================== */
            input.tf-search, select.tf-search {
                width: 100%; padding: 0.55rem 0.9rem;
                background: var(--tf-navy); border: 1px solid var(--tf-border);
                border-radius: 8px; color: var(--tf-white); font-size: 0.85rem;
            }
            input.tf-search:focus, select.tf-search:focus { border-color: var(--tf-gold); outline: none; }
            input.tf-search::placeholder { color: var(--tf-gray); }

            /* ==================== FLASH MESSAGES ==================== */
            .tf-flash {
                padding: 0.8rem 1.2rem; border-radius: 8px; margin-bottom: 1rem;
                display: flex; align-items: center; gap: 0.6rem; font-size: 0.88rem;
            }
            .tf-flash-success { background: rgba(39, 174, 96, 0.15); border: 1px solid rgba(39, 174, 96, 0.3); color: #2ecc71; }
            .tf-flash-warning { background: rgba(241, 196, 15, 0.15); border: 1px solid rgba(241, 196, 15, 0.3); color: #f1c40f; }
            .tf-flash-error, .tf-flash-danger { background: rgba(192, 57, 43, 0.15); border: 1px solid rgba(192, 57, 43, 0.3); color: #e74c3c; }

            /* ==================== AVATARS ==================== */
            .tf-avatar {
                width: 38px; height: 38px; border-radius: 50%;
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight);
                display: flex; align-items: center; justify-content: center;
                font-weight: 700; font-size: 0.8rem; flex-shrink: 0;
            }

            /* ==================== DETAIL LIST ==================== */
            .tf-detail-list { display: flex; flex-direction: column; gap: 0.6rem; }
            .tf-detail-item { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid var(--tf-border); }
            .tf-detail-label { color: var(--tf-gray); font-size: 0.8rem; font-weight: 500; }
            .tf-detail-value { color: var(--tf-white); font-size: 0.85rem; font-weight: 600; }

            /* ==================== QUICK ACTIONS ==================== */
            .tf-quick-action {
                display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
                padding: 1rem; background: var(--tf-navy); border: 1px solid var(--tf-border);
                border-radius: 10px; text-decoration: none; color: var(--tf-white);
                transition: all 0.2s; text-align: center;
            }
            .tf-quick-action:hover { border-color: var(--tf-gold); color: var(--tf-gold); transform: translateY(-2px); }
            .tf-quick-action i { font-size: 1.2rem; color: var(--tf-gold); }
            .tf-quick-action span { font-size: 0.78rem; font-weight: 500; }

            /* ==================== MODAL ==================== */
            .tf-modal-backdrop {
                position: fixed; top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(0, 0, 0, 0.7); display: none;
                align-items: center; justify-content: center; z-index: 9999;
            }
            .tf-modal-backdrop.show { display: flex; }
            .tf-modal-box {
                background: var(--tf-card-bg); border: 1px solid var(--tf-border);
                border-radius: 16px; padding: 2rem; max-width: 420px; width: 90%;
                text-align: center;
            }
            .tf-modal-icon { font-size: 2.5rem; margin-bottom: 1rem; }
            .tf-modal-icon.danger { color: #e74c3c; }
            .tf-modal-icon.warning { color: #f39c12; }
            .tf-modal-icon.success { color: #2ecc71; }
            .tf-modal-title { font-size: 1.2rem; font-weight: 700; color: var(--tf-white); margin-bottom: 0.5rem; }
            .tf-modal-text { font-size: 0.9rem; color: var(--tf-gray); margin-bottom: 1.5rem; line-height: 1.5; }
            .tf-modal-actions { display: flex; gap: 0.8rem; justify-content: center; }
            .btn-cancel {
                background: var(--tf-navy); border: 1px solid var(--tf-border);
                color: var(--tf-gray); padding: 0.6rem 1.5rem;
                border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem;
                display: inline-flex; align-items: center; gap: 0.4rem;
            }
            .btn-confirm-danger {
                background: linear-gradient(135deg, #c0392b, #e74c3c);
                color: white; border: none; padding: 0.6rem 1.5rem;
                border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem;
                display: inline-flex; align-items: center; gap: 0.4rem;
            }
            .btn-confirm-gold {
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight); border: none; padding: 0.6rem 1.5rem;
                border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem;
                display: inline-flex; align-items: center; gap: 0.4rem;
            }

            /* ==================== RESPONSIVE ==================== */
            @media (max-width: 992px) {
                .tf-navbar { padding: 0 1rem; }
                .tf-navbar-nav a { padding: 0.4rem 0.6rem; font-size: 0.82rem; }
            }

            /* ==================== DARK/LIGHT MODE ==================== */
            [data-theme="light"] {
                --tf-midnight: #f4f6fb;
                --tf-navy: #ffffff;
                --tf-dark-blue: #e8ecf4;
                --tf-white: #1a1a2e;
                --tf-gray: #5a5f7a;
                --tf-light: #8b90a5;
                --tf-card-bg: #ffffff;
                --tf-border: #e2e6ef;
            }
            [data-theme="light"] body { background: #f4f6fb; color: #1a1a2e; }
            [data-theme="light"] .tf-navbar { background: linear-gradient(90deg, #ffffff 0%, #f8f9fc 100%); border-bottom-color: #e2e6ef; }
            [data-theme="light"] .tf-navbar-nav a { color: #5a5f7a; }
            [data-theme="light"] .tf-navbar-nav a:hover { background: rgba(201,162,39,0.08); color: var(--tf-gold); }
            [data-theme="light"] .tf-navbar-nav a.active { background: rgba(201,162,39,0.12); color: var(--tf-gold); }
            [data-theme="light"] .tf-table thead th { background: #f0f2f8; color: #5a5f7a; }
            [data-theme="light"] .tf-table tbody td { color: #1a1a2e; border-bottom-color: #e2e6ef; }
            [data-theme="light"] .tf-table tbody tr:hover td { background: #f8f9fc; }
            [data-theme="light"] .tf-widget { background: #ffffff; border-color: #e2e6ef; }
            [data-theme="light"] .tf-search { background: #f0f2f8; border-color: #e2e6ef; color: #1a1a2e; }
            [data-theme="light"] .nav-user span { color: #1a1a2e; }
            [data-theme="light"] .nav-logout { color: #5a5f7a !important; }
            [data-theme="light"] .form-control, [data-theme="light"] .form-select { background: #ffffff; border-color: #e2e6ef; color: #1a1a2e; }

            .tf-theme-btn { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--tf-border); background: transparent; color: var(--tf-gray); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; transition: all 0.2s; }
            .tf-theme-btn:hover { background: rgba(212,168,67,0.1); color: var(--tf-gold); border-color: var(--tf-gold); transform: rotate(15deg); }

            /* ==================== LANGUAGE SWITCHER ==================== */
            .tf-lang-switcher { position: relative; display: inline-flex; }
            .tf-lang-btn { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--tf-border); background: transparent; color: var(--tf-gray); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; transition: all 0.2s; text-transform: uppercase; }
            .tf-lang-btn:hover { background: rgba(212,168,67,0.1); color: var(--tf-gold); border-color: var(--tf-gold); }
            .tf-lang-dropdown { position: absolute; top: calc(100% + 8px); right: 0; background: var(--tf-card-bg); border: 1px solid var(--tf-border); border-radius: 10px; padding: 0.4rem; min-width: 140px; box-shadow: 0 8px 25px rgba(0,0,0,0.3); display: none; z-index: 9999; }
            .tf-lang-dropdown.show { display: block; }
            .tf-lang-dropdown a { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.8rem; color: var(--tf-gray); text-decoration: none; border-radius: 6px; font-size: 0.85rem; transition: all 0.15s; }
            .tf-lang-dropdown a:hover { background: rgba(212,168,67,0.08); color: var(--tf-gold); }
            .tf-lang-dropdown a.active { color: var(--tf-gold); font-weight: 600; background: rgba(212,168,67,0.12); }
            .tf-lang-dropdown a .flag-icon { font-size: 1.1rem; }
        </style>
        <link rel="stylesheet" href="/css/cards.css">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {# ==================== NAVBAR ==================== #}
        <nav class="tf-navbar">
            <a href="{{ path('app_dashboard') }}" class="tf-navbar-brand">
                💼 TalentFlow
            </a>

            <ul class="tf-navbar-nav">
                <li>
                    <a href="{{ path('app_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="fas fa-tachometer-alt"></i> {{ 'nav.dashboard'|trans }}
                    </a>
                </li>

                {% if is_granted('ROLE_RH') %}
                <div class="tf-navbar-sep"></div>
                <li>
                    <a href="{{ path('offre_index') }}" class="{% if 'offre' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-clipboard-list"></i> {{ 'nav.offers_short'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_candidature_index') }}" class="{% if 'app_candidature' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-folder-open"></i> {{ 'nav.applications_short'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_entretien_index') }}" class="{% if 'app_entretien' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-calendar-check"></i> {{ 'nav.interviews_short'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_decision_finale_index') }}" class="{% if 'app_decision_finale' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-scale-balanced"></i> {{ 'nav.decisions_short'|trans }}
                    </a>
                </li>
                {% endif %}

                {% if is_granted('ROLE_CANDIDAT') and not is_granted('ROLE_RH') and not is_granted('ROLE_ADMIN') %}
                <div class="tf-navbar-sep"></div>
                <li>
                    <a href="{{ path('offre_index') }}" class="{% if 'offre' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-search"></i> {{ 'nav.offers_short'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_candidature_index') }}" class="{% if 'app_candidature' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-paper-plane"></i> {{ 'nav.my_applications'|trans }}
                    </a>
                </li>
                {% endif %}

                <div class="tf-navbar-sep"></div>
                <li>
                    <a href="{{ path('post_index') }}" class="{% if 'post' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-newspaper"></i> {{ 'nav.forum'|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ path('message_index') }}" class="{% if 'message' in app.request.attributes.get('_route') %}active{% endif %}" style="position:relative">
                        <i class="fas fa-paper-plane"></i> Messages
                        <span class="dm-unread-badge" style="display:none;position:absolute;top:6px;right:6px;min-width:16px;height:16px;line-height:16px;background:var(--tf-gold);color:var(--tf-midnight);font-size:0.6rem;font-weight:700;border-radius:50%;text-align:center;padding:0 3px"></span>
                    </a>
                </li>
            </ul>

            <div class="tf-navbar-right">
                {# Language switcher #}
                <div class="tf-lang-switcher">
                    <button class="tf-lang-btn" onclick="this.nextElementSibling.classList.toggle('show')" title="{{ 'language.switch'|trans }}">
                        {{ app.request.locale|upper }}
                    </button>
                    <div class="tf-lang-dropdown" id="langDropdownNb">
                        <a href="{{ path('app_switch_locale', {locale: 'fr'}) }}" class="{{ app.request.locale == 'fr' ? 'active' : '' }}">
                            <span class="flag-icon">🇫🇷</span> {{ 'language.fr'|trans }}
                        </a>
                        <a href="{{ path('app_switch_locale', {locale: 'en'}) }}" class="{{ app.request.locale == 'en' ? 'active' : '' }}">
                            <span class="flag-icon">🇬🇧</span> {{ 'language.en'|trans }}
                        </a>
                    </div>
                </div>
                <button class="tf-theme-btn" onclick="TFTheme.toggle()" aria-label="{{ 'theme.change'|trans }}" title="{{ 'theme.toggle'|trans }}">
                    <i class="fas fa-sun" id="theme-icon-sun"></i>
                    <i class="fas fa-moon" id="theme-icon-moon" style="display:none;"></i>
                </button>
                {% if app.user %}
                <div class="nav-user">
                    <div class="tf-avatar-sm">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                    <span>{{ app.user.fullName }}</span>
                    {% if app.user.entreprise %}
                    <small style="color: var(--tf-gray); font-size: 0.75rem;">| {{ app.user.entreprise.nom }}</small>
                    {% endif %}
                </div>
                <a href="{{ path('app_logout') }}" class="nav-logout">
                    <i class="fas fa-sign-out-alt"></i> {{ 'nav.logout'|trans }}
                </a>
                {% endif %}
            </div>
        </nav>

        {# ==================== MAIN CONTENT ==================== #}
        <main class="tf-main-nb">
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="tf-flash tf-flash-{{ label }}">
                        <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'warning' ? 'exclamation-triangle' : 'exclamation-circle') }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--tf-gold); margin-bottom: 1.5rem;">{% block page_title %}{% endblock %}</h1>

            {% block body %}{% endblock %}
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script>
        // ==================== CONFIRMATION MODAL SYSTEM ====================
        function showConfirmModal(options) {
            const old = document.getElementById('tfConfirmModal');
            if (old) old.remove();
            const iconClass = options.iconClass || 'danger';
            const icon = options.icon || 'fa-exclamation-triangle';
            const btnClass = options.btnClass || 'btn-confirm-danger';
            const modal = document.createElement('div');
            modal.id = 'tfConfirmModal';
            modal.className = 'tf-modal-backdrop show';
            modal.innerHTML = `
                <div class="tf-modal-box">
                    <div class="tf-modal-icon ${iconClass}"><i class="fas ${icon}"></i></div>
                    <div class="tf-modal-title">${options.title}</div>
                    <div class="tf-modal-text">${options.message}</div>
                    <div class="tf-modal-actions">
                        <button class="btn-cancel" onclick="closeConfirmModal()"><i class="fas fa-times"></i> {{ 'action.cancel'|trans }}</button>
                        <button class="${btnClass}" id="tfConfirmBtn"><i class="fas ${options.confirmIcon || icon}"></i> ${options.confirmText || '{{ 'action.confirm'|trans }}'}</button>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            modal.addEventListener('click', function(e) { if (e.target === modal) closeConfirmModal(); });
            document.addEventListener('keydown', function handler(e) { if (e.key === 'Escape') { closeConfirmModal(); document.removeEventListener('keydown', handler); } });
            document.getElementById('tfConfirmBtn').addEventListener('click', function() { closeConfirmModal(); if (options.onConfirm) options.onConfirm(); });
        }
        function closeConfirmModal() { const m = document.getElementById('tfConfirmModal'); if (m) m.remove(); }
        function confirmDelete(formEl, name) {
            showConfirmModal({
                title: TFi18n.modal_delete_title,
                message: `${TFi18n.modal_delete_msg} <strong style="color:#e74c3c">${name}</strong> ?<br><small style="color:#a0a0b0">${TFi18n.modal_delete_warning}</small>`,
                icon: 'fa-trash-alt', iconClass: 'danger', btnClass: 'btn-confirm-danger',
                confirmIcon: 'fa-trash', confirmText: TFi18n.yes_delete,
                onConfirm: function() { formEl.submit(); }
            });
        }
        function confirmFormSubmit(formEl, actionType, entityName) {
            entityName = entityName || '';
            const configs = {
                create: { title: TFi18n.modal_create_title, message: `${TFi18n.modal_create_msg} ${entityName} ?`, icon: 'fa-plus-circle', iconClass: 'success', confirmIcon: 'fa-check', confirmText: TFi18n.yes_create },
                edit: { title: TFi18n.modal_edit_title, message: `${TFi18n.modal_edit_msg} ${entityName} ?`, icon: 'fa-save', iconClass: 'warning', confirmIcon: 'fa-check', confirmText: TFi18n.yes_save }
            };
            const cfg = configs[actionType];
            showConfirmModal({ title: cfg.title, message: cfg.message, icon: cfg.icon, iconClass: cfg.iconClass, btnClass: 'btn-confirm-gold', confirmIcon: cfg.confirmIcon, confirmText: cfg.confirmText,
                onConfirm: function() { formEl.setAttribute('data-confirmed', 'true'); formEl.submit(); }
            });
        }
        </script>
        <script>
        // ==================== I18N JS VARIABLES ====================
        var TFi18n = {
            cancel: "{{ 'action.cancel'|trans|e('js') }}",
            confirm: "{{ 'action.confirm'|trans|e('js') }}",
            yes_delete: "{{ 'action.yes_delete'|trans|e('js') }}",
            yes_create: "{{ 'action.yes_create'|trans|e('js') }}",
            yes_save: "{{ 'action.yes_save'|trans|e('js') }}",
            modal_delete_title: "{{ 'modal.confirm_delete_title'|trans|e('js') }}",
            modal_delete_msg: "{{ 'modal.confirm_delete_msg'|trans|e('js') }}",
            modal_delete_warning: "{{ 'modal.confirm_delete_warning'|trans|e('js') }}",
            modal_create_title: "{{ 'modal.confirm_create_title'|trans|e('js') }}",
            modal_create_msg: "{{ 'modal.confirm_create_msg'|trans|e('js') }}",
            modal_create_warning: "{{ 'modal.confirm_create_warning'|trans|e('js') }}",
            modal_edit_title: "{{ 'modal.confirm_edit_title'|trans|e('js') }}",
            modal_edit_msg: "{{ 'modal.confirm_edit_msg'|trans|e('js') }}",
            modal_edit_warning: "{{ 'modal.confirm_edit_warning'|trans|e('js') }}"
        };
        // Close lang dropdown on outside click
        document.addEventListener('click', function(e) {
            var d = document.getElementById('langDropdownNb');
            if (d && !e.target.closest('.tf-lang-switcher')) d.classList.remove('show');
        });
        </script>
        <script>
        var TFTheme={toggle:function(){var c=document.documentElement.getAttribute('data-theme')||'dark';var n=c==='dark'?'light':'dark';localStorage.setItem('tf-theme',n);document.documentElement.setAttribute('data-theme',n);document.documentElement.classList.toggle('dark',n==='dark');TFTheme._icons();},_icons:function(){var t=document.documentElement.getAttribute('data-theme');var s=document.getElementById('theme-icon-sun');var m=document.getElementById('theme-icon-moon');if(s&&m){s.style.display=t==='dark'?'':'none';m.style.display=t==='dark'?'none':'';}}};document.addEventListener('DOMContentLoaded',function(){TFTheme._icons();});
        </script>
        {% block javascripts %}{% endblock %}
        {% include 'chatbot/_widget.html.twig' %}
    </body>
</html>
