{% extends 'base.html.twig' %}

{% block title %}{{ candidature.titrePoste }} - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-file-alt"></i> {{ candidature.titrePoste }}</h2>

<div class="tf-card">
    <div class="row g-4">
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Poste :</strong> {{ candidature.titrePoste }}</p>
            <p><strong style="color: var(--tf-gold);">Entreprise :</strong> {{ candidature.entreprise }}</p>
            <p><strong style="color: var(--tf-gold);">Type de contrat :</strong> <span class="badge" style="background: var(--tf-dark-blue);">{{ candidature.typeContrat }}</span></p>
            <p><strong style="color: var(--tf-gold);">Statut :</strong> <span class="badge bg-{{ candidature.statutBadgeClass }}">{{ candidature.statut }}</span></p>
            <p>
                <strong style="color: var(--tf-gold);">Matching score :</strong>
                <span class="badge" style="background: var(--tf-dark-blue);">{{ candidature.matchingScore is not null ? candidature.matchingScore ~ '%' : 'N/A' }}</span>
            </p>
            {% if candidature.matchingScore is not null %}
                <div class="progress" style="height: 10px; background: var(--tf-border); margin-top: -4px; margin-bottom: 8px;">
                    <div class="progress-bar" role="progressbar" style="width: {{ candidature.matchingScore }}%; background: linear-gradient(90deg, #d4a843, #2ecc71);"></div>
                </div>
            {% endif %}
            <p><strong style="color: var(--tf-gold);">Lieu :</strong> {{ candidature.lieu ?? '—' }}</p>
        </div>
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Date de candidature :</strong> {{ candidature.dateCandidature|date('d/m/Y') }}</p>
            <p><strong style="color: var(--tf-gold);">Date d'entretien :</strong> {{ candidature.dateEntretien ? candidature.dateEntretien|date('d/m/Y') : '—' }}</p>
            <p><strong style="color: var(--tf-gold);">Salaire souhaité :</strong> {{ candidature.salaireSouhaite ? candidature.salaireSouhaite ~ ' TND' : '—' }}</p>
            <p><strong style="color: var(--tf-gold);">Créée le :</strong> {{ candidature.createdAt|date('d/m/Y à H:i') }}</p>
            <p><strong style="color: var(--tf-gold);">Modifiée le :</strong> {{ candidature.updatedAt ? candidature.updatedAt|date('d/m/Y à H:i') : '—' }}</p>
            <p><strong style="color: var(--tf-gold);">Time-to-Hire :</strong> {{ timeToHireDays is not null ? timeToHireDays ~ ' jours' : '—' }}</p>
        </div>
    </div>

    <hr style="border-color: var(--tf-border);">
    <p><strong style="color: var(--tf-gold);">Transitions autorisées :</strong></p>
    <div class="d-flex flex-wrap gap-2">
        {% for transition in availableTransitions %}
            <form method="post" action="{{ path('app_candidature_transition', {id: candidature.id, transition: transition}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('candidature_transition_' ~ candidature.id ~ '_' ~ transition) }}">
                <button class="btn btn-sm btn-outline-warning" type="submit">{{ transition|replace({'_':' '})|title }}</button>
            </form>
        {% else %}
            <span style="color: var(--tf-gray);">Aucune transition possible depuis ce statut.</span>
        {% endfor %}
    </div>

    {% if candidature.description %}
    <hr style="border-color: var(--tf-border);">
    <p><strong style="color: var(--tf-gold);">Description :</strong></p>
    <p style="color: var(--tf-gray);">{{ candidature.description|nl2br }}</p>
    {% endif %}

    {% if candidature.notes %}
    <hr style="border-color: var(--tf-border);">
    <p><strong style="color: var(--tf-gold);">Notes :</strong></p>
    <p style="color: var(--tf-gray);">{{ candidature.notes|nl2br }}</p>
    {% endif %}
</div>

<div class="tf-card mt-4">
    <h5 style="color: var(--tf-gold);"><i class="fas fa-history"></i> Historique des statuts</h5>
    <hr style="border-color: var(--tf-border);">
    {% if statusHistory is not empty %}
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Transition</th>
                        <th>De</th>
                        <th>Vers</th>
                        <th>Par</th>
                    </tr>
                </thead>
                <tbody>
                {% for h in statusHistory %}
                    <tr>
                        <td>{{ h.changedAt ? h.changedAt|date('d/m/Y H:i') : '—' }}</td>
                        <td>{{ h.transitionName ?? '—' }}</td>
                        <td>{{ h.fromStatus ?? '—' }}</td>
                        <td><span class="badge bg-info">{{ h.toStatus }}</span></td>
                        <td>{{ h.changedBy ? h.changedBy.fullName : 'Système' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p style="color: var(--tf-gray); margin:0;">Aucun historique disponible.</p>
    {% endif %}
</div>

{# Pièces Jointes Section #}
<div class="tf-card mt-4">
    <h5 style="color: var(--tf-gold);"><i class="fas fa-paperclip"></i> Pièces Jointes</h5>
    <hr style="border-color: var(--tf-border);">

    {% if candidature.piecesJointes|length > 0 %}
    <div class="table-responsive mb-4">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--tf-gold);">
                    <th>Fichier</th>
                    <th>Type</th>
                    <th>Taille</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for pj in candidature.piecesJointes %}
                <tr>
                    <td><i class="fas fa-file"></i> {{ pj.nomFichier }}</td>
                    <td><span class="badge" style="background: var(--tf-dark-blue);">{{ pj.typeDocument }}</span></td>
                    <td>{{ pj.tailleFormatee }}</td>
                    <td>{{ pj.uploadedAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('app_piece_jointe_download', {id: pj.id}) }}" class="btn btn-sm btn-outline-light" title="Télécharger"><i class="fas fa-download"></i></a>
                            <form method="post" action="{{ path('app_piece_jointe_delete', {id: pj.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ pj.typeDocument|e('js') }}');" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_pj' ~ pj.id) }}">
                                <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <p style="color: var(--tf-gray); margin-bottom: 1rem;"><i class="fas fa-info-circle"></i> Aucune pièce jointe pour cette candidature.</p>
    {% endif %}

    {# Upload Form #}
    <div style="background: var(--tf-navy); border: 1px dashed var(--tf-border); border-radius: 8px; padding: 1.5rem;">
        <h6 style="color: var(--tf-gold);"><i class="fas fa-upload"></i> Ajouter une pièce jointe</h6>
        {{ form_start(pieceJointeForm, {'action': path('app_candidature_upload', {id: candidature.id}), 'attr': {'class': 'tf-form', 'enctype': 'multipart/form-data', 'onsubmit': "if(!this.dataset.confirmed){event.preventDefault(); confirmFormSubmit(this, 'create', 'cette pièce jointe');}"}}) }}
            <div class="row g-3">
                <div class="col-md-4">
                    {{ form_label(pieceJointeForm.typeDocument) }}
                    {{ form_widget(pieceJointeForm.typeDocument) }}
                    {{ form_errors(pieceJointeForm.typeDocument) }}
                </div>
                <div class="col-md-5">
                    {{ form_label(pieceJointeForm.fichier) }}
                    {{ form_widget(pieceJointeForm.fichier) }}
                    {{ form_errors(pieceJointeForm.fichier) }}
                    <small style="color: var(--tf-gray);">PDF, DOC, DOCX, JPG, PNG — max 5 Mo</small>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn-gold w-100"><i class="fas fa-upload"></i> Envoyer</button>
                </div>
            </div>
        {{ form_end(pieceJointeForm) }}
    </div>
</div>

<div class="d-flex gap-2 mt-3">
    <a href="{{ path('app_candidature_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
    <a href="{{ path('app_candidature_edit', {id: candidature.id}) }}" class="btn-gold"><i class="fas fa-edit"></i> Modifier</a>
    <a href="{{ path('app_entretien_new', {candidature: candidature.id}) }}" class="btn-gold" style="background: var(--tf-dark-blue);"><i class="fas fa-calendar-plus"></i> Planifier un entretien</a>
</div>
{% endblock %}
