{% extends 'base.html.twig' %}

{% block title %}Candidatures - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title mb-0"><i class="fas fa-file-alt"></i> Gestion des Candidatures</h2>
    <a href="{{ path('app_candidature_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle candidature</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon blue"><i class="fas fa-file-alt"></i></div>
            <div class="tf-widget-info">
                <h3>{{ candidatureStats.total }}</h3>
                <p>Total candidatures</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon green"><i class="fas fa-check-circle"></i></div>
            <div class="tf-widget-info">
                <h3>{{ candidatureStats.completeCount }}</h3>
                <p>Candidatures complètes</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon red"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="tf-widget-info">
                <h3>{{ candidatureStats.blockingCount }}</h3>
                <p>Candidatures bloquantes</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon gold"><i class="fas fa-star"></i></div>
            <div class="tf-widget-info">
                <h3>{{ candidatureStats.prioritaireCount }}</h3>
                <p>Prioritaires RH</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="tf-card" style="height: 100%;">
            <div class="tf-card-header">
                <h3><i class="fas fa-chart-pie"></i> Répartition des candidatures par statut</h3>
            </div>
            <div style="height: 300px;">
                {{ render_chart(statutChart) }}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tf-card" style="height: 100%;">
            <div class="tf-card-header">
                <h3><i class="fas fa-chart-pie"></i> Répartition par niveau de complétude</h3>
            </div>
            <div style="height: 300px;">
                {{ render_chart(completenessChart) }}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tf-card" style="height: 100%;">
            <div class="tf-card-header">
                <h3><i class="fas fa-chart-pie"></i> Répartition par priorité RH</h3>
            </div>
            <div style="height: 300px;">
                {{ render_chart(priorityChart) }}
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="tf-card">
            <div class="tf-card-header">
                <h3><i class="fas fa-chart-bar"></i> Évolution des candidatures</h3>
            </div>
            <div style="height: 320px;">
                {{ render_chart(evolutionChart) }}
            </div>
        </div>
    </div>
</div>

{# Search & Filter Bar #}
<div class="tf-card mb-4">
    <form method="get" action="{{ path('app_candidature_index') }}" class="row g-3 tf-form">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Rechercher poste, entreprise, lieu..." value="{{ search }}">
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="">-- Type de contrat --</option>
                {% for t in ['CDI', 'CDD', 'Stage', 'Alternance', 'Freelance'] %}
                    <option value="{{ t }}" {{ typeContrat == t ? 'selected' }}>{{ t }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <select name="statut" class="form-select">
                <option value="">-- Statut --</option>
                {% for s in ['En attente', 'Validée RH', 'Entretien', 'Acceptée', 'Refusée'] %}
                    <option value="{{ s }}" {{ statut == s ? 'selected' }}>{{ s }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
        </div>
    </form>
</div>

<div id="candidature-results">
    {% include 'candidature/_results.html.twig' with {
        candidatures: candidatures,
        completenessMap: completenessMap,
        priorityMap: priorityMap
    } %}
</div>

{% include 'candidature/_analysis_modal.html.twig' %}
{% include 'candidature/_openai_modal.html.twig' %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.tf-form');
    const results = document.getElementById('candidature-results');
    let debounceTimer;

    function updateBrowserUrl(queryString) {
        const target = "{{ path('app_candidature_index') }}" + (queryString ? '?' + queryString : '');
        window.history.replaceState({}, '', target);
    }

    function fetchCandidatures(url = null) {
        let endpoint;
        if (url) {
            endpoint = url;
        } else {
            // Filter change: always start from page 1 to avoid stale page state.
            const params = new URLSearchParams(new FormData(form));
            params.set('page', '1');
            endpoint = "{{ path('app_candidature_search') }}?" + params.toString();
        }
        fetch(endpoint, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => {
                results.innerHTML = html;
                const parsed = new URL(endpoint, window.location.origin);
                updateBrowserUrl(parsed.searchParams.toString());
            });
    }

    form.search && form.search.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(fetchCandidatures, 300);
    });

    form.querySelectorAll('select').forEach(sel => {
        sel.addEventListener('change', () => fetchCandidatures());
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        fetchCandidatures();
    });

    results.addEventListener('click', function(e) {
        const link = e.target.closest('.pagination a');
        if (!link) {
            return;
        }

        e.preventDefault();
        fetchCandidatures(link.getAttribute('href'));
    });
});
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'candidature/_analysis_modal_script.html.twig' %}
    {% include 'candidature/_openai_modal_script.html.twig' %}
{% endblock %}
