{% extends 'base.html.twig' %}

{% block title %}Candidatures - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title mb-0"><i class="fas fa-file-alt"></i> Gestion des Candidatures</h2>
    <a href="{{ path('app_candidature_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle candidature</a>
</div>

{# Search & Filter Bar #}
<div class="tf-card mb-4">
    <form method="get" action="{{ path('app_candidature_index') }}" class="row g-3 tf-form">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Rechercher poste, entreprise, lieu..." value="{{ search }}">
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="">-- Type de contrat --</option>
                {% for t in ['CDI', 'CDD', 'Stage', 'Alternance', 'Freelance'] %}
                    <option value="{{ t }}" {{ typeContrat == t ? 'selected' }}>{{ t }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <select name="statut" class="form-select">
                <option value="">-- Statut --</option>
                {% for s in ['En attente', 'Acceptée', 'Refusée', 'Entretien'] %}
                    <option value="{{ s }}" {{ statut == s ? 'selected' }}>{{ s }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
        </div>
    </form>
</div>

{# Table #}
<div class="tf-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--tf-gold);">
                    <th>
                        <a href="{{ path('app_candidature_index', {search: search, type: typeContrat, statut: statut, sort: 'titrePoste', dir: sortBy == 'titrePoste' and sortDir == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: var(--tf-gold); text-decoration: none;">
                            Poste <i class="fas fa-sort"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_candidature_index', {search: search, type: typeContrat, statut: statut, sort: 'entreprise', dir: sortBy == 'entreprise' and sortDir == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: var(--tf-gold); text-decoration: none;">
                            Entreprise <i class="fas fa-sort"></i>
                        </a>
                    </th>
                    <th>Type</th>
                    <th>Statut</th>
                    <th>
                        <a href="{{ path('app_candidature_index', {search: search, type: typeContrat, statut: statut, sort: 'dateCandidature', dir: sortBy == 'dateCandidature' and sortDir == 'ASC' ? 'DESC' : 'ASC'}) }}" style="color: var(--tf-gold); text-decoration: none;">
                            Date <i class="fas fa-sort"></i>
                        </a>
                    </th>
                    <th>Lieu</th>
                    <th><i class="fas fa-paperclip"></i> PJ</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for c in candidatures %}
                <tr>
                    <td><strong>{{ c.titrePoste }}</strong></td>
                    <td>{{ c.entreprise }}</td>
                    <td><span class="badge" style="background: var(--tf-dark-blue);">{{ c.typeContrat }}</span></td>
                    <td>
                        <span class="badge bg-{{ c.statutBadgeClass }}">{{ c.statut }}</span>
                    </td>
                    <td>{{ c.dateCandidature|date('d/m/Y') }}</td>
                    <td>{{ c.lieu ?? '—' }}</td>
                    <td>
                        {% if c.piecesJointes|length > 0 %}
                            <span class="badge" style="background: var(--tf-gold); color: var(--tf-midnight);">
                                <i class="fas fa-paperclip"></i> {{ c.piecesJointes|length }}
                            </span>
                        {% else %}
                            <span style="color: var(--tf-gray);">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('app_candidature_show', {id: c.id}) }}" class="btn btn-sm btn-outline-light" title="Voir"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('app_candidature_edit', {id: c.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('app_candidature_delete', {id: c.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ c.titrePoste|e('js') }}');" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                                <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center" style="color: var(--tf-gray); padding: 2rem;">
                        <i class="fas fa-inbox fa-2x"></i><br>Aucune candidature trouvée.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="mt-3" style="color: var(--tf-gray);">
        <small>{{ candidatures|length }} candidature(s) trouvée(s)</small>
    </div>
</div>
{% endblock %}
