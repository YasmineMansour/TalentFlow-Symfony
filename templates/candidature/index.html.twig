{% extends 'base.html.twig' %}

{% block title %}Candidatures - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title mb-0"><i class="fas fa-file-alt"></i> Gestion des Candidatures</h2>
    <a href="{{ path('app_candidature_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle candidature</a>
</div>

{# Search & Filter Bar #}
<div class="tf-card mb-4">
    <form method="get" action="{{ path('app_candidature_index') }}" class="row g-3 tf-form">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Rechercher poste, entreprise, lieu..." value="{{ search }}">
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="">-- Type de contrat --</option>
                {% for t in ['CDI', 'CDD', 'Stage', 'Alternance', 'Freelance'] %}
                    <option value="{{ t }}" {{ typeContrat == t ? 'selected' }}>{{ t }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <select name="statut" class="form-select">
                <option value="">-- Statut --</option>
                {% for s in ['En attente', 'Validée RH', 'Entretien', 'Acceptée', 'Refusée'] %}
                    <option value="{{ s }}" {{ statut == s ? 'selected' }}>{{ s }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
        </div>
    </form>
</div>

{# Cards Grid #}
<div class="tf-grid-cards" id="candidature-grid">
    {% for c in candidatures %}
    <div class="tf-item-card">
        <div class="tf-item-card-header">
            <div class="tf-item-card-title">
                <a href="{{ path('app_candidature_show', {id: c.id}) }}">{{ c.titrePoste }}</a>
            </div>
            <span class="badge bg-{{ c.statutBadgeClass }}" style="font-size:0.72rem; white-space:nowrap;">{{ c.statut }}</span>
        </div>
        <div class="tf-item-card-subtitle">
            <i class="fas fa-building"></i> {{ c.entreprise }}
        </div>
        <div class="tf-item-card-meta">
            <span><i class="fas fa-file-contract"></i> {{ c.typeContrat }}</span>
            <span><i class="fas fa-calendar"></i> {{ c.dateCandidature|date('d/m/Y') }}</span>
            <span><i class="fas fa-percentage"></i> Matching: {{ c.matchingScore is not null ? c.matchingScore ~ '%' : 'N/A' }}</span>
            {% if c.lieu %}<span><i class="fas fa-map-marker-alt"></i> {{ c.lieu }}</span>{% endif %}
            {% if c.salaireSouhaite %}<span><i class="fas fa-coins"></i> {{ c.salaireSouhaite }} TND</span>{% endif %}
        </div>
        <div class="tf-item-card-tags">
            <span class="tf-tag-sm tf-tag-gold">{{ c.typeContrat }}</span>
            {% if c.piecesJointes|length > 0 %}
                <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-paperclip"></i> {{ c.piecesJointes|length }} PJ</span>
            {% endif %}
            {% if c.cvFilename %}
                <span class="tf-tag-sm tf-tag-green"><i class="fas fa-file-pdf"></i> CV</span>
            {% endif %}
            {% if c.lettreMotivationFilename %}
                <span class="tf-tag-sm tf-tag-purple"><i class="fas fa-envelope-open-text"></i> Lettre</span>
            {% endif %}
        </div>
        {% if c.competences %}
        <div class="tf-item-card-body" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
            {{ c.competences }}
        </div>
        {% endif %}
        {% if completenessMap[c.id] is defined %}
            {% include 'candidature/_completeness_badge.html.twig' with {
                completenessScore: completenessMap[c.id].score,
                completenessLevel: completenessMap[c.id].level,
                completenessLabel: completenessMap[c.id].label
            } %}
        {% endif %}
        {% if priorityMap[c.id] is defined %}
            {% include 'candidature/_priority_badge.html.twig' with { prioritySummary: priorityMap[c.id] } %}
        {% endif %}
        <div class="tf-item-card-actions">
            <button
                type="button"
                class="btn btn-sm btn-outline-info"
                data-action="open-candidature-analysis"
                data-analysis-url="{{ path('api_candidature_analyse', {id: c.id}) }}"
                data-candidature-id="{{ c.id }}"
                data-candidature-title="{{ c.titrePoste }}"
            >
                <i class="fas fa-chart-bar"></i> Analyse
            </button>
            <button
                type="button"
                class="btn btn-sm btn-outline-primary"
                data-action="open-candidature-openai"
                data-openai-url="{{ path('api_candidature_ai_recommendation', {id: c.id}) }}"
                data-candidature-id="{{ c.id }}"
                data-candidature-title="{{ c.titrePoste }}"
            >
                <i class="fas fa-robot"></i> OpenAI
            </button>
            <a href="{{ path('app_candidature_show', {id: c.id}) }}" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i> Voir</a>
            <a href="{{ path('app_candidature_edit', {id: c.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Modifier</a>
            <form method="post" action="{{ path('app_candidature_delete', {id: c.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ c.titrePoste|e('js') }}');" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
            </form>
        </div>
    </div>
    {% else %}
    <div class="tf-card-empty">
        <i class="fas fa-inbox"></i>
        Aucune candidature trouvée.
    </div>
    {% endfor %}
</div>
<div class="mt-3" style="color: var(--tf-gray);">
    <small>{{ candidatures|length }} candidature(s) trouvée(s)</small>
</div>

{% include 'candidature/_analysis_modal.html.twig' %}
{% include 'candidature/_openai_modal.html.twig' %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.tf-form');
    const grid = document.getElementById('candidature-grid');
    let debounceTimer;

    function fetchCandidatures() {
        const params = new URLSearchParams(new FormData(form)).toString();
        fetch("{{ path('app_candidature_search') }}?" + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => { grid.innerHTML = html; });
    }

    form.search && form.search.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(fetchCandidatures, 300);
    });

    form.querySelectorAll('select').forEach(sel => {
        sel.addEventListener('change', fetchCandidatures);
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        fetchCandidatures();
    });
});
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'candidature/_analysis_modal_script.html.twig' %}
    {% include 'candidature/_openai_modal_script.html.twig' %}
{% endblock %}
