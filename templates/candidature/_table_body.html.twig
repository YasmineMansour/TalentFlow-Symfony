{% for c in candidatures %}
<div class="tf-item-card">
    <div class="tf-item-card-header">
        <div class="tf-item-card-title">
            <a href="{{ path('app_candidature_show', {id: c.id}) }}">{{ c.titrePoste }}</a>
        </div>
        <span class="badge bg-{{ c.statutBadgeClass }}" style="font-size:0.72rem; white-space:nowrap;">{{ c.statut }}</span>
    </div>
    <div class="tf-item-card-subtitle">
        <i class="fas fa-building"></i> {{ c.entreprise }}
    </div>
    <div class="tf-item-card-meta">
        <span><i class="fas fa-file-contract"></i> {{ c.typeContrat }}</span>
        <span><i class="fas fa-calendar"></i> {{ c.dateCandidature|date('d/m/Y') }}</span>
        <span><i class="fas fa-percentage"></i> Matching: {{ c.matchingScore is not null ? c.matchingScore ~ '%' : 'N/A' }}</span>
        {% if c.lieu %}<span><i class="fas fa-map-marker-alt"></i> {{ c.lieu }}</span>{% endif %}
        {% if c.salaireSouhaite %}<span><i class="fas fa-coins"></i> {{ c.salaireSouhaite }} TND</span>{% endif %}
    </div>
    <div class="tf-item-card-tags">
        <span class="tf-tag-sm tf-tag-gold">{{ c.typeContrat }}</span>
        {% if c.piecesJointes|length > 0 %}
            <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-paperclip"></i> {{ c.piecesJointes|length }} PJ</span>
        {% endif %}
        {% if c.cvFilename %}
            <span class="tf-tag-sm tf-tag-green"><i class="fas fa-file-pdf"></i> CV</span>
        {% endif %}
        {% if c.lettreMotivationFilename %}
            <span class="tf-tag-sm tf-tag-purple"><i class="fas fa-envelope-open-text"></i> Lettre</span>
        {% endif %}
    </div>
    {% if c.competences %}
    <div class="tf-item-card-body" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
        {{ c.competences }}
    </div>
    {% endif %}
    {% if completenessMap[c.id] is defined %}
        {% include 'candidature/_completeness_badge.html.twig' with {
            completenessScore: completenessMap[c.id].score,
            completenessLevel: completenessMap[c.id].level,
            completenessLabel: completenessMap[c.id].label
        } %}
    {% endif %}
    {% if priorityMap[c.id] is defined %}
        {% include 'candidature/_priority_badge.html.twig' with { prioritySummary: priorityMap[c.id] } %}
    {% endif %}
    <div class="tf-item-card-actions">
        <button
            type="button"
            class="btn btn-sm btn-outline-info"
            data-action="open-candidature-analysis"
            data-analysis-url="{{ path('api_candidature_analyse', {id: c.id}) }}"
            data-candidature-id="{{ c.id }}"
            data-candidature-title="{{ c.titrePoste }}"
        >
            <i class="fas fa-chart-bar"></i> Analyse
        </button>
        <button
            type="button"
            class="btn btn-sm btn-outline-primary"
            data-action="open-candidature-openai"
            data-openai-url="{{ path('api_candidature_ai_recommendation', {id: c.id}) }}"
            data-candidature-id="{{ c.id }}"
            data-candidature-title="{{ c.titrePoste }}"
        >
            <i class="fas fa-robot"></i> OpenAI
        </button>
        <a href="{{ path('app_candidature_show', {id: c.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i> Voir</a>
        <a href="{{ path('app_candidature_edit', {id: c.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Modifier</a>
        <form method="post" action="{{ path('app_candidature_delete', {id: c.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ c.titrePoste|e('js') }}');" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
            <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
        </form>
    </div>
</div>
{% else %}
<div class="tf-card-empty">
    <i class="fas fa-inbox"></i>
    Aucune candidature trouvée.
</div>
{% endfor %}
