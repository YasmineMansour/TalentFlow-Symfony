{% extends 'base.html.twig' %}

{% block title %}Modifier Offre - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-edit"></i> Modifier l'Offre #{{ offre.id }}</h2>

{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'tf-form', 'onsubmit': "if(!this.dataset.confirmed){event.preventDefault(); confirmFormSubmit(this, 'edit', 'cette offre');}"}}) }}
    <div class="tf-card">
        <div class="mb-3">
            {{ form_row(form.titre) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.description) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.localisation) }}
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.entreprise) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.categorie) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                {{ form_row(form.typeContrat) }}
            </div>
            <div class="col-md-4 mb-3">
                {{ form_row(form.modeTravail) }}
            </div>
            <div class="col-md-4 mb-3">
                {{ form_row(form.statut) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                {{ form_row(form.salaireMin) }}
            </div>
            <div class="col-md-4 mb-3">
                {{ form_row(form.salaireMax) }}
            </div>
            <div class="col-md-4 mb-3 d-flex align-items-end">
                {{ form_row(form.active) }}
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('offre_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
            <button type="submit" class="btn-gold"><i class="fas fa-save"></i> Enregistrer</button>
        </div>
    </div>
{{ form_end(form) }}
{% endblock %}
