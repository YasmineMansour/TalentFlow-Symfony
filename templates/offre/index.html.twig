{% extends 'base.html.twig' %}

{% block title %}Offres - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-briefcase"></i> Liste des Offres</h1>
    <a href="{{ path('offre_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle Offre
    </a>
</div>

<form method="get" action="{{ path('offre_index') }}" class="mb-4">
    <div class="card">
        <div class="card-body">
            {# Recherche par titre #}
            <div class="input-group mb-3">
                <input type="text" name="q" class="form-control" placeholder="Rechercher par titre..." value="{{ search }}">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="bi bi-search"></i> Rechercher
                </button>
                {% if search or categorieId or entrepriseId or tri != 'id' %}
                <a href="{{ path('offre_index') }}" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i> Réinitialiser
                </a>
                {% endif %}
            </div>

            <div class="row">
                {# Filtre par catégorie #}
                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-tag"></i> Catégorie</label>
                    <select name="categorie" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Toutes --</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' : '' }}>{{ cat.nom }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Filtre par entreprise #}
                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-building"></i> Entreprise</label>
                    <select name="entreprise" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Toutes --</option>
                        {% for ent in entreprises %}
                            <option value="{{ ent.id }}" {{ entrepriseId == ent.id ? 'selected' : '' }}>{{ ent.nom }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Tri #}
                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-sort-down"></i> Trier par</label>
                    <select name="tri" class="form-select" onchange="this.form.submit()">
                        <option value="id" {{ tri == 'id' ? 'selected' : '' }}>Date (par défaut)</option>
                        <option value="titre" {{ tri == 'titre' ? 'selected' : '' }}>Titre</option>
                        <option value="salaireMin" {{ tri == 'salaireMin' ? 'selected' : '' }}>Salaire min</option>
                        <option value="salaireMax" {{ tri == 'salaireMax' ? 'selected' : '' }}>Salaire max</option>
                    </select>
                </div>

                {# Ordre #}
                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-arrow-down-up"></i> Ordre</label>
                    <select name="ordre" class="form-select" onchange="this.form.submit()">
                        <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                        <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>Croissant</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</form>

{% if offreData is empty %}
    <div class="alert alert-info">Aucune offre trouvée.</div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Titre</th>
                <th>Entreprise</th>
                <th>Catégorie</th>
                <th>Localisation</th>
                <th>Contrat</th>
                <th>Salaire</th>
                <th>Statut</th>
                <th>Classement</th>
                <th>Cohérence</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for item in offreData %}
                <tr>
                    <td>{{ item.offre.id }}</td>
                    <td>
                        <a href="{{ path('offre_show', {id: item.offre.id}) }}">{{ item.offre.titre }}</a>
                        {% if not item.complete %}
                            <span class="badge bg-warning text-dark" title="Offre incomplète">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.offre.entreprise %}
                            <a href="{{ path('entreprise_show', {id: item.offre.entreprise.id}) }}">{{ item.offre.entreprise.nom }}</a>
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.offre.categorie %}
                            <a href="{{ path('categorie_show', {id: item.offre.categorie.id}) }}">{{ item.offre.categorie.nom }}</a>
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td>{{ item.offre.localisation ?? '-' }}</td>
                    <td><span class="badge bg-info text-dark">{{ item.offre.typeContrat }}</span></td>
                    <td>{{ item.offre.salaireRange }}</td>
                    <td>
                        {% if item.offre.statut == 'PUBLISHED' %}
                            <span class="badge bg-success">Publiée</span>
                        {% elseif item.offre.statut == 'DRAFT' %}
                            <span class="badge bg-secondary">Brouillon</span>
                        {% else %}
                            <span class="badge bg-danger">Fermée</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.classement == 'Or' %}
                            <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill"></i> Or</span>
                        {% elseif item.classement == 'Argent' %}
                            <span class="badge bg-secondary"><i class="bi bi-trophy"></i> Argent</span>
                        {% elseif item.classement == 'Bronze' %}
                            <span class="badge" style="background-color:#cd7f32;color:#fff;"><i class="bi bi-trophy"></i> Bronze</span>
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.coherence == 'Cohérent' %}
                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> {{ item.coherence }}</span>
                        {% elseif item.coherence == 'Incohérent' %}
                            <span class="text-danger"><i class="bi bi-x-circle-fill"></i> {{ item.coherence }}</span>
                        {% else %}
                            <span class="text-muted">{{ item.coherence }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('offre_edit', {id: item.offre.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('offre_delete', {id: item.offre.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette offre ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.offre.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
