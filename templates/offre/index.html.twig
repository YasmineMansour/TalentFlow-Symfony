{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title mb-0"><i class="fas fa-briefcase"></i> Gestion des Offres d'emploi</h2>
    {% if is_granted('ROLE_RH') %}
    <a href="{{ path('offre_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle offre</a>
    {% endif %}
</div>

{# Search & Filter Bar #}
<div class="tf-card mb-4">
    <form method="get" action="{{ path('offre_index') }}" class="tf-form">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" name="q" class="form-control" placeholder="Rechercher par titre..." value="{{ search }}">
            </div>
            <div class="col-md-2">
                <select name="categorie" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Catégorie --</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' }}>{{ cat.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="entreprise" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Entreprise --</option>
                    {% for ent in entreprises %}
                        <option value="{{ ent.id }}" {{ entrepriseId == ent.id ? 'selected' }}>{{ ent.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="tri" class="form-select" onchange="this.form.submit()">
                    <option value="id" {{ tri == 'id' ? 'selected' }}>Date</option>
                    <option value="titre" {{ tri == 'titre' ? 'selected' }}>Titre</option>
                    <option value="salaireMin" {{ tri == 'salaireMin' ? 'selected' }}>Salaire min</option>
                    <option value="salaireMax" {{ tri == 'salaireMax' ? 'selected' }}>Salaire max</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
            </div>
        </div>
        {% if search or categorieId or entrepriseId or tri != 'id' %}
        <div class="mt-2">
            <a href="{{ path('offre_index') }}" style="color: #e07070; font-size: 0.85rem;"><i class="fas fa-times"></i> Réinitialiser les filtres</a>
        </div>
        {% endif %}
    </form>
</div>

{# Table #}
<div class="tf-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--tf-gold);">
                    <th>#</th>
                    <th>Titre</th>
                    <th>Entreprise</th>
                    <th>Catégorie</th>
                    <th>Localisation</th>
                    <th>Contrat</th>
                    <th>Salaire</th>
                    <th>Statut</th>
                    <th>Classement</th>
                    <th>Cohérence</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in offreData %}
                <tr>
                    <td>{{ item.offre.id }}</td>
                    <td>
                        <a href="{{ path('offre_show', {id: item.offre.id}) }}" style="color: var(--tf-gold); text-decoration: none; font-weight: 600;">{{ item.offre.titre }}</a>
                        {% if not item.complete %}
                            <span class="badge bg-warning text-dark ms-1" title="Incomplète"><i class="fas fa-exclamation-triangle"></i></span>
                        {% endif %}
                    </td>
                    <td>{{ item.offre.entreprise ? item.offre.entreprise.nom : '—' }}</td>
                    <td>{{ item.offre.categorie ? item.offre.categorie.nom : '—' }}</td>
                    <td>{{ item.offre.localisation ?? '—' }}</td>
                    <td><span class="badge" style="background: var(--tf-dark-blue);">{{ item.offre.typeContrat }}</span></td>
                    <td>{{ item.offre.salaireRange }}</td>
                    <td>
                        {% if item.offre.statut == 'PUBLISHED' %}
                            <span class="badge bg-success">Publiée</span>
                        {% elseif item.offre.statut == 'DRAFT' %}
                            <span class="badge bg-secondary">Brouillon</span>
                        {% else %}
                            <span class="badge bg-danger">Fermée</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.classement == 'Or' %}
                            <span class="badge bg-warning text-dark"><i class="fas fa-trophy"></i> Or</span>
                        {% elseif item.classement == 'Argent' %}
                            <span class="badge bg-secondary"><i class="fas fa-trophy"></i> Argent</span>
                        {% elseif item.classement == 'Bronze' %}
                            <span class="badge" style="background:#cd7f32;color:#fff;"><i class="fas fa-trophy"></i> Bronze</span>
                        {% else %}
                            <span style="color: var(--tf-gray);">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.coherence == 'Cohérent' %}
                            <span style="color: #2ecc71;"><i class="fas fa-check-circle"></i> {{ item.coherence }}</span>
                        {% elseif item.coherence == 'Incohérent' %}
                            <span style="color: #e74c3c;"><i class="fas fa-times-circle"></i> {{ item.coherence }}</span>
                        {% else %}
                            <span style="color: var(--tf-gray);">{{ item.coherence }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('offre_show', {id: item.offre.id}) }}" class="btn btn-sm btn-outline-light" title="Voir"><i class="fas fa-eye"></i></a>
                            {% if is_granted('ROLE_RH') %}
                            <a href="{{ path('offre_edit', {id: item.offre.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('offre_delete', {id: item.offre.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.offre.titre|e('js') }}');" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.offre.id) }}">
                                <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="11" class="text-center" style="color: var(--tf-gray); padding: 2rem;">
                        <i class="fas fa-inbox fa-2x"></i><br>Aucune offre trouvée.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="mt-3" style="color: var(--tf-gray);">
        <small>{{ offreData|length }} offre(s) trouvée(s)</small>
    </div>
</div>
{% endblock %}
