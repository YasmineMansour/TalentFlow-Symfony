{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title mb-0"><i class="fas fa-briefcase"></i> Gestion des Offres d'emploi</h2>
    {% if is_granted('ROLE_RH') %}
    <a href="{{ path('offre_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle offre</a>
    {% endif %}
</div>

{# Search & Filter Bar #}
<div class="tf-card mb-4">
    <form method="get" action="{{ path('offre_index') }}" class="tf-form">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" name="q" class="form-control" placeholder="Rechercher par titre..." value="{{ search }}">
            </div>
            <div class="col-md-2">
                <select name="categorie" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Catégorie --</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' }}>{{ cat.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="entreprise" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Entreprise --</option>
                    {% for ent in entreprises %}
                        <option value="{{ ent.id }}" {{ entrepriseId == ent.id ? 'selected' }}>{{ ent.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="tri" class="form-select" onchange="this.form.submit()">
                    <option value="id" {{ tri == 'id' ? 'selected' }}>Date</option>
                    <option value="titre" {{ tri == 'titre' ? 'selected' }}>Titre</option>
                    <option value="salaireMin" {{ tri == 'salaireMin' ? 'selected' }}>Salaire min</option>
                    <option value="salaireMax" {{ tri == 'salaireMax' ? 'selected' }}>Salaire max</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
            </div>
        </div>
        {% if search or categorieId or entrepriseId or tri != 'id' %}
        <div class="mt-2">
            <a href="{{ path('offre_index') }}" style="color: #e07070; font-size: 0.85rem;"><i class="fas fa-times"></i> Réinitialiser les filtres</a>
        </div>
        {% endif %}
    </form>
</div>

{# Cards Grid #}
<style>
    .offre-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.25rem; }
    .offre-card { background: var(--tf-card-bg, #151b2e); border: 1px solid var(--tf-border, rgba(255,255,255,0.06)); border-radius: 14px; padding: 1.5rem; transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; display: flex; flex-direction: column; position: relative; }
    .offre-card:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0,0,0,0.25); border-color: var(--tf-gold); }
    .offre-card-title { font-size: 1.1rem; font-weight: 700; color: var(--tf-gold); margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.5rem; }
    .offre-card-company { font-size: 0.88rem; color: var(--tf-gray, #8892b0); margin-bottom: 0.75rem; }
    .offre-card-company i { margin-right: 0.3rem; }
    .offre-card-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.75rem; font-size: 0.82rem; color: var(--tf-gray, #8892b0); }
    .offre-card-meta i { color: var(--tf-gold); margin-right: 0.25rem; }
    .offre-card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
    .offre-tag { padding: 0.2rem 0.65rem; border-radius: 20px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; }
    .offre-tag-contrat { background: rgba(212,168,67,0.15); color: var(--tf-gold); }
    .offre-tag-statut-pub { background: rgba(46,204,113,0.15); color: #2ecc71; }
    .offre-tag-statut-draft { background: rgba(149,165,166,0.15); color: #95a5a6; }
    .offre-tag-statut-closed { background: rgba(231,76,60,0.15); color: #e74c3c; }
    .offre-tag-or { background: rgba(255,193,7,0.18); color: #ffc107; }
    .offre-tag-argent { background: rgba(192,192,192,0.18); color: #c0c0c0; }
    .offre-tag-bronze { background: rgba(205,127,50,0.18); color: #cd7f32; }
    .offre-tag-coherent { background: rgba(46,204,113,0.12); color: #2ecc71; }
    .offre-tag-incoherent { background: rgba(231,76,60,0.12); color: #e74c3c; }
    .offre-card-actions { display: flex; gap: 0.5rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--tf-border, rgba(255,255,255,0.06)); }
    .offre-card-actions .btn { font-size: 0.78rem; padding: 0.3rem 0.7rem; border-radius: 8px; }
    .offre-empty { grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--tf-gray); }
    @media (max-width: 768px) { .offre-grid { grid-template-columns: 1fr; } }
</style>

<div class="offre-grid" id="offre-grid">
    {% for item in offreData %}
    <div class="offre-card">
        <div class="offre-card-title">
            <a href="{{ path('offre_show', {id: item.offre.id}) }}" style="color: var(--tf-gold); text-decoration: none;">{{ item.offre.titre }}</a>
            {% if not item.complete %}
                <span class="badge bg-warning text-dark" title="Incomplète" style="font-size:0.65rem;"><i class="fas fa-exclamation-triangle"></i></span>
            {% endif %}
        </div>
        <div class="offre-card-company">
            {% if item.offre.entreprise and item.offre.entreprise.logo %}
                <img src="{{ asset('uploads/logos/' ~ item.offre.entreprise.logo) }}" alt="" style="width:20px;height:20px;border-radius:4px;object-fit:cover;vertical-align:middle;margin-right:4px;">
            {% else %}
                <i class="fas fa-building"></i>
            {% endif %}
            {{ item.offre.entreprise ? item.offre.entreprise.nom : '—' }}
        </div>
        <div class="offre-card-meta">
            <span><i class="fas fa-map-marker-alt"></i> {{ item.offre.localisation ?? '—' }} <span class="country-flag-inline" data-localisation="{{ item.offre.localisation|default('') }}"></span></span>
            <span><i class="fas fa-file-contract"></i> {{ item.offre.typeContrat }}</span>
            {% if item.offre.salaireMin or item.offre.salaireMax %}
            <span><i class="fas fa-coins"></i> {{ item.offre.salaireRange }}</span>
            {% endif %}
        </div>
        <div class="offre-card-tags">
            <span class="offre-tag offre-tag-contrat">{{ item.offre.typeContrat }}</span>
            {% if item.offre.statut == 'PUBLISHED' %}
                <span class="offre-tag offre-tag-statut-pub">Publiée</span>
            {% elseif item.offre.statut == 'DRAFT' %}
                <span class="offre-tag offre-tag-statut-draft">Brouillon</span>
            {% else %}
                <span class="offre-tag offre-tag-statut-closed">Fermée</span>
            {% endif %}
            {% if item.classement == 'Or' %}
                <span class="offre-tag offre-tag-or"><i class="fas fa-trophy"></i> Or</span>
            {% elseif item.classement == 'Argent' %}
                <span class="offre-tag offre-tag-argent"><i class="fas fa-trophy"></i> Argent</span>
            {% elseif item.classement == 'Bronze' %}
                <span class="offre-tag offre-tag-bronze"><i class="fas fa-trophy"></i> Bronze</span>
            {% endif %}
            {% if item.coherence == 'Cohérent' %}
                <span class="offre-tag offre-tag-coherent"><i class="fas fa-check-circle"></i> Cohérent</span>
            {% elseif item.coherence == 'Incohérent' %}
                <span class="offre-tag offre-tag-incoherent"><i class="fas fa-times-circle"></i> Incohérent</span>
            {% endif %}
            {% if item.offre.categorie %}
                <span class="offre-tag" style="background:rgba(255,165,0,0.12); color:#ffa500;">{{ item.offre.categorie.nom }}</span>
            {% endif %}
        </div>
        {% if item.offre.description is defined and item.offre.description %}
        <p style="color: var(--tf-gray); font-size: 0.83rem; line-height: 1.5; margin-bottom: 0.75rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            {{ item.offre.description|striptags|slice(0, 150) }}{{ item.offre.description|length > 150 ? '...' }}
        </p>
        {% endif %}
        <div class="offre-card-actions">
            <a href="{{ path('offre_show', {id: item.offre.id}) }}" class="btn btn-sm btn-outline-light" title="Voir"><i class="fas fa-eye"></i> Voir</a>
            {% if is_granted('ROLE_RH') %}
            <a href="{{ path('offre_edit', {id: item.offre.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="fas fa-edit"></i> Modifier</a>
            <form method="post" action="{{ path('offre_delete', {id: item.offre.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.offre.titre|e('js') }}');" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.offre.id) }}">
                <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
            </form>
            {% endif %}
        </div>
    </div>
    {% else %}
    <div class="offre-empty">
        <i class="fas fa-inbox fa-2x" style="opacity:0.4;"></i><br>
        Aucune offre trouvée.
    </div>
    {% endfor %}
</div>
<div class="mt-3" style="color: var(--tf-gray);">
    <small>{{ offreData|length }} offre(s) trouvée(s)</small>
</div>
<script>
// Recherche AJAX offres
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.tf-form');
    const grid = document.getElementById('offre-grid');
    let debounceTimer;

    function fetchOffers() {
        const params = new URLSearchParams(new FormData(form)).toString();
        fetch("{{ path('offre_search') }}?" + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => {
                grid.innerHTML = html;
            });
    }

    // Déclenche sur saisie texte (avec debounce)
    form.q && form.q.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(fetchOffers, 300);
    });

    // Déclenche sur changement de select
    form.querySelectorAll('select').forEach(sel => {
        sel.addEventListener('change', fetchOffers);
    });

    // Empêche le submit classique
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        fetchOffers();
    });
});

// Auto-detect country flags
(function() {
    document.querySelectorAll('.country-flag-inline').forEach(function(el) {
        const loc = el.dataset.localisation;
        if (!loc) return;
        fetch('/api/country/detect?localisation=' + encodeURIComponent(loc))
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(data => { el.textContent = data.flag; el.title = data.name; })
            .catch(() => {});
    });
})();
</script>
{% endblock %}
