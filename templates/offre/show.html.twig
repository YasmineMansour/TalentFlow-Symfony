{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-briefcase"></i> {{ offre.titre }}</h2>

<div class="tf-card">
    {% if is_granted('ROLE_CANDIDAT') %}
        <div class="mb-3 text-end">
            <a href="{{ path('app_candidature_new', { offre: offre.id }) }}" class="btn btn-gold">
                <i class="fas fa-paper-plane"></i> Postuler à cette offre
            </a>
        </div>
    {% endif %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span style="color: var(--tf-gray); font-size: 0.85rem;">Offre #{{ offre.id }}</span>
        {% if not complete %}
            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Incomplète</span>
        {% else %}
            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Complète</span>
        {% endif %}
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Description :</strong></p>
            <p style="color: var(--tf-gray);">{{ offre.description ?? 'Non renseignée' }}</p>
            <p><strong style="color: var(--tf-gold);">Localisation :</strong> {{ offre.localisation ?? 'Non renseignée' }} <span id="country-flag-offre"></span></p>
            <div id="country-info-offre" style="display:none; margin-top: 0.5rem; margin-bottom: 0.5rem; padding: 0.75rem; background: rgba(212,168,67,0.06); border: 1px solid var(--tf-border); border-radius: 10px;">
                <div style="display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;">
                    <span id="offre-country-flag-big" style="font-size: 2rem;"></span>
                    <div>
                        <div style="color: var(--tf-gold); font-weight: 600;" id="offre-country-name"></div>
                        <div style="color: var(--tf-gray); font-size: 0.82rem;">
                            <span><i class="fas fa-coins"></i> <span id="offre-country-currency"></span></span> &nbsp;
                            <span><i class="fas fa-globe"></i> <span id="offre-country-code"></span></span>
                        </div>
                    </div>
                </div>
            </div>
            <p><strong style="color: var(--tf-gold);">Entreprise :</strong>
                {% if offre.entreprise %}
                    {% if offre.entreprise.logo %}<img src="{{ asset('uploads/logos/' ~ offre.entreprise.logo) }}" alt="" style="width:22px;height:22px;border-radius:5px;object-fit:cover;vertical-align:middle;margin-right:4px;">{% endif %}
                    {{ offre.entreprise.nom }}
                {% else %}
                    Non renseignée
                {% endif %}
            </p>
            <p><strong style="color: var(--tf-gold);">Catégorie :</strong> {{ offre.categorie ? offre.categorie.nom : 'Non renseignée' }}</p>
        </div>
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Type de contrat :</strong> <span class="badge" style="background: var(--tf-dark-blue);">{{ offre.typeContrat }}</span></p>
            <p><strong style="color: var(--tf-gold);">Mode de travail :</strong> {{ offre.modeTravail }}</p>
            <p><strong style="color: var(--tf-gold);">Statut :</strong>
                {% if offre.statut == 'PUBLISHED' %}
                    <span class="badge bg-success">Publiée</span>
                {% elseif offre.statut == 'DRAFT' %}
                    <span class="badge bg-secondary">Brouillon</span>
                {% else %}
                    <span class="badge bg-danger">Fermée</span>
                {% endif %}
            </p>
            <p><strong style="color: var(--tf-gold);">Salaire :</strong> {{ offre.salaireRange }}</p>

            {# --- Conversion Multi-Devises --- #}
            {% if offre.salaireMin or offre.salaireMax %}
            <div id="currency-converter" class="mt-2 p-3" style="background: var(--tf-dark-blue, #1a1a2e); border: 1px solid var(--tf-border, #333); border-radius: 10px;">
                <label style="color: var(--tf-gold); font-weight: 600; font-size: 0.9rem;">
                    <i class="fas fa-exchange-alt"></i> Convertir en :
                </label>
                <select id="currency-select" class="form-select form-select-sm mt-1" style="max-width: 250px; background: #16213e; color: #fff; border-color: var(--tf-border, #333);">
                    <option value="">-- Choisir une devise --</option>
                </select>
                <div id="currency-result" class="mt-2" style="display:none;">
                    <span id="converted-salary" style="color: #2ecc71; font-weight: 700; font-size: 1.05rem;"></span>
                    <br>
                    <small id="currency-rate-info" style="color: var(--tf-gray, #aaa);"></small>
                </div>
            </div>
            <script>
            (function() {
                const salaireMin = {{ offre.salaireMin ?? 'null' }};
                const salaireMax = {{ offre.salaireMax ?? 'null' }};
                const select = document.getElementById('currency-select');
                const resultDiv = document.getElementById('currency-result');
                const convertedEl = document.getElementById('converted-salary');
                const rateInfoEl = document.getElementById('currency-rate-info');

                fetch('/api/currency/rates')
                    .then(r => r.json())
                    .then(data => {
                        Object.entries(data.currencies).forEach(([code, label]) => {
                            const opt = document.createElement('option');
                            opt.value = code;
                            opt.textContent = code + ' - ' + label;
                            select.appendChild(opt);
                        });
                    });

                select.addEventListener('change', function() {
                    if (!this.value) { resultDiv.style.display = 'none'; return; }
                    const params = new URLSearchParams({ to: this.value });
                    if (salaireMin !== null) params.set('min', salaireMin);
                    if (salaireMax !== null) params.set('max', salaireMax);

                    fetch('/api/currency/convert-range?' + params)
                        .then(r => r.json())
                        .then(data => {
                            if (data.error) { convertedEl.textContent = data.error; rateInfoEl.textContent = ''; }
                            else {
                                let text = '';
                                if (data.min !== null && data.max !== null) {
                                    text = data.min.toLocaleString('fr-FR') + ' – ' + data.max.toLocaleString('fr-FR') + ' ' + data.currency;
                                } else if (data.max !== null) {
                                    text = data.max.toLocaleString('fr-FR') + ' ' + data.currency;
                                } else {
                                    text = data.min.toLocaleString('fr-FR') + ' ' + data.currency;
                                }
                                convertedEl.textContent = text;
                                rateInfoEl.textContent = 'Taux : 1 DT = ' + data.rate + ' ' + data.currency +
                                    (data.source === 'api' ? ' (taux réel)' : ' (taux indicatif)');
                            }
                            resultDiv.style.display = 'block';
                        });
                });
            })();
            </script>
            {% endif %}
            {# --- Fin Conversion --- #}

            <p><strong style="color: var(--tf-gold);">Active :</strong> {{ offre.active ? 'Oui' : 'Non' }}</p>
        </div>
    </div>

    {% if offre.localisation %}
    <hr style="border-color: var(--tf-border);">
    <div>
        <p><strong style="color: var(--tf-gold);"><i class="fas fa-map-marked-alt"></i> Carte du lieu</strong></p>
        <div style="border: 1px solid var(--tf-border); border-radius: 12px; overflow: hidden; min-height: 320px;">
            <iframe
                src="https://www.google.com/maps?q={{ (offre.localisation ~ ', Tunisie')|url_encode }}&output=embed"
                style="width:100%; height:320px; border:0;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Carte de localisation de l'offre">
            </iframe>
        </div>
        <small style="color: var(--tf-gray); display:block; margin-top: 8px;">
            Astuce: la carte utilise l'adresse saisie dans le champ localisation.
        </small>
    </div>
    {% endif %}

    <hr style="border-color: var(--tf-border);">

    <div class="row g-4">
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Classement :</strong>
                {% if classement == 'Or' %}
                    <span class="badge bg-warning text-dark"><i class="fas fa-trophy"></i> Or</span>
                {% elseif classement == 'Argent' %}
                    <span class="badge bg-secondary"><i class="fas fa-trophy"></i> Argent</span>
                {% elseif classement == 'Bronze' %}
                    <span class="badge" style="background:#cd7f32;color:#fff;"><i class="fas fa-trophy"></i> Bronze</span>
                {% else %}
                    <span style="color: var(--tf-gray);">Non classé</span>
                {% endif %}
            </p>
        </div>
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Cohérence salariale :</strong>
                {% if coherence == 'Cohérent' %}
                    <span style="color: #2ecc71;"><i class="fas fa-check-circle"></i> {{ coherence }}</span>
                {% elseif coherence == 'Incohérent' %}
                    <span style="color: #e74c3c;"><i class="fas fa-times-circle"></i> {{ coherence }}</span>
                {% else %}
                    <span style="color: var(--tf-gray);">{{ coherence }}</span>
                {% endif %}
            </p>
        </div>
    </div>
</div>

{# Avantages #}
<div class="tf-card mt-4">
    <h5 style="color: var(--tf-gold);"><i class="fas fa-gift"></i> Avantages ({{ offre.avantages|length }})</h5>
    <hr style="border-color: var(--tf-border);">
    {% if offre.avantages is empty %}
        <p style="color: var(--tf-gray);"><i class="fas fa-info-circle"></i> Aucun avantage lié à cette offre.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover tf-table">
                <thead>
                    <tr style="color: var(--tf-gold);">
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for av in offre.avantages %}
                    <tr>
                        <td><strong>{{ av.nom }}</strong></td>
                        <td>
                            {% if av.type == 'Financier' %}
                                <span class="tf-tag-sm tf-tag-green">{{ av.type }}</span>
                            {% elseif av.type == 'Bien-être' %}
                                <span class="tf-tag-sm tf-tag-purple">{{ av.type }}</span>
                            {% elseif av.type == 'Matériel' %}
                                <span class="tf-tag-sm tf-tag-blue">{{ av.type }}</span>
                            {% else %}
                                <span class="tf-tag-sm tf-tag-gray">{{ av.type }}</span>
                            {% endif %}
                        </td>
                        <td style="color: var(--tf-gray);">{{ av.description ?? '—' }}</td>
                        <td>
                            <a href="{{ path('avantage_edit', {id: av.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<div class="d-flex gap-2 mt-3">
    <a href="{{ path('offre_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
    {% if is_granted('ROLE_RH') %}
    <a href="{{ path('offre_edit', {id: offre.id}) }}" class="btn-gold"><i class="fas fa-edit"></i> Modifier</a>
    <form method="post" action="{{ path('offre_delete', {id: offre.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, '{{ offre.titre|e('js') }}');" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ offre.id) }}">
        <button class="btn-danger-tf"><i class="fas fa-trash"></i> Supprimer</button>
    </form>
    {% endif %}
</div>

{% if offre.localisation %}
<script>
(function() {
    fetch('/api/country/detect?localisation=' + encodeURIComponent('{{ offre.localisation|e('js') }}'))
        .then(r => { if (!r.ok) throw new Error(); return r.json(); })
        .then(data => {
            document.getElementById('country-flag-offre').textContent = data.flag;
            document.getElementById('offre-country-flag-big').textContent = data.flag;
            document.getElementById('offre-country-name').textContent = data.name;
            document.getElementById('offre-country-capital').textContent = data.capital;
            document.getElementById('offre-country-currency').textContent = data.currency + (data.currencySymbol ? ' (' + data.currencySymbol + ')' : '');
            document.getElementById('offre-country-code').textContent = data.code;
            document.getElementById('country-info-offre').style.display = 'block';
        })
        .catch(() => {});
})();
</script>
{% endif %}
{% endblock %}
