{% extends "@DHAuditor/layout.html.twig" %}
{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
{% import '@DHAuditor/Audit/helpers/pager.html.twig' as pager %}

{% block dh_auditor_header %}
{% set shortName = entity|split('\\')|last %}
<nav class="audit-breadcrumb">
    <i class="fas fa-shield-alt"></i>
    <a href="{{ path('dh_auditor_list_audits') }}">Audit Trail</a>
    <span class="sep"><i class="fas fa-chevron-right" style="font-size:0.6rem;"></i></span>
    <span class="current">{{ shortName }}</span>
    {% if id is not null %}
        <span class="sep"><i class="fas fa-chevron-right" style="font-size:0.6rem;"></i></span>
        <span class="current">#{{ id }}</span>
    {% endif %}
    <span class="badge">{{ paginator.numResults }} opération{{ paginator.numResults != 1 ? 's' }}</span>
</nav>
{% endblock %}

{% block dh_auditor_content %}
{% if paginator.results|length == 0 %}
    <div style="text-align:center; padding: 3rem 1rem; color: var(--tf-gray);">
        <i class="fas fa-history" style="font-size: 2.5rem; opacity: 0.3; margin-bottom: 1rem; display: block;"></i>
        <p style="font-size: 0.9rem;">Aucune opération enregistrée pour cette entité.</p>
    </div>
{% else %}
<div class="audit-timeline">
    {% set i = 0 %}
    {% set amount = paginator.results|length %}
    {% for entry in paginator.results %}
        {% set i = i + 1 %}
        {{ include('@DHAuditor/Audit/entry.html.twig', {'entry': entry, 'entity': entity, 'is_last': i >= amount}) }}
    {% endfor %}
</div>
{% block dh_auditor_pager %}
{{ pager.render(helper.namespaceToParam(entity), id, paginator)|raw }}
{% endblock %}
{% endif %}
{% endblock %}
