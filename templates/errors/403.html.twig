{% extends 'base_navbar.html.twig' %}

{% block title %}Acces refuse - TalentFlow{% endblock %}
{% block page_title %}Erreur 403{% endblock %}

{% block body %}
<div class="tf-card" style="max-width: 760px; margin: 2rem auto; text-align: center; padding: 2.2rem;">
    <div style="font-size: 4rem; line-height: 1; color: #e67e22; margin-bottom: 0.8rem;">
        <i class="fas fa-shield-halved"></i>
    </div>

    <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.7rem; color: var(--tf-gold);">403 - Acces refuse</h2>
    <p style="font-size: 1.02rem; color: var(--tf-gray); margin-bottom: 0.6rem;">Cette page est protegee et votre compte ne peut pas y acceder.</p>
    <p style="font-size: 0.92rem; color: #f0ad4e; margin-bottom: 1.4rem;">{{ errorMessage }}</p>

    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem;">
        <a href="{{ path('app_dashboard') }}" class="btn-gold">
            <i class="fas fa-house"></i> Retour au dashboard
        </a>
        <a href="{{ path('offre_index') }}" class="btn-outline-gold">
            <i class="fas fa-briefcase"></i> Voir les offres
        </a>
    </div>
</div>
{% endblock %}
