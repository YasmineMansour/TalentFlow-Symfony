{% extends 'base.html.twig' %}

{% block title %}Modifier {{ avantage.nom }} - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-edit"></i> Modifier : {{ avantage.nom }}</h2>

<div class="tf-card" style="max-width: 700px;">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'tf-form', 'onsubmit': "if(!this.dataset.confirmed){event.preventDefault(); confirmFormSubmit(this, 'edit', 'cet avantage');}" }}) }}

        {{ form_row(form.nom) }}
        <button type="button" id="btn-ai-suggest-av-nom" class="btn btn-sm mt-1 mb-3" style="background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border: none; border-radius: 8px; padding: 6px 16px;">
            <i class="fas fa-magic"></i> IA : Suggérer un nom
        </button>
        {{ form_row(form.description) }}
        {{ form_row(form.type) }}
        {{ form_row(form.offre) }}

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-gold"><i class="fas fa-save"></i> Enregistrer</button>
            <a href="{{ path('avantage_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
        </div>

    {{ form_end(form) }}
</div>

<script>
(function() {
    document.getElementById('btn-ai-suggest-av-nom').addEventListener('click', function() {
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';

        const desc = document.getElementById('avantage_description')?.value || '';
        const type = document.getElementById('avantage_type')?.value || '';

        fetch('/api/ai/suggest-avantage-nom', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ description: desc, type })
        })
        .then(r => r.json())
        .then(data => {
            if (data.nom) {
                document.getElementById('avantage_nom').value = data.nom;
            }
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-magic"></i> IA : Suggérer un nom';
        });
    });
})();
</script>
{% endblock %}
