{% extends 'base.html.twig' %}

{% block title %}{{ avantage.nom }} - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-gift"></i> {{ avantage.nom }}</h2>

<div class="tf-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span style="color: var(--tf-gray); font-size: 0.85rem;">Avantage #{{ avantage.id }}</span>
        {% if not complete %}
            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Incomplet</span>
        {% else %}
            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Complet</span>
        {% endif %}
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Nom :</strong> <span style="color: var(--tf-gray);">{{ avantage.nom }}</span></p>
            <p><strong style="color: var(--tf-gold);">Type :</strong>
                {% if avantage.type == 'Financier' %}
                    <span class="badge bg-success"><i class="fas fa-euro-sign"></i> {{ avantage.type }}</span>
                {% elseif avantage.type == 'Bien-être' %}
                    <span class="badge" style="background: #8e44ad;"><i class="fas fa-heart"></i> {{ avantage.type }}</span>
                {% elseif avantage.type == 'Matériel' %}
                    <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-laptop"></i> {{ avantage.type }}</span>
                {% else %}
                    <span class="badge bg-secondary"><i class="fas fa-question"></i> {{ avantage.type }}</span>
                {% endif %}
            </p>
            <p><strong style="color: var(--tf-gold);">Offre liée :</strong>
                {% if avantage.offre %}
                    <a href="{{ path('offre_show', {id: avantage.offre.id}) }}" style="color: var(--tf-gold);">{{ avantage.offre.titre }}</a>
                {% else %}
                    <span style="color: var(--tf-gray);">Aucune</span>
                {% endif %}
            </p>
        </div>
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Importance :</strong>
                {% if importance == 'Élevée' %}
                    <span class="badge bg-success"><i class="fas fa-arrow-up"></i> {{ importance }}</span>
                {% elseif importance == 'Moyenne' %}
                    <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-minus"></i> {{ importance }}</span>
                {% else %}
                    <span class="badge bg-secondary"><i class="fas fa-arrow-down"></i> {{ importance }}</span>
                {% endif %}
            </p>
            <p><strong style="color: var(--tf-gold);">Qualité description :</strong>
                {% if qualiteDescription == 'Bonne' %}
                    <span style="color: #2ecc71;"><i class="fas fa-check"></i> {{ qualiteDescription }}</span>
                {% elseif qualiteDescription == 'Moyenne' %}
                    <span style="color: var(--tf-gold);"><i class="fas fa-minus"></i> {{ qualiteDescription }}</span>
                {% else %}
                    <span style="color: #e74c3c;"><i class="fas fa-times"></i> {{ qualiteDescription }}</span>
                {% endif %}
            </p>
        </div>
    </div>

    <hr style="border-color: var(--tf-border);">
    <p><strong style="color: var(--tf-gold);">Description :</strong></p>
    <p style="color: var(--tf-gray);">{{ avantage.description ?? 'Non renseignée' }}</p>
</div>

<div class="d-flex gap-2 mt-3">
    <a href="{{ path('avantage_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
    <a href="{{ path('avantage_edit', {id: avantage.id}) }}" class="btn-gold"><i class="fas fa-edit"></i> Modifier</a>
    <form method="post" action="{{ path('avantage_delete', {id: avantage.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ avantage.nom|e('js') }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avantage.id) }}">
        <button class="btn-danger-tf"><i class="fas fa-trash"></i> Supprimer</button>
    </form>
</div>
{% endblock %}
