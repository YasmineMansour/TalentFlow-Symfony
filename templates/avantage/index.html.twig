{% extends 'base.html.twig' %}

{% block title %}Avantages - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title"><i class="fas fa-gift"></i> Avantages</h2>
    <a href="{{ path('avantage_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvel avantage</a>
</div>

<div class="tf-card mb-4">
    <form method="get" action="{{ path('avantage_index') }}" class="tf-form">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <input type="text" name="q" value="{{ search }}" class="form-control" placeholder="Rechercher un avantage...">
            </div>
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <select name="type" class="form-select">
                    <option value="">Tous</option>
                    {% for t in types %}
                        <option value="{{ t }}" {{ type == t ? 'selected' }}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Offre</label>
                <select name="offre" class="form-select">
                    <option value="">Toutes</option>
                    {% for o in offres %}
                        <option value="{{ o.id }}" {{ offreId == o.id ? 'selected' }}>{{ o.titre }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Trier par</label>
                <select name="tri" class="form-select">
                    <option value="id" {{ tri == 'id' ? 'selected' }}>ID</option>
                    <option value="nom" {{ tri == 'nom' ? 'selected' }}>Nom</option>
                    <option value="type" {{ tri == 'type' ? 'selected' }}>Type</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">Ordre</label>
                <select name="ordre" class="form-select">
                    <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Asc</option>
                    <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Desc</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
            </div>
        </div>
    </form>
</div>

{% for flash in app.flashes('success') %}
    <div class="tf-flash">{{ flash }}</div>
{% endfor %}

<div class="tf-card">
    {% if avantageData|length > 0 %}
    <div class="tf-grid-cards">
        {% for item in avantageData %}
        <div class="tf-item-card">
            <div class="tf-item-card-header">
                <div>
                    <div class="tf-item-card-title">{{ item.avantage.nom }}</div>
                    <div class="tf-item-card-subtitle">
                        {% if item.avantage.offre %}
                            <i class="fas fa-briefcase"></i> <a href="{{ path('offre_show', {id: item.avantage.offre.id}) }}" style="color: var(--tf-gold);">{{ item.avantage.offre.titre }}</a>
                        {% else %}
                            <i class="fas fa-briefcase"></i> Aucune offre
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="tf-item-card-tags">
                {% if item.avantage.type == 'Financier' %}
                    <span class="tf-tag-sm tf-tag-green"><i class="fas fa-euro-sign"></i> {{ item.avantage.type }}</span>
                {% elseif item.avantage.type == 'Bien-être' %}
                    <span class="tf-tag-sm tf-tag-purple"><i class="fas fa-heart"></i> {{ item.avantage.type }}</span>
                {% elseif item.avantage.type == 'Matériel' %}
                    <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-laptop"></i> {{ item.avantage.type }}</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-gray"><i class="fas fa-question"></i> {{ item.avantage.type }}</span>
                {% endif %}

                {% if item.importance == 'Élevée' %}
                    <span class="tf-tag-sm tf-tag-gold"><i class="fas fa-arrow-up"></i> {{ item.importance }}</span>
                {% elseif item.importance == 'Moyenne' %}
                    <span class="tf-tag-sm tf-tag-orange"><i class="fas fa-minus"></i> {{ item.importance }}</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-gray"><i class="fas fa-arrow-down"></i> {{ item.importance }}</span>
                {% endif %}

                {% if item.complete %}
                    <span class="tf-tag-sm tf-tag-green"><i class="fas fa-check-circle"></i> Complet</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-yellow"><i class="fas fa-exclamation-triangle"></i> Incomplet</span>
                {% endif %}
            </div>
            <div class="tf-item-card-meta">
                <span>
                    {% if item.qualiteDescription == 'Bonne' %}
                        <span style="color: #2ecc71;"><i class="fas fa-check"></i> Qualité: {{ item.qualiteDescription }}</span>
                    {% elseif item.qualiteDescription == 'Moyenne' %}
                        <span style="color: var(--tf-gold);"><i class="fas fa-minus"></i> Qualité: {{ item.qualiteDescription }}</span>
                    {% else %}
                        <span style="color: #e74c3c;"><i class="fas fa-times"></i> Qualité: {{ item.qualiteDescription }}</span>
                    {% endif %}
                </span>
            </div>
            <div class="tf-item-card-actions">
                <a href="{{ path('avantage_show', {id: item.avantage.id}) }}" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i></a>
                <a href="{{ path('avantage_edit', {id: item.avantage.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                <form method="post" action="{{ path('avantage_delete', {id: item.avantage.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.avantage.nom|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.avantage.id) }}">
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="tf-card-empty">
        <i class="fas fa-gift"></i>
        <p>Aucun avantage trouvé.</p>
    </div>
    {% endif %}
</div>
{% endblock %}
