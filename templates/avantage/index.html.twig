{% extends 'base.html.twig' %}

{% block title %}Avantages - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-gift"></i> Liste des Avantages</h1>
    <a href="{{ path('avantage_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvel Avantage
    </a>
</div>

<form method="get" action="{{ path('avantage_index') }}" class="mb-4">
    <div class="card">
        <div class="card-body">
            <div class="input-group mb-3">
                <input type="text" name="q" class="form-control" placeholder="Rechercher par nom..." value="{{ search }}">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="bi bi-search"></i> Rechercher
                </button>
                {% if search or type or offreId or tri != 'id' %}
                <a href="{{ path('avantage_index') }}" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i> Réinitialiser
                </a>
                {% endif %}
            </div>

            <div class="row">
                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-tag"></i> Type</label>
                    <select name="type" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tous --</option>
                        {% for t in types %}
                            <option value="{{ t }}" {{ type == t ? 'selected' : '' }}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-briefcase"></i> Offre</label>
                    <select name="offre" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Toutes --</option>
                        {% for o in offres %}
                            <option value="{{ o.id }}" {{ offreId == o.id ? 'selected' : '' }}>{{ o.titre }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-sort-down"></i> Trier par</label>
                    <select name="tri" class="form-select" onchange="this.form.submit()">
                        <option value="id" {{ tri == 'id' ? 'selected' : '' }}>Date (par défaut)</option>
                        <option value="nom" {{ tri == 'nom' ? 'selected' : '' }}>Nom</option>
                        <option value="type" {{ tri == 'type' ? 'selected' : '' }}>Type</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold"><i class="bi bi-arrow-down-up"></i> Ordre</label>
                    <select name="ordre" class="form-select" onchange="this.form.submit()">
                        <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                        <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>Croissant</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</form>

{% if avantageData is empty %}
    <div class="alert alert-info">Aucun avantage trouvé.</div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Type</th>
                <th>Importance</th>
                <th>Description</th>
                <th>Offre associée</th>
                <th>Complet</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for item in avantageData %}
                <tr>
                    <td>{{ item.avantage.id }}</td>
                    <td>
                        <a href="{{ path('avantage_show', {id: item.avantage.id}) }}">{{ item.avantage.nom }}</a>
                    </td>
                    <td><span class="badge bg-info text-dark">{{ item.avantage.type }}</span></td>
                    <td>
                        {% if item.importance == 'Élevée' %}
                            <span class="badge bg-success">{{ item.importance }}</span>
                        {% elseif item.importance == 'Moyenne' %}
                            <span class="badge bg-primary">{{ item.importance }}</span>
                        {% elseif item.importance == 'Standard' %}
                            <span class="badge bg-warning text-dark">{{ item.importance }}</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ item.importance }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.qualiteDescription == 'Détaillée' %}
                            <span class="badge bg-success">{{ item.qualiteDescription }}</span>
                        {% elseif item.qualiteDescription == 'Correcte' %}
                            <span class="badge bg-primary">{{ item.qualiteDescription }}</span>
                        {% elseif item.qualiteDescription == 'Insuffisante' %}
                            <span class="badge bg-warning text-dark">{{ item.qualiteDescription }}</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ item.qualiteDescription }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.avantage.offre %}
                            <a href="{{ path('offre_show', {id: item.avantage.offre.id}) }}">{{ item.avantage.offre.titre }}</a>
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.complete %}
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i></span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i></span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('avantage_edit', {id: item.avantage.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('avantage_delete', {id: item.avantage.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cet avantage ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.avantage.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
