{% extends 'base.html.twig' %}

{% block title %}Avantages - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title"><i class="fas fa-gift"></i> Avantages</h2>
    <a href="{{ path('avantage_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvel avantage</a>
</div>

<div class="tf-card mb-4">
    <form method="get" action="{{ path('avantage_index') }}" class="row g-3 align-items-end">
        <div class="col-md-3">
            <input type="text" name="q" value="{{ search }}" class="tf-search" placeholder="Rechercher un avantage...">
        </div>
        <div class="col-md-2">
            <label style="color: var(--tf-gray); font-size: 0.85rem;">Type</label>
            <select name="type" class="tf-search">
                <option value="">Tous</option>
                {% for t in types %}
                    <option value="{{ t }}" {{ type == t ? 'selected' }}>{{ t }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label style="color: var(--tf-gray); font-size: 0.85rem;">Offre</label>
            <select name="offre" class="tf-search">
                <option value="">Toutes</option>
                {% for o in offres %}
                    <option value="{{ o.id }}" {{ offreId == o.id ? 'selected' }}>{{ o.titre }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label style="color: var(--tf-gray); font-size: 0.85rem;">Trier par</label>
            <select name="tri" class="tf-search">
                <option value="id" {{ tri == 'id' ? 'selected' }}>ID</option>
                <option value="nom" {{ tri == 'nom' ? 'selected' }}>Nom</option>
                <option value="type" {{ tri == 'type' ? 'selected' }}>Type</option>
            </select>
        </div>
        <div class="col-md-1">
            <label style="color: var(--tf-gray); font-size: 0.85rem;">Ordre</label>
            <select name="ordre" class="tf-search">
                <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Asc</option>
                <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Desc</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
        </div>
    </form>
</div>

{% for flash in app.flashes('success') %}
    <div class="tf-flash">{{ flash }}</div>
{% endfor %}

<div class="tf-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--tf-gold);">
                    <th>#</th>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>Offre</th>
                    <th>Importance</th>
                    <th>Qualité desc.</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in avantageData %}
                <tr>
                    <td>{{ item.avantage.id }}</td>
                    <td style="color: var(--tf-gold); font-weight: 600;">{{ item.avantage.nom }}</td>
                    <td>
                        {% if item.avantage.type == 'Financier' %}
                            <span class="badge bg-success"><i class="fas fa-euro-sign"></i> {{ item.avantage.type }}</span>
                        {% elseif item.avantage.type == 'Bien-être' %}
                            <span class="badge" style="background: #8e44ad;"><i class="fas fa-heart"></i> {{ item.avantage.type }}</span>
                        {% elseif item.avantage.type == 'Matériel' %}
                            <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-laptop"></i> {{ item.avantage.type }}</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-question"></i> {{ item.avantage.type }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.avantage.offre %}
                            <a href="{{ path('offre_show', {id: item.avantage.offre.id}) }}" style="color: var(--tf-gold);">{{ item.avantage.offre.titre }}</a>
                        {% else %}
                            <span style="color: var(--tf-gray);">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.importance == 'Élevée' %}
                            <span class="badge bg-success"><i class="fas fa-arrow-up"></i> {{ item.importance }}</span>
                        {% elseif item.importance == 'Moyenne' %}
                            <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-minus"></i> {{ item.importance }}</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-arrow-down"></i> {{ item.importance }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.qualiteDescription == 'Bonne' %}
                            <span style="color: #2ecc71;"><i class="fas fa-check"></i> {{ item.qualiteDescription }}</span>
                        {% elseif item.qualiteDescription == 'Moyenne' %}
                            <span style="color: var(--tf-gold);"><i class="fas fa-minus"></i> {{ item.qualiteDescription }}</span>
                        {% else %}
                            <span style="color: #e74c3c;"><i class="fas fa-times"></i> {{ item.qualiteDescription }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.complete %}
                            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Complet</span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Incomplet</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('avantage_show', {id: item.avantage.id}) }}" class="btn-outline-gold" style="padding: 4px 10px; font-size: 0.8rem;"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('avantage_edit', {id: item.avantage.id}) }}" class="btn-gold" style="padding: 4px 10px; font-size: 0.8rem;"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('avantage_delete', {id: item.avantage.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.avantage.nom|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.avantage.id) }}">
                                <button class="btn-danger-tf" style="padding: 4px 10px; font-size: 0.8rem;"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center" style="color: var(--tf-gray); padding: 2rem;">
                        <i class="fas fa-folder-open fa-2x mb-2" style="display: block;"></i>
                        Aucun avantage trouvé.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
