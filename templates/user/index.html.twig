{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ 'page.user.title'|trans }} - TalentFlow{% endblock %}
{% block page_title %}{{ 'page.user.title'|trans }}{% endblock %}

{% block body %}
<div class="tf-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="tf-title mb-0">
            <i class="fas fa-users"></i> {{ 'page.user.title'|trans }}
        </h2>
        <div class="d-flex gap-2">
            <a href="{{ path('app_user_export_pdf', {'search': search, 'role': role}) }}" class="btn-outline-gold">
                <i class="fas fa-file-pdf"></i> {{ 'action.export_pdf'|trans }}
            </a>
            <a href="{{ path('app_user_new') }}" class="btn-gold">
                <i class="fas fa-user-plus"></i> {{ 'nav.new_user'|trans }}
            </a>
        </div>
    </div>

    {# Search and filter bar #}
    <form method="get" action="{{ path('app_user_index') }}" class="tf-search">
        <input type="text" name="search" value="{{ search }}" placeholder="🔍 {{ 'page.user.search_placeholder'|trans }}" autocomplete="off">
        <select name="role" onchange="this.form.submit()">
            <option value="">-- {{ 'page.user.all_roles'|trans }} --</option>
            <option value="ROLE_ADMIN" {{ role == 'ROLE_ADMIN' ? 'selected' }}>{{ 'role.admin'|trans }}</option>
            <option value="ROLE_RH" {{ role == 'ROLE_RH' ? 'selected' }}>{{ 'role.rh'|trans }}</option>
            <option value="ROLE_CANDIDAT" {{ role == 'ROLE_CANDIDAT' ? 'selected' }}>{{ 'role.candidat'|trans }}</option>
        </select>
        <button type="submit" class="btn-gold">
            <i class="fas fa-search"></i> {{ 'action.search'|trans }}
        </button>
        {% if search or role %}
            <a href="{{ path('app_user_index') }}" class="btn-outline-gold">
                <i class="fas fa-times"></i> {{ 'action.reset'|trans }}
            </a>
        {% endif %}
    </form>

    {# Results count #}
    <p style="color: var(--tf-gray); margin-bottom: 1rem;">
        <i class="fas fa-info-circle"></i> {{ 'common.user_count'|trans({'%count%': users|length}) }}
        {% if search %} {{ 'page.user.for_search'|trans }} "<strong style="color: var(--tf-gold);">{{ search }}</strong>"{% endif %}
    </p>

    {% if users|length > 0 %}
        <div class="tf-grid-cards">
            {% for user in users %}
            <div class="tf-item-card">
                <div class="tf-item-card-header">
                    <div style="display:flex; align-items:center; gap:0.75rem;">
                        <span class="tf-card-avatar">{{ user.prenom|first|upper }}{{ user.nom|first|upper }}</span>
                        <div>
                            <div class="tf-item-card-title">{{ user.fullName }}</div>
                            <div class="tf-item-card-subtitle">
                                <i class="fas fa-envelope"></i> {{ user.email }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tf-item-card-tags">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="tf-tag-sm tf-tag-red"><i class="fas fa-crown"></i> {{ 'role.admin'|trans }}</span>
                    {% elseif 'ROLE_RH' in user.roles %}
                        <span class="tf-tag-sm tf-tag-gold"><i class="fas fa-user-tie"></i> {{ 'role.rh'|trans }}</span>
                    {% elseif 'ROLE_CANDIDAT' in user.roles %}
                        <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-user"></i> {{ 'role.candidat'|trans }}</span>
                    {% else %}
                        <span class="tf-tag-sm tf-tag-gray">{{ 'role.user'|trans }}</span>
                    {% endif %}

                    {% if user.isActive %}
                        <span class="tf-tag-sm" style="background:rgba(39,174,96,.15);color:#27ae60;"><i class="fas fa-check-circle"></i> {{ 'user.status_active'|trans }}</span>
                    {% else %}
                        <span class="tf-tag-sm" style="background:rgba(231,76,60,.15);color:#e74c3c;"><i class="fas fa-ban"></i> {{ 'user.status_disabled'|trans }}</span>
                    {% endif %}
                </div>
                <div class="tf-item-card-meta">
                    {% if user.telephone %}
                        <span><i class="fas fa-phone"></i> {{ user.telephone }}</span>
                    {% endif %}
                    <span><i class="fas fa-calendar"></i> {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</span>
                </div>
                <div class="tf-item-card-actions">
                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i></a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                    {% if user.id != app.user.id %}
                    <form method="post" action="{{ path('app_user_toggle_active', {'id': user.id}) }}"
                          onsubmit="if (typeof confirmToggleActive === 'function') { event.preventDefault(); confirmToggleActive(this, '{{ user.fullName|e('js') }}', {{ user.isActive ? 'true' : 'false' }}); return false; } return confirm('{{ 'user.toggle_confirm_fallback'|trans|e('js') }} {{ user.fullName|e('js') }} ?');"
                          style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_active' ~ user.id) }}">
                        {% if user.isActive %}
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'user.disable_account'|trans }}">
                                <i class="fas fa-user-slash"></i>
                            </button>
                        {% else %}
                            <button type="submit" class="btn btn-sm btn-outline-success" title="{{ 'user.reactivate_account'|trans }}">
                                <i class="fas fa-user-check"></i>
                            </button>
                        {% endif %}
                    </form>
                    {% endif %}
                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" 
                          onsubmit="event.preventDefault(); confirmDelete(this, '{{ user.fullName|e('js') }}');"
                          style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="tf-card-empty">
            <i class="fas fa-users-slash"></i>
            <p>{{ 'page.user.no_users'|trans }}</p>
            <a href="{{ path('app_user_new') }}" class="btn-gold mt-2">
                <i class="fas fa-user-plus"></i> {{ 'page.user.create_first'|trans }}
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
function confirmToggleActive(formEl, name, isCurrentlyActive) {
    if (isCurrentlyActive) {
        showConfirmModal({
            title: '{{ 'user.disable_account'|trans|e('js') }}',
            message: '{{ 'user.confirm_disable_prefix'|trans|e('js') }} <strong style="color:#e74c3c">' + name + '</strong> ?<br><small style="color:#a0a0b0">{{ 'user.confirm_disable_help'|trans|e('js') }}</small>',
            icon: 'fa-user-slash', iconClass: 'danger', btnClass: 'btn-confirm-danger',
            confirmIcon: 'fa-user-slash', confirmText: '{{ 'user.confirm_disable_action'|trans|e('js') }}',
            onConfirm: function() { formEl.submit(); }
        });
    } else {
        showConfirmModal({
            title: '{{ 'user.reactivate_account'|trans|e('js') }}',
            message: '{{ 'user.confirm_reactivate_prefix'|trans|e('js') }} <strong style="color:#27ae60">' + name + '</strong> ?',
            icon: 'fa-user-check', iconClass: 'success', btnClass: 'btn-confirm-gold',
            confirmIcon: 'fa-user-check', confirmText: '{{ 'user.confirm_reactivate_action'|trans|e('js') }}',
            onConfirm: function() { formEl.submit(); }
        });
    }
}
</script>
{% endblock %}
