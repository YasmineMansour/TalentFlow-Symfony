{% extends 'base_dashboard.html.twig' %}

{% block title %}Liste des Utilisateurs - TalentFlow{% endblock %}
{% block page_title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="tf-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="tf-title mb-0">
            <i class="fas fa-users"></i> Gestion des Utilisateurs
        </h2>
        <div class="d-flex gap-2">
            <a href="{{ path('app_user_export_pdf', {'search': search, 'role': role}) }}" class="btn-outline-gold">
                <i class="fas fa-file-pdf"></i> Export PDF
            </a>
            <a href="{{ path('app_user_new') }}" class="btn-gold">
                <i class="fas fa-user-plus"></i> Nouvel Utilisateur
            </a>
        </div>
    </div>

    {# Search and filter bar #}
    <form method="get" action="{{ path('app_user_index') }}" class="tf-search">
        <input type="text" name="search" value="{{ search }}" placeholder="🔍 Rechercher par nom, prénom ou email..." autocomplete="off">
        <select name="role" onchange="this.form.submit()">
            <option value="">-- Tous les rôles --</option>
            <option value="ROLE_ADMIN" {{ role == 'ROLE_ADMIN' ? 'selected' }}>Administrateur</option>
            <option value="ROLE_RH" {{ role == 'ROLE_RH' ? 'selected' }}>Recruteur RH</option>
            <option value="ROLE_CANDIDAT" {{ role == 'ROLE_CANDIDAT' ? 'selected' }}>Candidat</option>
        </select>
        <button type="submit" class="btn-gold">
            <i class="fas fa-search"></i> Rechercher
        </button>
        {% if search or role %}
            <a href="{{ path('app_user_index') }}" class="btn-outline-gold">
                <i class="fas fa-times"></i> Effacer
            </a>
        {% endif %}
    </form>

    {# Results count #}
    <p style="color: var(--tf-gray); margin-bottom: 1rem;">
        <i class="fas fa-info-circle"></i> {{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }} trouvé{{ users|length > 1 ? 's' : '' }}
        {% if search %} pour "<strong style="color: var(--tf-gold);">{{ search }}</strong>"{% endif %}
    </p>

    {% if users|length > 0 %}
        <div class="tf-grid-cards">
            {% for user in users %}
            <div class="tf-item-card">
                <div class="tf-item-card-header">
                    <div style="display:flex; align-items:center; gap:0.75rem;">
                        <span class="tf-card-avatar">{{ user.prenom|first|upper }}{{ user.nom|first|upper }}</span>
                        <div>
                            <div class="tf-item-card-title">{{ user.fullName }}</div>
                            <div class="tf-item-card-subtitle">
                                <i class="fas fa-envelope"></i> {{ user.email }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tf-item-card-tags">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="tf-tag-sm tf-tag-red"><i class="fas fa-crown"></i> Admin</span>
                    {% elseif 'ROLE_RH' in user.roles %}
                        <span class="tf-tag-sm tf-tag-gold"><i class="fas fa-user-tie"></i> RH</span>
                    {% elseif 'ROLE_CANDIDAT' in user.roles %}
                        <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-user"></i> Candidat</span>
                    {% else %}
                        <span class="tf-tag-sm tf-tag-gray">Utilisateur</span>
                    {% endif %}

                    {% if user.isActive %}
                        <span class="tf-tag-sm" style="background:rgba(39,174,96,.15);color:#27ae60;"><i class="fas fa-check-circle"></i> Actif</span>
                    {% else %}
                        <span class="tf-tag-sm" style="background:rgba(231,76,60,.15);color:#e74c3c;"><i class="fas fa-ban"></i> Désactivé</span>
                    {% endif %}
                </div>
                <div class="tf-item-card-meta">
                    {% if user.telephone %}
                        <span><i class="fas fa-phone"></i> {{ user.telephone }}</span>
                    {% endif %}
                    <span><i class="fas fa-calendar"></i> {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</span>
                </div>
                <div class="tf-item-card-actions">
                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i></a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                    {% if user.id != app.user.id %}
                    <form method="post" action="{{ path('app_user_toggle_active', {'id': user.id}) }}"
                          onsubmit="event.preventDefault(); confirmToggleActive(this, '{{ user.fullName|e('js') }}', {{ user.isActive ? 'true' : 'false' }});"
                          style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_active' ~ user.id) }}">
                        {% if user.isActive %}
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Désactiver le compte">
                                <i class="fas fa-user-slash"></i>
                            </button>
                        {% else %}
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Réactiver le compte">
                                <i class="fas fa-user-check"></i>
                            </button>
                        {% endif %}
                    </form>
                    {% endif %}
                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" 
                          onsubmit="event.preventDefault(); confirmDelete(this, '{{ user.fullName|e('js') }}');"
                          style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="tf-card-empty">
            <i class="fas fa-users-slash"></i>
            <p>Aucun utilisateur trouvé.</p>
            <a href="{{ path('app_user_new') }}" class="btn-gold mt-2">
                <i class="fas fa-user-plus"></i> Créer le premier utilisateur
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
function confirmToggleActive(formEl, name, isCurrentlyActive) {
    if (isCurrentlyActive) {
        showConfirmModal({
            title: 'Désactiver le compte',
            message: 'Voulez-vous vraiment désactiver le compte de <strong style="color:#e74c3c">' + name + '</strong> ?<br><small style="color:#a0a0b0">L\'utilisateur ne pourra plus se connecter.</small>',
            icon: 'fa-user-slash', iconClass: 'danger', btnClass: 'btn-confirm-danger',
            confirmIcon: 'fa-user-slash', confirmText: 'Oui, désactiver',
            onConfirm: function() { formEl.submit(); }
        });
    } else {
        showConfirmModal({
            title: 'Réactiver le compte',
            message: 'Voulez-vous réactiver le compte de <strong style="color:#27ae60">' + name + '</strong> ?',
            icon: 'fa-user-check', iconClass: 'success', btnClass: 'btn-confirm-gold',
            confirmIcon: 'fa-user-check', confirmText: 'Oui, réactiver',
            onConfirm: function() { formEl.submit(); }
        });
    }
}
</script>
{% endblock %}
