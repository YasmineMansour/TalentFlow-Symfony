<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
<meta charset="UTF-8">
<style>
  body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; }
  .wrapper { max-width: 580px; margin: 30px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
  .header { background: #1a2a4a; padding: 28px 32px; text-align: center; }
  .header h1 { color: #d4a843; margin: 0; font-size: 22px; letter-spacing: 0.5px; }
  .header p { color: #c0cce0; margin: 6px 0 0; font-size: 13px; }
  .body { padding: 32px; color: #333; line-height: 1.7; }
  .body h2 { color: #1a2a4a; font-size: 18px; margin-top: 0; }
  .info-box { background: #f0f5ff; border-left: 4px solid #1a2a4a; border-radius: 4px; padding: 16px 20px; margin: 20px 0; }
  .info-box p { margin: 6px 0; font-size: 14px; }
  .info-box strong { color: #1a2a4a; }
  .meet-btn { display: inline-block; margin: 18px 0; padding: 12px 28px; background: #d4a843; color: #1a2a4a; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 15px; }
  .tag { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; margin-left: 6px; }
  .tag-blue { background: #dbeafe; color: #1e40af; }
  .tag-green { background: #dcfce7; color: #166534; }
  .tag-yellow { background: #fef9c3; color: #854d0e; }
  .footer { background: #f0f0f0; padding: 16px 32px; text-align: center; font-size: 12px; color: #888; }
</style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <h1>TalentFlow RH</h1>
    <p>{{ 'email.entretien_confirmation.header_subtitle'|trans }}</p>
  </div>
  <div class="body">
    <h2>{{ 'email.entretien_confirmation.greeting'|trans }}</h2>
    <p>
      {{ 'email.entretien_confirmation.confirm_intro'|trans }}
      <strong>{{ entretien.dateHeure ? entretien.dateHeure|date('d/m/Y à H:i') : '—' }}</strong>.
    </p>

    <div class="info-box">
      <p><strong>{{ 'email.entretien_confirmation.position'|trans }}&nbsp;:</strong> {{ candidature.titrePoste }}</p>
      <p><strong>{{ 'email.entretien_confirmation.company'|trans }}&nbsp;:</strong> {{ candidature.entreprise }}</p>
      <p>
        <strong>{{ 'common.type'|trans }}&nbsp;:</strong>
        {% if entretien.type == 'EN_LIGNE' %}
          <span class="tag tag-blue">{{ 'entretien.type.online'|trans }}</span>
        {% elseif entretien.type == 'PRESENTIEL' %}
          <span class="tag tag-green">{{ 'entretien.type.onsite'|trans }}</span>
        {% else %}
          <span class="tag tag-yellow">{{ 'entretien.type.phone'|trans }}</span>
        {% endif %}
      </p>

      {% if entretien.type == 'PRESENTIEL' and entretien.lieu %}
        <p><strong>{{ 'entretien.fields.location'|trans }}&nbsp;:</strong> {{ entretien.lieu }}</p>
      {% endif %}

      {% if entretien.type == 'TELEPHONIQUE' %}
        <p>{{ 'entretien.phone.be_available'|trans }}</p>
      {% endif %}
    </div>

    {% if meetUrl %}
      <p>{{ 'email.entretien_confirmation.join_online_intro'|trans }}</p>
      <a href="{{ meetUrl }}" class="meet-btn">🎥 {{ 'email.entretien_confirmation.join_button'|trans }}</a>
      <p style="font-size:12px; color:#888;">{{ 'email.entretien_confirmation.link_label'|trans }} : <a href="{{ meetUrl }}" style="color:#1a2a4a;">{{ meetUrl }}</a></p>
      
      {# Live Coding Link #}
      <div style="background: #f8f4ff; border: 2px solid #d4a843; border-radius: 8px; padding: 16px; margin: 20px 0;">
          <p style="margin-top: 0; font-weight: bold; color: #1a2a4a;"><i style="color: #d4a843;">💻</i> {{ 'email.entretien_confirmation.live_coding_title'|trans }}</p>
        <p style="margin: 8px 0; font-size: 14px; color: #333;">{{ 'email.entretien_confirmation.live_coding_intro'|trans }}</p>
          <a href="{{ app.request.schemeAndHttpHost ~ path('app_live_coding_join', {'id': entretien.id}) }}" style="display: inline-block; padding: 10px 20px; background: #fbbf24; color: #000; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 14px;">{{ 'email.entretien_confirmation.live_coding_button'|trans }}</a>
      </div>
    {% endif %}

    <p>{{ 'email.entretien_confirmation.portal_intro'|trans }}&nbsp;: <a href="{{ app.request.schemeAndHttpHost ~ path('app_mon_entretien', {'id': entretien.id}) }}" style="color:#1a2a4a;">{{ 'email.entretien_confirmation.portal_link'|trans }}</a></p>

    <p>{{ 'email.entretien_confirmation.questions'|trans }}</p>
    <p>{{ 'email.entretien_confirmation.signature_intro'|trans }}<br><strong>{{ 'email.entretien_confirmation.signature_team'|trans }}</strong></p>
  </div>
  <div class="footer">
    © {{ "now"|date("Y") }} TalentFlow — {{ 'email.entretien_confirmation.footer'|trans }}
  </div>
</div>
</body>
</html>
