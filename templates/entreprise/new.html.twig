{% extends 'base.html.twig' %}

{% block title %}Nouvelle Entreprise - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-plus-circle"></i> Nouvelle Entreprise</h2>

{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'tf-form', 'onsubmit': "if(!this.dataset.confirmed){event.preventDefault(); confirmFormSubmit(this, 'create', 'cette entreprise');}" }}) }}
    <div class="tf-card">
        <div class="mb-3">
            {{ form_row(form.nom) }}
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.secteur) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.adresse) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.email) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.telephone) }}
            </div>
        </div>
        <div class="mb-3">
            {{ form_row(form.description) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.logo) }}
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('entreprise_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
            <button type="submit" class="btn-gold"><i class="fas fa-check"></i> Créer</button>
        </div>
    </div>
{{ form_end(form) }}
{% endblock %}
