{% extends 'base.html.twig' %}

{% block title %}Entreprises - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title"><i class="fas fa-building"></i> Liste des Entreprises</h2>
    <a href="{{ path('entreprise_new') }}" class="btn-gold"><i class="fas fa-plus-circle"></i> Nouvelle Entreprise</a>
</div>

<div class="tf-card mb-4">
    <form method="get" action="{{ path('entreprise_index') }}">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <div class="tf-search">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" class="form-control" placeholder="Rechercher par nom..." value="{{ search }}">
                </div>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.8rem;"><i class="fas fa-briefcase"></i> Secteur</label>
                <select name="secteur" class="form-control" style="background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);" onchange="this.form.submit()">
                    <option value="">-- Tous --</option>
                    {% for s in secteurs %}
                        <option value="{{ s }}" {{ secteur == s ? 'selected' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.8rem;"><i class="fas fa-sort"></i> Trier par</label>
                <select name="tri" class="form-control" style="background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);" onchange="this.form.submit()">
                    <option value="id" {{ tri == 'id' ? 'selected' }}>Date</option>
                    <option value="nom" {{ tri == 'nom' ? 'selected' }}>Nom</option>
                    <option value="secteur" {{ tri == 'secteur' ? 'selected' }}>Secteur</option>
                </select>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.8rem;"><i class="fas fa-arrows-alt-v"></i> Ordre</label>
                <select name="ordre" class="form-control" style="background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);" onchange="this.form.submit()">
                    <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Décroissant</option>
                    <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Croissant</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-gold"><i class="fas fa-search"></i></button>
                {% if search or secteur or tri != 'id' %}
                    <a href="{{ path('entreprise_index') }}" class="btn-outline-gold"><i class="fas fa-times"></i></a>
                {% endif %}
            </div>
        </div>
    </form>
</div>

{% if entrepriseData is empty %}
    <div class="tf-card">
        <div class="tf-card-empty">
            <i class="fas fa-building"></i>
            <p>Aucune entreprise trouvée.</p>
        </div>
    </div>
{% else %}
<div class="tf-card">
    <div class="tf-grid-cards">
        {% for item in entrepriseData %}
        <div class="tf-item-card">
            <div class="tf-item-card-header">
                <div>
                    <div class="tf-item-card-title">
                        <a href="{{ path('entreprise_show', {id: item.entreprise.id}) }}" style="color: var(--tf-gold); text-decoration:none;">{{ item.entreprise.nom }}</a>
                        {% if not item.complete %}
                            <span class="tf-tag-sm tf-tag-yellow" style="margin-left:0.3rem;"><i class="fas fa-exclamation-triangle"></i></span>
                        {% endif %}
                    </div>
                    <div class="tf-item-card-subtitle">
                        <i class="fas fa-briefcase"></i> {{ item.entreprise.secteur ?? 'Secteur non défini' }}
                    </div>
                </div>
            </div>
            <div class="tf-item-card-meta">
                {% if item.entreprise.email %}
                    <span><i class="fas fa-envelope"></i> {{ item.entreprise.email }}</span>
                {% endif %}
                {% if item.entreprise.telephone %}
                    <span><i class="fas fa-phone"></i> {{ item.entreprise.telephone }}</span>
                {% endif %}
            </div>
            <div class="tf-item-card-tags">
                <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-file-alt"></i> {{ item.entreprise.offres|length }} offre{{ item.entreprise.offres|length > 1 ? 's' : '' }}</span>

                {% if item.taille == 'Grande' %}
                    <span class="tf-tag-sm tf-tag-green"><i class="fas fa-building"></i> {{ item.taille }}</span>
                {% elseif item.taille == 'Moyenne' %}
                    <span class="tf-tag-sm tf-tag-orange"><i class="fas fa-building"></i> {{ item.taille }}</span>
                {% elseif item.taille == 'Petite' %}
                    <span class="tf-tag-sm tf-tag-gray"><i class="fas fa-building"></i> {{ item.taille }}</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-gray">{{ item.taille }}</span>
                {% endif %}

                {% if item.activite == 'Très active' %}
                    <span class="tf-tag-sm tf-tag-green"><i class="fas fa-bolt"></i> {{ item.activite }}</span>
                {% elseif item.activite == 'Active' %}
                    <span class="tf-tag-sm tf-tag-gold"><i class="fas fa-bolt"></i> {{ item.activite }}</span>
                {% elseif item.activite == 'Peu active' %}
                    <span class="tf-tag-sm tf-tag-orange"><i class="fas fa-bolt"></i> {{ item.activite }}</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-gray"><i class="fas fa-moon"></i> {{ item.activite }}</span>
                {% endif %}
            </div>
            <div class="tf-item-card-actions">
                <a href="{{ path('entreprise_edit', {id: item.entreprise.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                <form method="post" action="{{ path('entreprise_delete', {id: item.entreprise.id}) }}" class="d-inline" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.entreprise.nom|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.entreprise.id) }}">
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}
