{% extends 'base.html.twig' %}

{% block title %}Entreprises - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title"><i class="fas fa-building"></i> Liste des Entreprises</h2>
    <a href="{{ path('entreprise_new') }}" class="btn-gold"><i class="fas fa-plus-circle"></i> Nouvelle Entreprise</a>
</div>

<div class="tf-card mb-4">
    <form method="get" action="{{ path('entreprise_index') }}">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <div class="tf-search">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" class="form-control" placeholder="Rechercher par nom..." value="{{ search }}">
                </div>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.8rem;"><i class="fas fa-briefcase"></i> Secteur</label>
                <select name="secteur" class="form-control" style="background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);" onchange="this.form.submit()">
                    <option value="">-- Tous --</option>
                    {% for s in secteurs %}
                        <option value="{{ s }}" {{ secteur == s ? 'selected' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.8rem;"><i class="fas fa-sort"></i> Trier par</label>
                <select name="tri" class="form-control" style="background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);" onchange="this.form.submit()">
                    <option value="id" {{ tri == 'id' ? 'selected' }}>Date</option>
                    <option value="nom" {{ tri == 'nom' ? 'selected' }}>Nom</option>
                    <option value="secteur" {{ tri == 'secteur' ? 'selected' }}>Secteur</option>
                </select>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.8rem;"><i class="fas fa-arrows-alt-v"></i> Ordre</label>
                <select name="ordre" class="form-control" style="background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);" onchange="this.form.submit()">
                    <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Décroissant</option>
                    <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Croissant</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-gold"><i class="fas fa-search"></i></button>
                {% if search or secteur or tri != 'id' %}
                    <a href="{{ path('entreprise_index') }}" class="btn-outline-gold"><i class="fas fa-times"></i></a>
                {% endif %}
            </div>
        </div>
    </form>
</div>

{% if entrepriseData is empty %}
    <div class="tf-flash tf-flash-info"><i class="fas fa-info-circle"></i> Aucune entreprise trouvée.</div>
{% else %}
<div class="tf-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--tf-gold);">
                    <th>#</th>
                    <th>Nom</th>
                    <th>Secteur</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Offres</th>
                    <th>Taille</th>
                    <th>Activité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in entrepriseData %}
                <tr>
                    <td>{{ item.entreprise.id }}</td>
                    <td>
                        <a href="{{ path('entreprise_show', {id: item.entreprise.id}) }}" style="color: var(--tf-gold);">{{ item.entreprise.nom }}</a>
                        {% if not item.complete %}
                            <span class="badge bg-warning text-dark" title="Profil incomplet"><i class="fas fa-exclamation-triangle"></i></span>
                        {% endif %}
                    </td>
                    <td style="color: var(--tf-gray);">{{ item.entreprise.secteur ?? '-' }}</td>
                    <td style="color: var(--tf-gray);">{{ item.entreprise.email ?? '-' }}</td>
                    <td style="color: var(--tf-gray);">{{ item.entreprise.telephone ?? '-' }}</td>
                    <td><span class="badge" style="background: var(--tf-dark-blue);">{{ item.entreprise.offres|length }}</span></td>
                    <td>
                        {% if item.taille == 'Grande' %}
                            <span class="badge bg-success"><i class="fas fa-building"></i> {{ item.taille }}</span>
                        {% elseif item.taille == 'Moyenne' %}
                            <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-building"></i> {{ item.taille }}</span>
                        {% elseif item.taille == 'Petite' %}
                            <span class="badge bg-secondary"><i class="fas fa-building"></i> {{ item.taille }}</span>
                        {% else %}
                            <span style="color: var(--tf-gray);">{{ item.taille }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.activite == 'Très active' %}
                            <span style="color: #2ecc71;"><i class="fas fa-bolt"></i> {{ item.activite }}</span>
                        {% elseif item.activite == 'Active' %}
                            <span style="color: var(--tf-gold);"><i class="fas fa-bolt"></i> {{ item.activite }}</span>
                        {% elseif item.activite == 'Peu active' %}
                            <span style="color: #e67e22;"><i class="fas fa-bolt"></i> {{ item.activite }}</span>
                        {% else %}
                            <span style="color: var(--tf-gray);"><i class="fas fa-moon"></i> {{ item.activite }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('entreprise_edit', {id: item.entreprise.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="fas fa-edit"></i></a>
                        <form method="post" action="{{ path('entreprise_delete', {id: item.entreprise.id}) }}" class="d-inline" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.entreprise.nom|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.entreprise.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
