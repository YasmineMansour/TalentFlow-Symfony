{% extends 'base.html.twig' %}

{% block title %}{{ entreprise.nom }} - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-building"></i> {{ entreprise.nom }}</h2>

<div class="tf-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span style="color: var(--tf-gray); font-size: 0.85rem;">Entreprise #{{ entreprise.id }}</span>
        {% if not complete %}
            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Profil incomplet</span>
        {% else %}
            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Profil complet</span>
        {% endif %}
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Secteur :</strong> <span style="color: var(--tf-gray);">{{ entreprise.secteur ?? 'Non renseigné' }}</span></p>
            <p><strong style="color: var(--tf-gold);">Adresse :</strong> <span style="color: var(--tf-gray);">{{ entreprise.adresse ?? 'Non renseignée' }}</span></p>
            <p><strong style="color: var(--tf-gold);">Email :</strong> <span style="color: var(--tf-gray);">{{ entreprise.email ?? 'Non renseigné' }}</span></p>
        </div>
        <div class="col-md-6">
            <p><strong style="color: var(--tf-gold);">Téléphone :</strong> <span style="color: var(--tf-gray);">{{ entreprise.telephone ?? 'Non renseigné' }}</span></p>
            <p><strong style="color: var(--tf-gold);">Taille :</strong>
                {% if taille == 'Grande' %}
                    <span class="badge bg-success"><i class="fas fa-building"></i> {{ taille }}</span>
                {% elseif taille == 'Moyenne' %}
                    <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-building"></i> {{ taille }}</span>
                {% elseif taille == 'Petite' %}
                    <span class="badge bg-secondary"><i class="fas fa-building"></i> {{ taille }}</span>
                {% else %}
                    <span style="color: var(--tf-gray);">{{ taille }}</span>
                {% endif %}
            </p>
            <p><strong style="color: var(--tf-gold);">Activité :</strong>
                {% if activite == 'Très active' %}
                    <span style="color: #2ecc71;"><i class="fas fa-bolt"></i> {{ activite }}</span>
                {% elseif activite == 'Active' %}
                    <span style="color: var(--tf-gold);"><i class="fas fa-bolt"></i> {{ activite }}</span>
                {% elseif activite == 'Peu active' %}
                    <span style="color: #e67e22;"><i class="fas fa-bolt"></i> {{ activite }}</span>
                {% else %}
                    <span style="color: var(--tf-gray);"><i class="fas fa-moon"></i> {{ activite }}</span>
                {% endif %}
            </p>
        </div>
    </div>

    <hr style="border-color: var(--tf-border);">
    <p><strong style="color: var(--tf-gold);">Description :</strong></p>
    <p style="color: var(--tf-gray);">{{ entreprise.description ?? 'Non renseignée' }}</p>

    {% if entreprise.logo %}
        <p><strong style="color: var(--tf-gold);">Logo :</strong></p>
        <p><img src="{{ entreprise.logo }}" alt="{{ entreprise.nom }}" style="max-height:80px; border-radius: 8px;"></p>
    {% endif %}
</div>

{# Offres liées #}
<div class="tf-card mt-4">
    <h5 style="color: var(--tf-gold);"><i class="fas fa-briefcase"></i> Offres publiées ({{ entreprise.offres|length }})</h5>
    <hr style="border-color: var(--tf-border);">
    {% if entreprise.offres is empty %}
        <p style="color: var(--tf-gray);"><i class="fas fa-info-circle"></i> Aucune offre publiée par cette entreprise.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="color: var(--tf-gold);">
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offre in entreprise.offres %}
                    <tr>
                        <td><a href="{{ path('offre_show', {id: offre.id}) }}" style="color: var(--tf-gold);">{{ offre.titre }}</a></td>
                        <td><span class="badge" style="background: var(--tf-dark-blue);">{{ offre.typeContrat }}</span></td>
                        <td>
                            {% if offre.statut == 'PUBLISHED' %}
                                <span class="badge bg-success">Publiée</span>
                            {% elseif offre.statut == 'DRAFT' %}
                                <span class="badge bg-secondary">Brouillon</span>
                            {% else %}
                                <span class="badge bg-danger">Fermée</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<div class="d-flex gap-2 mt-3">
    <a href="{{ path('entreprise_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
    <a href="{{ path('entreprise_edit', {id: entreprise.id}) }}" class="btn-gold"><i class="fas fa-edit"></i> Modifier</a>
    <form method="post" action="{{ path('entreprise_delete', {id: entreprise.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ entreprise.nom|e('js') }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entreprise.id) }}">
        <button class="btn-danger-tf"><i class="fas fa-trash"></i> Supprimer</button>
    </form>
</div>
{% endblock %}
