<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accès Live Coding - TalentFlow</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #e2e8f0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        
        .join-container {
            width: 100%;
            max-width: 600px;
            background: #1a1f2e;
            border: 2px solid rgba(212, 168, 67, 0.3);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
        }
        
        .header-icon {
            font-size: 48px;
            color: #fbbf24;
            margin-bottom: 20px;
            display: block;
        }
        
        h1 {
            font-size: 28px;
            color: #fbbf24;
            margin-bottom: 12px;
            font-weight: 700;
        }
        
        .subtitle {
            color: #94a3b8;
            margin-bottom: 30px;
            font-size: 16px;
        }
        
        .info-box {
            background: rgba(75, 144, 226, 0.1);
            border: 1px solid rgba(75, 144, 226, 0.3);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 30px;
            text-align: left;
        }
        
        .info-box p {
            margin: 8px 0;
            font-size: 14px;
            color: #cbd5e1;
        }
        
        .info-box strong {
            color: #4a90e2;
        }
        
        .auth-status {
            padding: 16px;
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 14px;
        }
        
        .auth-status.logged-in {
            background: rgba(74, 222, 128, 0.1);
            border: 1px solid rgba(74, 222, 128, 0.3);
            color: #4ade80;
        }
        
        .auth-status.not-logged-in {
            background: rgba(251, 191, 36, 0.1);
            border: 1px solid rgba(251, 191, 36, 0.3);
            color: #fbbf24;
        }
        
        .button-group {
            display: flex;
            gap: 12px;
            flex-direction: column;
        }
        
        .btn {
            padding: 14px 28px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-primary {
            background: #fbbf24;
            color: #000;
        }
        
        .btn-primary:hover {
            background: #f59e0b;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(251, 191, 36, 0.3);
        }
        
        .btn-secondary {
            background: transparent;
            color: #4a90e2;
            border: 2px solid #4a90e2;
        }
        
        .btn-secondary:hover {
            background: rgba(74, 144, 226, 0.1);
            transform: translateY(-2px);
        }
        
        .loading {
            display: none;
            text-align: center;
            padding: 20px;
            color: #fbbf24;
        }
        
        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(251, 191, 36, 0.3);
            border-top: 3px solid #fbbf24;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="join-container">
        <i class="fas fa-code header-icon"></i>
        <h1>Live Coding</h1>
        <p class="subtitle">Entretien technique – Test de codage en temps réel</p>
        
        <div class="info-box">
            <p><strong>Session ID:</strong> {{ id }}</p>
            <p><strong>Format:</strong> Test de codage interactif avec WebSocket</p>
            <p style="margin-top: 12px; font-size: 12px; color: #64748b;">
                <i class="fas fa-lock" style="color: #4a90e2;"></i> Connexion sécurisée requise
            </p>
        </div>
        
        <div id="authStatus" class="auth-status not-logged-in">
            <i class="fas fa-user-slash"></i> Non authentifié – Vous devez vous connecter pour accéder au Live Coding
        </div>
        
        <div id="errorBox" class="error"></div>
        
        <div id="loading" class="loading">
            <div class="spinner"></div>
            <p style="margin-top: 10px;">Chargement...</p>
        </div>
        
        <div id="buttons" class="button-group">
            <button id="joinBtn" class="btn btn-primary" onclick="handleJoin()">
                <i class="fas fa-play"></i> Rejoindre Live Coding
            </button>
            <a href="{{ baseUrl }}/entretiens" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <script>
        const entretienId = {{ id }};
        
        async function checkStatus() {
            try {
                // Check if user is already authenticated
                const response = await fetch('{{ baseUrl }}/api/user/status', {
                    credentials: 'include'
                });
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.authenticated) {
                        document.getElementById('authStatus').classList.remove('not-logged-in');
                        document.getElementById('authStatus').classList.add('logged-in');
                        document.getElementById('authStatus').innerHTML = 
                            '<i class="fas fa-check-circle"></i> Connecté – Vous pouvez accéder au Live Coding';
                    }
                }
            } catch (e) {
                console.log('Status check failed');
            }
        }
        
        function handleJoin() {
            const joinBtn = document.getElementById('joinBtn');
            const loading = document.getElementById('loading');
            const buttons = document.getElementById('buttons');
            
            // Show loading state
            joinBtn.disabled = true;
            buttons.style.display = 'none';
            loading.style.display = 'block';
            
            // Redirect to live coding room
            setTimeout(() => {
                window.location.href = '{{ baseUrl }}/mon-entretien/' + entretienId + '/live-coding';
            }, 500);
        }
        
        // Check status on load
        document.addEventListener('DOMContentLoaded', checkStatus);
    </script>
</body>
</html>
