{% extends 'base_dashboard.html.twig' %}

{% block title %}Mon Espace - TalentFlow{% endblock %}
{% block page_title %}Mon Espace Candidat{% endblock %}

{% block body %}
{# ==================== BIENVENUE ==================== #}
<div class="tf-card mb-4" style="border-left: 4px solid var(--tf-gold);">
    <div class="d-flex align-items-center gap-3">
        <span class="tf-avatar" style="width: 55px; height: 55px; font-size: 1.2rem;">
            {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
        </span>
        <div>
            <h3 style="margin: 0; color: var(--tf-gold); font-weight: 700;">
                Bienvenue, {{ app.user.prenom }} !
            </h3>
            <p style="color: var(--tf-gray); margin: 0.2rem 0 0;">
                Suivez vos candidatures et découvrez de nouvelles opportunités.
            </p>
        </div>
    </div>
</div>

{# ==================== WIDGETS ==================== #}
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon gold">
                <i class="fas fa-paper-plane"></i>
            </div>
            <div class="tf-widget-info">
                <h3>{{ candidaturesEnvoyees }}</h3>
                <p>Candidatures envoyées</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon blue">
                <i class="fas fa-briefcase"></i>
            </div>
            <div class="tf-widget-info">
                <h3>{{ offresDisponibles }}</h3>
                <p>Offres disponibles</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="tf-widget-info">
                <h3>{{ acceptees }}</h3>
                <p>Acceptées</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon red">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="tf-widget-info">
                <h3>{{ enAttente }}</h3>
                <p>En attente</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    {# ==================== SUIVI DES CANDIDATURES ==================== #}
    <div class="col-lg-8">
        <div class="tf-card" style="height: 100%;">
            <div class="tf-card-header">
                <h3><i class="fas fa-tasks"></i> Suivi de mes candidatures</h3>
            </div>

            {% if candidaturesEnvoyees > 0 %}
                {# Placeholder pour le tableau des candidatures #}
                <div class="table-responsive">
                    <table class="tf-table">
                        <thead>
                            <tr>
                                <th>Offre</th>
                                <th>Entreprise</th>
                                <th>Date</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" style="text-align: center; color: var(--tf-gray); padding: 1.5rem;">
                                    Les données seront affichées ici quand le module Candidatures sera actif.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div style="text-align: center; padding: 3rem; color: var(--tf-gray);">
                    <i class="fas fa-inbox" style="font-size: 3rem; color: var(--tf-border); margin-bottom: 1rem; display: block;"></i>
                    <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Aucune candidature pour le moment</p>
                    <small>Parcourez les offres disponibles et postulez dès maintenant !</small>
                    <div class="mt-3">
                        <a href="#" class="btn-gold">
                            <i class="fas fa-search"></i> Parcourir les offres
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {# ==================== ACTIONS & PROFIL ==================== #}
    <div class="col-lg-4">
        <div class="tf-card mb-3">
            <div class="tf-card-header">
                <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <a href="#" class="tf-quick-action">
                        <i class="fas fa-search"></i>
                        <span>Chercher offres</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="#" class="tf-quick-action">
                        <i class="fas fa-upload"></i>
                        <span>Déposer CV</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="#" class="tf-quick-action">
                        <i class="fas fa-id-badge"></i>
                        <span>Mon Profil</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="#" class="tf-quick-action">
                        <i class="fas fa-envelope"></i>
                        <span>Messages</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="tf-card">
            <div class="tf-card-header">
                <h3><i class="fas fa-chart-pie"></i> Statistiques</h3>
            </div>
            <canvas id="candidatChart" width="200" height="200"></canvas>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const ctx = document.getElementById('candidatChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['En attente', 'Acceptées', 'Refusées'],
            datasets: [{
                data: [{{ enAttente }}, {{ acceptees }}, {{ refusees }}],
                backgroundColor: ['rgba(212, 168, 67, 0.7)', 'rgba(39, 174, 96, 0.7)', 'rgba(192, 57, 43, 0.7)'],
                borderColor: '#1e2a3a',
                borderWidth: 3,
            }]
        },
        options: {
            responsive: true,
            cutout: '60%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { color: '#a0a0b0', padding: 15, font: { size: 11 } }
                },
                tooltip: {
                    backgroundColor: '#1e2a3a',
                    titleColor: '#d4a843',
                    bodyColor: '#f5f5f5',
                    cornerRadius: 8,
                }
            }
        }
    });
</script>
{% endblock %}
