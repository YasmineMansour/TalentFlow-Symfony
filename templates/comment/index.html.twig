{% extends is_granted('ROLE_ADMIN') ? 'base_dashboard.html.twig' : 'base_navbar.html.twig' %}

{% block title %}Forum - Commentaires{% endblock %}
{% block page_title %}Gestion des Commentaires{% endblock %}

{% block body %}
<div class="tf-card">
    <div class="tf-card-header">
        <h3><i class="fas fa-comments"></i> Liste des Commentaires <span style="color: var(--tf-gray); font-weight: 400; font-size: 0.9rem;">({{ comments|length }})</span></h3>
        <a href="{{ path('comment_new') }}" class="btn-gold">
            <i class="fas fa-plus"></i> Nouveau Commentaire
        </a>
    </div>

    {# Barre de recherche, tri et filtrage #}
    <form method="get" action="{{ path('comment_index') }}" style="margin-bottom: 1.5rem;">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <input type="text" name="q" value="{{ search }}" class="tf-search" placeholder="Rechercher par contenu ou auteur...">
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.85rem;">Post</label>
                <select name="post" class="tf-search">
                    <option value="">Tous</option>
                    {% for p in posts %}
                        <option value="{{ p.id }}" {{ postId == p.id ~ '' ? 'selected' }}>{{ p.title|length > 25 ? p.title|slice(0, 25) ~ '…' : p.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.85rem;">Auteur</label>
                <select name="auteur" class="tf-search">
                    <option value="">Tous</option>
                    {% for u in auteurs %}
                        <option value="{{ u.id }}" {{ auteur == u.id ~ '' ? 'selected' }}>{{ u.nom }} {{ u.prenom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label style="color: var(--tf-gray); font-size: 0.85rem;">Trier par</label>
                <select name="tri" class="tf-search">
                    <option value="createdAt" {{ tri == 'createdAt' ? 'selected' }}>Date</option>
                    <option value="content" {{ tri == 'content' ? 'selected' }}>Contenu</option>
                </select>
            </div>
            <div class="col-md-1">
                <label style="color: var(--tf-gray); font-size: 0.85rem;">Ordre</label>
                <select name="ordre" class="tf-search">
                    <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Descendant</option>
                    <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Ascendant</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
            </div>
        </div>
        {% if search or postId or auteur or tri != 'createdAt' or ordre != 'DESC' %}
        <div class="mt-2">
            <a href="{{ path('comment_index') }}" style="color: #e07070; font-size: 0.85rem;"><i class="fas fa-times"></i> Réinitialiser</a>
        </div>
        {% endif %}
    </form>

    {% if comments|length > 0 %}
    <div class="tf-grid-cards" id="comment-grid">
        {% include 'comment/_table_body.html.twig' with { comments: comments } %}
    </div>
    {% else %}
    <div class="tf-card-empty">
        <i class="fas fa-comments"></i>
        <p>Aucun commentaire pour le moment</p>
        <a href="{{ path('comment_new') }}" class="btn-gold" style="margin-top: 0.5rem;">
            <i class="fas fa-plus"></i> Ajouter un commentaire
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const grid = document.getElementById('comment-grid');
    if (!form || !grid) return;
    let debounceTimer;

    function fetchComments() {
        const params = new URLSearchParams(new FormData(form)).toString();
        fetch("{{ path('comment_search') }}?" + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => { grid.innerHTML = html; });
    }

    form.querySelectorAll('input.tf-search').forEach(input => {
        input.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(fetchComments, 300);
        });
    });

    form.querySelectorAll('select.tf-search').forEach(sel => {
        sel.addEventListener('change', fetchComments);
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        fetchComments();
    });
});
</script>
{% endblock %}
