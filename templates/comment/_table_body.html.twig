{# Partial pour la grille AJAX des commentaires #}
{% for comment in comments %}
<div class="tf-item-card">
    <div class="tf-item-card-header">
        <div>
            <div class="tf-item-card-title" style="display:flex; align-items:center; gap:0.5rem;">
                <span class="tf-card-avatar" style="width:30px; height:30px; font-size:0.65rem;">{{ comment.author.nom|first|upper }}</span>
                {{ comment.author.nom }} {{ comment.author.prenom }}
            </div>
            <div class="tf-item-card-subtitle">
                <i class="fas fa-newspaper"></i> {{ comment.post.title|length > 40 ? comment.post.title|slice(0, 40) ~ '…' : comment.post.title }}
            </div>
        </div>
    </div>
    <div class="tf-item-card-body" style="display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;">
        {{ comment.content }}
    </div>
    <div class="tf-item-card-meta">
        <span><i class="fas fa-clock"></i> {{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '—' }}</span>
    </div>
    <div class="tf-item-card-actions">
        <a href="{{ path('comment_show', {'id': comment.id}) }}" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i> Voir</a>
        <a href="{{ path('comment_edit', {'id': comment.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
        <form method="post" action="{{ path('comment_delete', {'id': comment.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ (comment.content|length > 30 ? comment.content|slice(0, 30) ~ '...' : comment.content)|e('js') }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
            <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
        </form>
    </div>
</div>
{% else %}
<div class="tf-card-empty">
    <i class="fas fa-comments"></i>
    <p>Aucun commentaire trouvé.</p>
</div>
{% endfor %}
