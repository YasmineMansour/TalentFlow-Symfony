{# Partial pour le tbody AJAX des commentaires #}
{% for comment in comments %}
    <tr>
        <td>{{ comment.id }}</td>
        <td>{{ comment.content|u.truncate(50, '...') }}</td>
        <td>{{ comment.author.nom }} {{ comment.author.prenom }}</td>
        <td>{{ comment.post.title|length > 25 ? comment.post.title|slice(0, 25) ~ '…' : comment.post.title }}</td>
        <td>{{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '' }}</td>
        <td>
            <a href="{{ path('comment_show', {'id': comment.id}) }}" class="btn-table"><i class="fas fa-eye"></i></a>
            <a href="{{ path('comment_edit', {'id': comment.id}) }}" class="btn-table"><i class="fas fa-edit"></i></a>
        </td>
    </tr>
{% else %}
    <tr><td colspan="6" style="text-align:center;color:#888;">Aucun commentaire trouvé.</td></tr>
{% endfor %}
