{% extends 'base_public.html.twig' %}

{% block title %}TalentFlow - Trouvez votre prochain emploi{% endblock %}
{% block meta_description %}TalentFlow est la plateforme de recrutement moderne en Tunisie. Consultez les offres d'emploi, postulez en ligne et trouvez le poste idéal.{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "TalentFlow",
    "url": "{{ app.request.schemeAndHttpHost }}",
    "logo": "{{ app.request.schemeAndHttpHost }}/img/logo.png",
    "description": "Plateforme de recrutement moderne en Tunisie",
    "sameAs": []
}
</script>
{% endblock %}

{% block body %}
{# ==================== HERO ==================== #}
<section class="tf-hero" aria-labelledby="hero-title">
    <h1 id="hero-title">
        Trouvez le poste<br>
        <span class="highlight">qui vous correspond</span>
    </h1>
    <p>Parcourez des centaines d'offres d'emploi, postulez en quelques clics et suivez vos candidatures en temps réel.</p>

    <div class="tf-hero-actions">
        <div class="tf-search-wrapper" data-predictive-search="{{ path('public_offres_search') }}">
            <input type="text" class="tf-search-input" placeholder="Rechercher un poste, une entreprise..." aria-label="Rechercher des offres d'emploi" autocomplete="off">
            <i class="fas fa-search tf-search-icon" aria-hidden="true"></i>
            <div class="tf-search-results" aria-label="Résultats de recherche"></div>
        </div>
    </div>

    <div class="tf-hero-stats" aria-label="Statistiques de la plateforme">
        <div class="tf-hero-stat tf-animate-in">
            <span class="number" aria-label="{{ totalOffres }} offres actives">{{ totalOffres }}</span>
            <span class="label">Offres actives</span>
        </div>
        <div class="tf-hero-stat tf-animate-in">
            <span class="number" aria-label="{{ totalEntreprises }} entreprises">{{ totalEntreprises }}</span>
            <span class="label">Entreprises</span>
        </div>
        <div class="tf-hero-stat tf-animate-in">
            <span class="number">5</span>
            <span class="label">Modules RH</span>
        </div>
    </div>
</section>

{# ==================== OFFRES RÉCENTES ==================== #}
<section class="tf-section" aria-labelledby="offres-title">
    <div class="tf-section-header">
        <h2 id="offres-title">Offres récentes</h2>
        <p>Les dernières opportunités publiées par nos entreprises partenaires</p>
    </div>

    <div class="tf-grid tf-grid-3">
        {% for offre in offresRecentes %}
        <a href="{{ path('public_offre_show', {id: offre.id}) }}" class="tf-offre-card tf-animate-in" style="text-decoration:none; animation-delay: {{ loop.index0 * 0.08 }}s;">
            <div class="offre-title">{{ offre.titre }}</div>
            <div class="offre-company">
                <i class="fas fa-building" aria-hidden="true"></i>
                {{ offre.entreprise ? offre.entreprise.nom : 'Entreprise' }}
            </div>
            <div class="tf-offre-meta">
                <span class="meta-item">
                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                    {{ offre.localisation|default('Non précisé') }}
                </span>
                <span class="meta-item">
                    <i class="fas fa-clock" aria-hidden="true"></i>
                    {{ offre.typeContrat }}
                </span>
                {% if offre.salaireMin or offre.salaireMax %}
                <span class="meta-item">
                    <i class="fas fa-coins" aria-hidden="true"></i>
                    {{ offre.salaireMin }}–{{ offre.salaireMax }} TND
                </span>
                {% endif %}
            </div>
            <div class="tf-offre-tags">
                <span class="tf-tag tf-tag-gold">{{ offre.typeContrat }}</span>
                {% if offre.modeTravail == 'REMOTE' %}
                    <span class="tf-tag tf-tag-green">Télétravail</span>
                {% elseif offre.modeTravail == 'HYBRID' %}
                    <span class="tf-tag tf-tag-blue">Hybride</span>
                {% else %}
                    <span class="tf-tag tf-tag-purple">Présentiel</span>
                {% endif %}
                {% if offre.categorie %}
                    <span class="tf-tag tf-tag-orange">{{ offre.categorie.nom }}</span>
                {% endif %}
            </div>
        </a>
        {% else %}
        <div style="grid-column: 1/-1; text-align:center; padding: 3rem; color: var(--tf-text-muted);">
            <i class="fas fa-briefcase" style="font-size:2.5rem; margin-bottom:1rem; display:block; opacity:0.4;" aria-hidden="true"></i>
            <p>Aucune offre disponible pour le moment</p>
        </div>
        {% endfor %}
    </div>

    {% if offresRecentes|length > 0 %}
    <div style="text-align: center; margin-top: 2rem;">
        <a href="{{ path('public_offres') }}" class="tf-btn tf-btn-outline">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> Voir toutes les offres
        </a>
    </div>
    {% endif %}
</section>

{# ==================== FEATURES ==================== #}
<section class="tf-section" style="background: var(--tf-bg-alt); border-radius: var(--tf-radius-xl); margin: 0 1rem;" aria-labelledby="features-title">
    <div class="tf-section-header">
        <h2 id="features-title">Comment ça marche ?</h2>
        <p>Un processus simple et efficace pour trouver votre emploi idéal</p>
    </div>

    <div class="tf-grid tf-grid-3">
        <div class="tf-card tf-animate-in" style="text-align:center; animation-delay: 0s;">
            <div style="width:60px;height:60px;border-radius:var(--tf-radius-lg);background:var(--tf-gold-bg);color:var(--tf-gold);display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 1rem;">
                <i class="fas fa-search" aria-hidden="true"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:0.5rem;">1. Explorez</h3>
            <p style="color:var(--tf-text-secondary); font-size:0.9rem;">Parcourez les offres d'emploi sans créer de compte. Filtrez par secteur, localisation ou type de contrat.</p>
        </div>
        <div class="tf-card tf-animate-in" style="text-align:center; animation-delay: 0.1s;">
            <div style="width:60px;height:60px;border-radius:var(--tf-radius-lg);background:var(--tf-blue-bg);color:var(--tf-blue);display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 1rem;">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:0.5rem;">2. Postulez</h3>
            <p style="color:var(--tf-text-secondary); font-size:0.9rem;">Créez votre compte candidat et postulez directement depuis l'offre qui vous intéresse.</p>
        </div>
        <div class="tf-card tf-animate-in" style="text-align:center; animation-delay: 0.2s;">
            <div style="width:60px;height:60px;border-radius:var(--tf-radius-lg);background:var(--tf-green-bg);color:var(--tf-green);display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 1rem;">
                <i class="fas fa-check-circle" aria-hidden="true"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:0.5rem;">3. Suivez</h3>
            <p style="color:var(--tf-text-secondary); font-size:0.9rem;">Suivez l'état de vos candidatures, passez vos entretiens et recevez les décisions en temps réel.</p>
        </div>
    </div>
</section>

{# ==================== CTA ==================== #}
{% if not app.user %}
<section class="tf-section" style="text-align:center;" aria-labelledby="cta-title">
    <h2 id="cta-title" style="font-size:1.8rem; font-weight:800; margin-bottom:0.75rem;">Prêt à commencer ?</h2>
    <p style="color:var(--tf-text-secondary); margin-bottom:1.5rem; max-width:500px; margin-left:auto; margin-right:auto;">Créez votre compte gratuitement et accédez à toutes les fonctionnalités de TalentFlow.</p>
    <div class="tf-hero-actions">
        <a href="{{ path('app_register') }}" class="tf-btn tf-btn-gold tf-btn-lg">
            <i class="fas fa-rocket" aria-hidden="true"></i> Créer mon compte
        </a>
        <a href="{{ path('public_offres') }}" class="tf-btn tf-btn-outline tf-btn-lg">
            Voir les offres
        </a>
    </div>
</section>
{% endif %}
{% endblock %}
