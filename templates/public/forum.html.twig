{% extends 'base_public.html.twig' %}

{% block title %}Forum - TalentFlow{% endblock %}
{% block meta_description %}Rejoignez le forum TalentFlow. Posez vos questions, partagez vos expériences et connectez-vous avec la communauté RH.{% endblock %}

{% block body %}
<section class="tf-section" aria-labelledby="forum-title">
    <div class="tf-section-header">
        <h1 id="forum-title" style="font-size:2rem; font-weight:800;">Forum communautaire</h1>
        <p>Échangez avec la communauté TalentFlow, posez des questions et partagez vos expériences</p>
    </div>

    {# ====== RECHERCHE ====== #}
    <form method="get" action="{{ path('public_forum') }}" role="search" aria-label="Rechercher dans le forum" style="margin-bottom:2rem; max-width:500px; margin-left:auto; margin-right:auto;">
        <div class="tf-search-wrapper">
            <input type="text" name="q" value="{{ search }}" class="tf-search-input" placeholder="Rechercher un sujet..." aria-label="Recherche forum" autocomplete="off">
            <i class="fas fa-search tf-search-icon" aria-hidden="true"></i>
        </div>
    </form>

    {# ====== POSTS ====== #}
    <div style="max-width:800px; margin:0 auto;">
        {% for post in posts %}
        <article class="tf-card tf-animate-in" style="margin-bottom:1rem; animation-delay:{{ loop.index0 * 0.04 }}s;">
            <div style="display:flex; gap:1rem; align-items:flex-start;">
                {# Votes #}
                <div style="text-align:center; flex-shrink:0; min-width:50px;">
                    <div style="font-size:1.3rem; font-weight:800; color:var(--tf-gold);">{{ post.upvotes|default(0) }}</div>
                    <div style="font-size:0.7rem; color:var(--tf-text-muted); text-transform:uppercase;">votes</div>
                </div>

                <div style="flex:1; min-width:0;">
                    <h3 style="font-size:1.05rem; font-weight:700; margin-bottom:0.35rem;">
                        <a href="{{ path('post_show', {id: post.id}) }}" style="color:var(--tf-text); text-decoration:none; transition:color 0.2s;">
                            {{ post.title }}
                        </a>
                    </h3>
                    {% if post.content %}
                    <p style="color:var(--tf-text-secondary); font-size:0.85rem; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-bottom:0.5rem;">
                        {{ post.content|striptags|slice(0, 200) }}{{ post.content|length > 200 ? '...' }}
                    </p>
                    {% endif %}
                    <div style="display:flex; gap:1rem; font-size:0.78rem; color:var(--tf-text-muted);">
                        <span><i class="fas fa-user" aria-hidden="true"></i> {{ post.author ? post.author.nom ~ ' ' ~ post.author.prenom : 'Anonyme' }}</span>
                        <span><i class="fas fa-clock" aria-hidden="true"></i> {{ post.createdAt ? post.createdAt|date('d/m/Y') : '—' }}</span>
                        <span><i class="fas fa-comments" aria-hidden="true"></i> {{ post.commentCount|default(0) }} commentaire{{ post.commentCount|default(0) > 1 ? 's' }}</span>
                    </div>
                </div>
            </div>
        </article>
        {% else %}
        <div style="text-align:center; padding:3rem; color:var(--tf-text-muted);">
            <i class="fas fa-comments" style="font-size:2.5rem; margin-bottom:1rem; display:block; opacity:0.4;" aria-hidden="true"></i>
            <p style="font-size:1.1rem;">Aucun post pour le moment</p>
            {% if app.user %}
                <a href="{{ path('post_new') }}" class="tf-btn tf-btn-gold" style="margin-top:1rem;"><i class="fas fa-plus" aria-hidden="true"></i> Créer le premier post</a>
            {% else %}
                <p style="margin-top:0.5rem;"><a href="{{ path('app_login') }}" style="color:var(--tf-gold);">Connectez-vous</a> pour créer un post</p>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    {% if app.user and posts|length > 0 %}
    <div style="text-align:center; margin-top:2rem;">
        <a href="{{ path('post_new') }}" class="tf-btn tf-btn-gold">
            <i class="fas fa-plus" aria-hidden="true"></i> Nouveau post
        </a>
    </div>
    {% endif %}
</section>
{% endblock %}
