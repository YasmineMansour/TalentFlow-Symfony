{% extends 'base_public.html.twig' %}

{% block title %}{{ offre.titre }} - TalentFlow{% endblock %}
{% block meta_description %}{{ offre.description|striptags|slice(0, 160) }}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "JobPosting",
    "title": {{ offre.titre|json_encode|raw }},
    "description": {{ (offre.description|default(''))|json_encode|raw }},
    "employmentType": {{ offre.typeContrat|json_encode|raw }},
    "jobLocation": {
        "@type": "Place",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": {{ (offre.localisation|default('Tunisie'))|json_encode|raw }},
            "addressCountry": "TN"
        }
    },
    {% if offre.entreprise %}
    "hiringOrganization": {
        "@type": "Organization",
        "name": {{ offre.entreprise.nom|json_encode|raw }}
    },
    {% endif %}
    {% if offre.salaireMin and offre.salaireMax %}
    "baseSalary": {
        "@type": "MonetaryAmount",
        "currency": "TND",
        "value": {
            "@type": "QuantitativeValue",
            "minValue": {{ offre.salaireMin }},
            "maxValue": {{ offre.salaireMax }},
            "unitText": "MONTH"
        }
    },
    {% endif %}
    "url": "{{ url('public_offre_show', {id: offre.id}) }}"
}
</script>
{% endblock %}

{% block body %}
<section class="tf-section" style="max-width:900px;">
    <div style="margin-bottom:1.5rem;">
        <a href="{{ path('public_offres') }}" style="color:var(--tf-text-muted); text-decoration:none; font-size:0.9rem; display:inline-flex; align-items:center; gap:0.4rem; transition: color 0.2s;">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> {{ 'public.offer.back_to_offers'|trans }}
        </a>
    </div>

    <article class="tf-card" style="padding:2rem;" itemscope itemtype="https://schema.org/JobPosting">
        <header>
            <h1 itemprop="title" style="font-size:1.8rem; font-weight:800; margin-bottom:0.5rem;">{{ offre.titre }}</h1>
            {% if offre.entreprise %}
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem; color:var(--tf-text-secondary); font-size:1rem;">
                {% if offre.entreprise.logo %}
                    <img src="{{ asset('uploads/logos/' ~ offre.entreprise.logo) }}" alt="" style="width:24px;height:24px;border-radius:6px;object-fit:cover;">
                {% else %}
                    <i class="fas fa-building" aria-hidden="true"></i>
                {% endif %}
                <span itemprop="hiringOrganization" itemscope itemtype="https://schema.org/Organization">
                    <span itemprop="name">{{ offre.entreprise.nom }}</span>
                </span>
            </div>
            {% endif %}

            <div class="tf-offre-tags" style="margin-bottom:1.5rem;">
                <span class="tf-tag tf-tag-gold">{{ offre.typeContrat }}</span>
                {% if offre.modeTravail == 'REMOTE' %}
                    <span class="tf-tag tf-tag-green">{{ 'public.mode.remote'|trans }}</span>
                {% elseif offre.modeTravail == 'HYBRID' %}
                    <span class="tf-tag tf-tag-blue">{{ 'public.mode.hybrid'|trans }}</span>
                {% else %}
                    <span class="tf-tag tf-tag-purple">{{ 'public.mode.onsite'|trans }}</span>
                {% endif %}
                {% if offre.categorie %}
                    <span class="tf-tag tf-tag-orange">{{ offre.categorie.nom }}</span>
                {% endif %}
            </div>
        </header>

        {# ====== INFOS CLÉS ====== #}
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:1rem; margin-bottom:2rem; padding:1.25rem; background:var(--tf-bg-alt); border-radius:var(--tf-radius);">
            <div>
                <div style="font-size:0.78rem; color:var(--tf-text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.25rem;">
                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{ 'public.offer.location'|trans }}
                </div>
                <div style="font-weight:600;">{{ offre.localisation|default('public.home.location_unspecified'|trans) }}</div>
            </div>
            <div>
                <div style="font-size:0.78rem; color:var(--tf-text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.25rem;">
                    <i class="fas fa-file-contract" aria-hidden="true"></i> {{ 'public.offer.contract'|trans }}
                </div>
                <div style="font-weight:600;">{{ offre.typeContrat }}</div>
            </div>
            <div>
                <div style="font-size:0.78rem; color:var(--tf-text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.25rem;">
                    <i class="fas fa-laptop-house" aria-hidden="true"></i> {{ 'public.offer.mode'|trans }}
                </div>
                <div style="font-weight:600;">
                    {% if offre.modeTravail == 'REMOTE' %}{{ 'public.mode.remote'|trans }}
                    {% elseif offre.modeTravail == 'HYBRID' %}{{ 'public.mode.hybrid'|trans }}
                    {% else %}{{ 'public.mode.onsite'|trans }}{% endif %}
                </div>
            </div>
            {% if offre.salaireMin or offre.salaireMax %}
            <div>
                <div style="font-size:0.78rem; color:var(--tf-text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.25rem;">
                    <i class="fas fa-coins" aria-hidden="true"></i> {{ 'public.offer.salary'|trans }}
                </div>
                <div style="font-weight:600; color:var(--tf-gold);">{{ offre.salaireMin }} – {{ offre.salaireMax }} TND</div>
            </div>
            {% endif %}
        </div>

        {# ====== DESCRIPTION ====== #}
        {% if offre.description %}
        <div style="margin-bottom:2rem;">
            <h2 style="font-size:1.15rem; font-weight:700; margin-bottom:0.75rem; color:var(--tf-text);">{{ 'public.offer.description_title'|trans }}</h2>
            <div itemprop="description" style="color:var(--tf-text-secondary); line-height:1.8; white-space:pre-line;">{{ offre.description }}</div>
        </div>
        {% endif %}

        {% if offre.localisation %}
        <div style="margin-bottom:2rem;">
            <h2 style="font-size:1.15rem; font-weight:700; margin-bottom:0.75rem; color:var(--tf-text);">
                <i class="fas fa-map-marked-alt" aria-hidden="true"></i> {{ 'public.offer.map_title'|trans }}
            </h2>
            <div style="border:1px solid var(--tf-border); border-radius:12px; overflow:hidden; min-height:320px;">
                <iframe
                    src="https://www.google.com/maps?q={{ (offre.localisation ~ ', Tunisie')|url_encode }}&output=embed"
                    style="width:100%; height:320px; border:0;"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="{{ 'public.offer.map_iframe_title'|trans }}">
                </iframe>
            </div>
        </div>
        {% endif %}

        {# ====== AVANTAGES ====== #}
        {% if offre.avantages is defined and offre.avantages|length > 0 %}
        <div style="margin-bottom:2rem;">
            <h2 style="font-size:1.15rem; font-weight:700; margin-bottom:0.75rem; color:var(--tf-text);">{{ 'public.offer.benefits_title'|trans }}</h2>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                {% for avantage in offre.avantages %}
                <span class="tf-tag tf-tag-green"><i class="fas fa-check" aria-hidden="true"></i> {{ avantage.nom }}</span>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# ====== CTA ====== #}
        <div style="padding-top:1.5rem; border-top:1px solid var(--tf-border); display:flex; gap:1rem; flex-wrap:wrap; align-items:center;">
            {% if app.user and is_granted('ROLE_CANDIDAT') %}
                <a href="{{ path('app_candidature_new', {offre: offre.id}) }}" class="tf-btn tf-btn-gold tf-btn-lg">
                    <i class="fas fa-paper-plane" aria-hidden="true"></i> {{ 'public.offer.apply_now'|trans }}
                </a>
            {% elseif not app.user %}
                <a href="{{ path('app_login') }}" class="tf-btn tf-btn-gold tf-btn-lg">
                    <i class="fas fa-sign-in-alt" aria-hidden="true"></i> {{ 'public.offer.login_to_apply'|trans }}
                </a>
                <a href="{{ path('app_register') }}" class="tf-btn tf-btn-outline">
                    <i class="fas fa-user-plus" aria-hidden="true"></i> {{ 'public.offer.create_account'|trans }}
                </a>
            {% endif %}
            <a href="{{ path('public_offres') }}" class="tf-btn tf-btn-ghost">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> {{ 'public.offer.other_offers'|trans }}
            </a>
        </div>
    </article>
</section>
{% endblock %}
