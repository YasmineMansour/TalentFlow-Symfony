{% extends 'base_public.html.twig' %}

{% block title %}Offres d'emploi - TalentFlow{% endblock %}
{% block meta_description %}Consultez toutes les offres d'emploi disponibles sur TalentFlow. Filtrez par catégorie, type de contrat et localisation.{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Offres d'emploi TalentFlow",
    "numberOfItems": {{ offres|length }},
    "itemListElement": [
        {% for offre in offres %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "item": {
                "@type": "JobPosting",
                "title": {{ offre.titre|json_encode|raw }},
                "description": {{ (offre.description|default(''))|json_encode|raw }},
                "employmentType": {{ offre.typeContrat|json_encode|raw }},
                "jobLocation": {
                    "@type": "Place",
                    "address": {{ (offre.localisation|default('Tunisie'))|json_encode|raw }}
                },
                {% if offre.entreprise %}
                "hiringOrganization": {
                    "@type": "Organization",
                    "name": {{ offre.entreprise.nom|json_encode|raw }}
                },
                {% endif %}
                {% if offre.salaireMin and offre.salaireMax %}
                "baseSalary": {
                    "@type": "MonetaryAmount",
                    "currency": "TND",
                    "value": {
                        "@type": "QuantitativeValue",
                        "minValue": {{ offre.salaireMin }},
                        "maxValue": {{ offre.salaireMax }},
                        "unitText": "MONTH"
                    }
                },
                {% endif %}
                "url": "{{ url('public_offre_show', {id: offre.id}) }}"
            }
        }{{ not loop.last ? ',' }}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
<section class="tf-section" aria-labelledby="offres-page-title">
    <div class="tf-section-header">
        <h1 id="offres-page-title" style="font-size:2rem; font-weight:800;">Offres d'emploi</h1>
        <p>{{ offres|length }} offre{{ offres|length > 1 ? 's' }} disponible{{ offres|length > 1 ? 's' }}</p>
    </div>

    {# ====== FILTRES ====== #}
    <form method="get" action="{{ path('public_offres') }}" role="search" aria-label="Filtrer les offres" style="margin-bottom: 2rem;">
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:flex-end;">
            <div class="tf-search-wrapper" data-predictive-search="{{ path('public_offres_search') }}" style="flex:2; min-width:260px;">
                <input type="text" name="q" value="{{ search }}" class="tf-search-input" placeholder="Poste, entreprise, mot-clé..." aria-label="Recherche" autocomplete="off">
                <i class="fas fa-search tf-search-icon" aria-hidden="true"></i>
                <div class="tf-search-results" aria-label="Suggestions"></div>
            </div>
            <div style="flex:1; min-width:160px;">
                <label class="tf-label" for="filter-cat">Catégorie</label>
                <select name="categorie" id="filter-cat" class="tf-select">
                    <option value="">Toutes</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' }}>{{ cat.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="tf-label" for="filter-type">Contrat</label>
                <select name="type" id="filter-type" class="tf-select">
                    <option value="">Tous</option>
                    {% for t in ['CDI', 'CDD', 'Stage', 'Freelance', 'Alternance'] %}
                        <option value="{{ t }}" {{ typeContrat == t ? 'selected' }}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="tf-label" for="filter-loc">Localisation</label>
                <input type="text" name="localisation" id="filter-loc" value="{{ localisation }}" class="tf-input" placeholder="Ville...">
            </div>
            <button type="submit" class="tf-btn tf-btn-gold">
                <i class="fas fa-filter" aria-hidden="true"></i> Filtrer
            </button>
        </div>
        {% if search or categorieId or typeContrat or localisation %}
        <div style="margin-top:0.75rem;">
            <a href="{{ path('public_offres') }}" style="color:var(--tf-red); font-size:0.85rem; text-decoration:none;">
                <i class="fas fa-times" aria-hidden="true"></i> Réinitialiser les filtres
            </a>
        </div>
        {% endif %}
    </form>

    {# ====== LISTE DES OFFRES ====== #}
    <div class="tf-grid tf-grid-2">
        {% for offre in offres %}
        <a href="{{ path('public_offre_show', {id: offre.id}) }}" class="tf-offre-card tf-animate-in" style="text-decoration:none; animation-delay: {{ loop.index0 * 0.04 }}s;">
            <div class="offre-title">{{ offre.titre }}</div>
            <div class="offre-company">
                <i class="fas fa-building" aria-hidden="true"></i>
                {{ offre.entreprise ? offre.entreprise.nom : '—' }}
            </div>
            <div class="tf-offre-meta">
                <span class="meta-item"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{ offre.localisation|default('—') }}</span>
                <span class="meta-item"><i class="fas fa-file-contract" aria-hidden="true"></i> {{ offre.typeContrat }}</span>
                {% if offre.salaireMin or offre.salaireMax %}
                <span class="meta-item"><i class="fas fa-coins" aria-hidden="true"></i> {{ offre.salaireMin }}–{{ offre.salaireMax }} TND</span>
                {% endif %}
            </div>
            <div class="tf-offre-tags">
                <span class="tf-tag tf-tag-gold">{{ offre.typeContrat }}</span>
                {% if offre.modeTravail == 'REMOTE' %}
                    <span class="tf-tag tf-tag-green">Télétravail</span>
                {% elseif offre.modeTravail == 'HYBRID' %}
                    <span class="tf-tag tf-tag-blue">Hybride</span>
                {% else %}
                    <span class="tf-tag tf-tag-purple">Présentiel</span>
                {% endif %}
                {% if offre.categorie %}
                    <span class="tf-tag tf-tag-orange">{{ offre.categorie.nom }}</span>
                {% endif %}
            </div>
            {% if offre.description %}
            <p style="color:var(--tf-text-secondary); font-size:0.85rem; margin-top:0.75rem; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                {{ offre.description|striptags|slice(0, 160) }}{{ offre.description|length > 160 ? '...' }}
            </p>
            {% endif %}
        </a>
        {% else %}
        <div style="grid-column:1/-1; text-align:center; padding:3rem; color:var(--tf-text-muted);">
            <i class="fas fa-search" style="font-size:2.5rem; margin-bottom:1rem; display:block; opacity:0.4;" aria-hidden="true"></i>
            <p style="font-size:1.1rem;">Aucune offre ne correspond à vos critères</p>
            <a href="{{ path('public_offres') }}" class="tf-btn tf-btn-outline" style="margin-top:1rem;">Voir toutes les offres</a>
        </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
