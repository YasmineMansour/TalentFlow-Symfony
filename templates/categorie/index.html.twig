{% extends 'base.html.twig' %}

{% block title %}Catégories - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title"><i class="fas fa-tags"></i> Catégories</h2>
    <a href="{{ path('categorie_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle catégorie</a>
</div>

<div class="tf-card mb-4">
    <form method="get" action="{{ path('categorie_index') }}" class="tf-form">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <input type="text" name="q" value="{{ search }}" class="form-control" placeholder="Rechercher une catégorie...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Trier par</label>
                <select name="tri" class="form-select">
                    <option value="id" {{ tri == 'id' ? 'selected' }}>ID</option>
                    <option value="nom" {{ tri == 'nom' ? 'selected' }}>Nom</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Ordre</label>
                <select name="ordre" class="form-select">
                    <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Ascendant</option>
                    <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Descendant</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
            </div>
        </div>
    </form>
</div>

{% for flash in app.flashes('success') %}
    <div class="tf-flash">{{ flash }}</div>
{% endfor %}

<div class="tf-card">
    {% if categorieData|length > 0 %}
    <div class="tf-grid-cards">
        {% for item in categorieData %}
        <div class="tf-item-card">
            <div class="tf-item-card-header">
                <div>
                    <div class="tf-item-card-title">{{ item.categorie.nom }}</div>
                    <div class="tf-item-card-subtitle" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                        {{ item.categorie.description|default('Aucune description') }}
                    </div>
                </div>
            </div>
            <div class="tf-item-card-tags">
                <span class="tf-tag-sm tf-tag-blue"><i class="fas fa-briefcase"></i> {{ item.categorie.offres|length }} offre{{ item.categorie.offres|length > 1 ? 's' : '' }}</span>

                {% if item.popularite == 'Très populaire' %}
                    <span class="tf-tag-sm tf-tag-gold"><i class="fas fa-fire"></i> {{ item.popularite }}</span>
                {% elseif item.popularite == 'Populaire' %}
                    <span class="tf-tag-sm tf-tag-orange"><i class="fas fa-star"></i> {{ item.popularite }}</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-gray"><i class="fas fa-minus"></i> {{ item.popularite }}</span>
                {% endif %}

                {% if item.complete %}
                    <span class="tf-tag-sm tf-tag-green"><i class="fas fa-check-circle"></i> Complet</span>
                {% else %}
                    <span class="tf-tag-sm tf-tag-yellow"><i class="fas fa-exclamation-triangle"></i> Incomplet</span>
                {% endif %}
            </div>
            <div class="tf-item-card-meta">
                <span>
                    {% if item.tauxActivite == 'Très active' %}
                        <span style="color: #2ecc71;"><i class="fas fa-bolt"></i> {{ item.tauxActivite }}</span>
                    {% elseif item.tauxActivite == 'Active' %}
                        <span style="color: var(--tf-gold);"><i class="fas fa-bolt"></i> {{ item.tauxActivite }}</span>
                    {% elseif item.tauxActivite == 'Peu active' %}
                        <span style="color: #e67e22;"><i class="fas fa-bolt"></i> {{ item.tauxActivite }}</span>
                    {% else %}
                        <span style="color: var(--tf-gray);"><i class="fas fa-moon"></i> {{ item.tauxActivite }}</span>
                    {% endif %}
                </span>
            </div>
            <div class="tf-item-card-actions">
                <a href="{{ path('categorie_show', {id: item.categorie.id}) }}" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i></a>
                <a href="{{ path('categorie_edit', {id: item.categorie.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                <form method="post" action="{{ path('categorie_delete', {id: item.categorie.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.categorie.nom|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.categorie.id) }}">
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="tf-card-empty">
        <i class="fas fa-tags"></i>
        <p>Aucune catégorie trouvée.</p>
    </div>
    {% endif %}
</div>
{% endblock %}
