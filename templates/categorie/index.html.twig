{% extends 'base.html.twig' %}

{% block title %}Catégories - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="tf-title"><i class="fas fa-tags"></i> Catégories</h2>
    <a href="{{ path('categorie_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle catégorie</a>
</div>

<div class="tf-card mb-4">
    <form method="get" action="{{ path('categorie_index') }}" class="row g-3 align-items-end">
        <div class="col-md-4">
            <input type="text" name="q" value="{{ search }}" class="tf-search" placeholder="Rechercher une catégorie...">
        </div>
        <div class="col-md-3">
            <label style="color: var(--tf-gray); font-size: 0.85rem;">Trier par</label>
            <select name="tri" class="tf-search">
                <option value="id" {{ tri == 'id' ? 'selected' }}>ID</option>
                <option value="nom" {{ tri == 'nom' ? 'selected' }}>Nom</option>
            </select>
        </div>
        <div class="col-md-3">
            <label style="color: var(--tf-gray); font-size: 0.85rem;">Ordre</label>
            <select name="ordre" class="tf-search">
                <option value="ASC" {{ ordre == 'ASC' ? 'selected' }}>Ascendant</option>
                <option value="DESC" {{ ordre == 'DESC' ? 'selected' }}>Descendant</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-gold w-100"><i class="fas fa-search"></i> Filtrer</button>
        </div>
    </form>
</div>

{% for flash in app.flashes('success') %}
    <div class="tf-flash">{{ flash }}</div>
{% endfor %}

<div class="tf-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--tf-gold);">
                    <th>#</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Offres</th>
                    <th>Popularité</th>
                    <th>Taux d'activité</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in categorieData %}
                <tr>
                    <td>{{ item.categorie.id }}</td>
                    <td style="color: var(--tf-gold); font-weight: 600;">{{ item.categorie.nom }}</td>
                    <td style="color: var(--tf-gray);">{{ item.categorie.description|default('—')|length > 50 ? item.categorie.description|slice(0, 50) ~ '…' : item.categorie.description|default('—') }}</td>
                    <td><span class="badge" style="background: var(--tf-dark-blue);">{{ item.categorie.offres|length }}</span></td>
                    <td>
                        {% if item.popularite == 'Très populaire' %}
                            <span class="badge bg-success"><i class="fas fa-fire"></i> {{ item.popularite }}</span>
                        {% elseif item.popularite == 'Populaire' %}
                            <span class="badge" style="background: var(--tf-dark-blue);"><i class="fas fa-star"></i> {{ item.popularite }}</span>
                        {% else %}
                            <span class="badge bg-secondary"><i class="fas fa-minus"></i> {{ item.popularite }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.tauxActivite == 'Très active' %}
                            <span style="color: #2ecc71;"><i class="fas fa-bolt"></i> {{ item.tauxActivite }}</span>
                        {% elseif item.tauxActivite == 'Active' %}
                            <span style="color: var(--tf-gold);"><i class="fas fa-bolt"></i> {{ item.tauxActivite }}</span>
                        {% elseif item.tauxActivite == 'Peu active' %}
                            <span style="color: #e67e22;"><i class="fas fa-bolt"></i> {{ item.tauxActivite }}</span>
                        {% else %}
                            <span style="color: var(--tf-gray);"><i class="fas fa-moon"></i> {{ item.tauxActivite }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.complete %}
                            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Complet</span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Incomplet</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('categorie_show', {id: item.categorie.id}) }}" class="btn-outline-gold" style="padding: 4px 10px; font-size: 0.8rem;"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('categorie_edit', {id: item.categorie.id}) }}" class="btn-gold" style="padding: 4px 10px; font-size: 0.8rem;"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('categorie_delete', {id: item.categorie.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, '{{ item.categorie.nom|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.categorie.id) }}">
                                <button class="btn-danger-tf" style="padding: 4px 10px; font-size: 0.8rem;"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center" style="color: var(--tf-gray); padding: 2rem;">
                        <i class="fas fa-folder-open fa-2x mb-2" style="display: block;"></i>
                        Aucune catégorie trouvée.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
