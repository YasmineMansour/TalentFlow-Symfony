{% extends 'base.html.twig' %}

{% block title %}Catégories - TalentFlow{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-tags"></i> Liste des Catégories</h1>
    <a href="{{ path('categorie_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle Catégorie
    </a>
</div>

<form method="get" action="{{ path('categorie_index') }}" class="mb-4">
    <div class="card">
        <div class="card-body">
            <div class="input-group mb-3">
                <input type="text" name="q" class="form-control" placeholder="Rechercher par nom..." value="{{ search }}">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="bi bi-search"></i> Rechercher
                </button>
                {% if search or tri != 'id' %}
                <a href="{{ path('categorie_index') }}" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i> Réinitialiser
                </a>
                {% endif %}
            </div>

            <div class="row">
                <div class="col-md-6">
                    <label class="form-label fw-bold"><i class="bi bi-sort-down"></i> Trier par</label>
                    <select name="tri" class="form-select" onchange="this.form.submit()">
                        <option value="id" {{ tri == 'id' ? 'selected' : '' }}>Date (par défaut)</option>
                        <option value="nom" {{ tri == 'nom' ? 'selected' : '' }}>Nom</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold"><i class="bi bi-arrow-down-up"></i> Ordre</label>
                    <select name="ordre" class="form-select" onchange="this.form.submit()">
                        <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                        <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>Croissant</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</form>

{% if categorieData is empty %}
    <div class="alert alert-info">Aucune catégorie trouvée.</div>
{% else %}
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Offres</th>
                <th>Popularité</th>
                <th>Taux d'activité</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for item in categorieData %}
                <tr>
                    <td>{{ item.categorie.id }}</td>
                    <td>
                        <a href="{{ path('categorie_show', {id: item.categorie.id}) }}">{{ item.categorie.nom }}</a>
                        {% if not item.complete %}
                            <span class="badge bg-warning text-dark" title="Catégorie incomplète">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        {% endif %}
                    </td>
                    <td>{{ item.categorie.description|default('-')|length > 50 ? item.categorie.description|slice(0, 50) ~ '...' : item.categorie.description|default('-') }}</td>
                    <td><span class="badge bg-primary">{{ item.categorie.offres|length }}</span></td>
                    <td>
                        {% if item.popularite == 'Très populaire' %}
                            <span class="badge bg-success"><i class="bi bi-star-fill"></i> {{ item.popularite }}</span>
                        {% elseif item.popularite == 'Populaire' %}
                            <span class="badge bg-info text-dark"><i class="bi bi-star-half"></i> {{ item.popularite }}</span>
                        {% elseif item.popularite == 'Peu populaire' %}
                            <span class="badge bg-secondary"><i class="bi bi-star"></i> {{ item.popularite }}</span>
                        {% else %}
                            <span class="text-muted">{{ item.popularite }}</span>
                        {% endif %}
                    </td>
                    <td>{{ item.tauxActivite }}</td>
                    <td>
                        <a href="{{ path('categorie_edit', {id: item.categorie.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('categorie_delete', {id: item.categorie.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette catégorie ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.categorie.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
