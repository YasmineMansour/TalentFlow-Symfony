{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie - TalentFlow{% endblock %}

{% block body %}
<h2 class="tf-title"><i class="fas fa-plus-circle"></i> Nouvelle catégorie</h2>

<div class="tf-card" style="max-width: 700px;">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'tf-form', 'onsubmit': "if(!this.dataset.confirmed){event.preventDefault(); confirmFormSubmit(this, 'create', 'cette catégorie');}" }}) }}

        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-gold"><i class="fas fa-save"></i> Créer</button>
            <a href="{{ path('categorie_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
