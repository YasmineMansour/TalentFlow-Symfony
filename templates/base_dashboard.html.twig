<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TalentFlow - Dashboard{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>💼</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
        <style>
            :root {
                --tf-midnight: #1a1a2e;
                --tf-navy: #16213e;
                --tf-dark-blue: #0f3460;
                --tf-gold: #d4a843;
                --tf-gold-light: #e8c96d;
                --tf-gold-dark: #b8922f;
                --tf-white: #f5f5f5;
                --tf-gray: #a0a0b0;
                --tf-card-bg: #1e2a3a;
                --tf-border: #2a3a4e;
                --tf-body-bg: #1a1a2e;
                --tf-text: #f5f5f5;
                --tf-text-muted: #a0a0b0;
                --sidebar-width: 260px;
            }

            /* ── Light mode overrides ── */
            body.light-mode {
                --tf-midnight: #f8f5f0;
                --tf-navy: #ffffff;
                --tf-dark-blue: #e8e4de;
                --tf-gold: #2563eb;
                --tf-gold-light: #3b82f6;
                --tf-gold-dark: #1d4ed8;
                --tf-white: #1c1e21;
                --tf-gray: #65676b;
                --tf-card-bg: #ffffff;
                --tf-border: #dddfe2;
                --tf-body-bg: #f8f5f0;
                --tf-text: #1c1e21;
                --tf-text-muted: #65676b;
            }
            body.light-mode .tf-sidebar {
                background: linear-gradient(180deg, #ffffff 0%, #f7f8fa 100%);
            }
            body.light-mode .tf-sidebar-brand a { color: #2563eb; }
            body.light-mode .tf-sidebar-nav a:hover { background: rgba(37,99,235,0.06); color: #2563eb; }
            body.light-mode .tf-sidebar-nav a.active { background: rgba(37,99,235,0.1); color: #2563eb; }
            body.light-mode .tf-topbar { background: #ffffff; border-color: #dddfe2; }
            body.light-mode .tf-topbar-left h1 { color: #1c1e21; }
            body.light-mode .badge-admin { background: rgba(37,99,235,0.15); color: #2563eb; }
            body.light-mode .btn-gold { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #ffffff; }
            body.light-mode .btn-gold:hover { color: #ffffff; }
            body.light-mode .btn-outline-gold { border-color: #2563eb; color: #2563eb; }
            body.light-mode .btn-outline-gold:hover { background: rgba(37,99,235,0.08); }
            body.light-mode .tf-avatar-sm { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
            body.light-mode .tf-card-header h3 { color: #2563eb; }

            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--tf-body-bg);
                color: var(--tf-text);
                min-height: 100vh;
            }

            /* ── No-sidebar layout (non-admin) ── */
            body.no-sidebar .tf-topbar { left: 0; }
            body.no-sidebar .tf-main { margin-left: 0; }

            .tf-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: var(--sidebar-width);
                height: 100vh;
                background: linear-gradient(180deg, var(--tf-navy) 0%, #0d1b2a 100%);
                border-right: 1px solid var(--tf-border);
                z-index: 1000;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
            }

            .tf-sidebar-brand {
                padding: 1.5rem 1.2rem;
                border-bottom: 1px solid var(--tf-border);
                text-align: center;
            }
            .tf-sidebar-brand a {
                font-size: 1.6rem;
                font-weight: 800;
                color: var(--tf-gold);
                text-decoration: none;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.6rem;
            }
            .tf-sidebar-brand small {
                display: block;
                color: var(--tf-gray);
                font-size: 0.7rem;
                font-weight: 400;
                margin-top: 0.3rem;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            .tf-sidebar-section {
                padding: 1rem 0.8rem 0.3rem;
                font-size: 0.65rem;
                font-weight: 700;
                color: var(--tf-gray);
                text-transform: uppercase;
                letter-spacing: 1.5px;
            }

            .tf-sidebar-nav {
                list-style: none;
                padding: 0 0.6rem;
                flex: 1;
            }
            .tf-sidebar-nav li { margin-bottom: 2px; }
            .tf-sidebar-nav a {
                display: flex;
                align-items: center;
                gap: 0.8rem;
                padding: 0.7rem 1rem;
                color: var(--tf-gray);
                text-decoration: none;
                border-radius: 8px;
                font-weight: 500;
                font-size: 0.9rem;
                transition: all 0.2s;
            }
            .tf-sidebar-nav a:hover {
                background: rgba(212, 168, 67, 0.08);
                color: var(--tf-gold);
            }
            .tf-sidebar-nav a.active {
                background: rgba(212, 168, 67, 0.15);
                color: var(--tf-gold);
                font-weight: 600;
            }
            .tf-sidebar-nav a i { width: 20px; text-align: center; font-size: 0.95rem; }

            .tf-sidebar-footer {
                padding: 1rem;
                border-top: 1px solid var(--tf-border);
            }
            .tf-sidebar-footer .user-info {
                display: flex;
                align-items: center;
                gap: 0.7rem;
                padding: 0.5rem;
            }
            .tf-sidebar-footer .tf-avatar-sm {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 0.8rem;
                flex-shrink: 0;
            }
            .tf-sidebar-footer .user-details { overflow: hidden; }
            .tf-sidebar-footer .user-name {
                font-weight: 600;
                font-size: 0.85rem;
                color: var(--tf-white);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .tf-sidebar-footer .user-role { font-size: 0.7rem; color: var(--tf-gold); }

            .tf-topbar {
                position: fixed;
                top: 0;
                left: var(--sidebar-width);
                right: 0;
                height: 60px;
                background: var(--tf-card-bg);
                border-bottom: 1px solid var(--tf-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 2rem;
                z-index: 999;
            }
            .tf-topbar-left { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }
            .tf-topbar-left h1 { font-size: 1.1rem; font-weight: 600; color: var(--tf-white); margin: 0; white-space: nowrap; }
            .tf-topbar-nav { display: flex; align-items: center; gap: 0.15rem; margin-left: 0.4rem; }
            .tf-topbar-nav a {
                display: flex; align-items: center; gap: 0.4rem;
                padding: 0.45rem 0.85rem; border-radius: 8px; font-size: 0.82rem;
                font-weight: 600; color: var(--tf-gray); text-decoration: none;
                transition: all 0.2s; white-space: nowrap;
            }
            .tf-topbar-nav a:hover { background: rgba(212,168,67,0.08); color: var(--tf-gold); }
            .tf-topbar-nav a.active { color: var(--tf-gold); background: rgba(212,168,67,0.12); }
            .tf-topbar-nav a i { font-size: 0.9rem; }
            body.light-mode .tf-topbar-nav a { color: #65676b; }
            body.light-mode .tf-topbar-nav a:hover { background: rgba(37,99,235,0.06); color: #2563eb; }
            body.light-mode .tf-topbar-nav a.active { color: #2563eb; background: rgba(37,99,235,0.1); }
            .tf-topbar-sep { width: 1px; height: 24px; background: var(--tf-border); margin: 0 0.3rem; flex-shrink: 0; }
            body.light-mode .tf-topbar-sep { background: #dddfe2; }
            .tf-topbar-center { flex: 1; display: flex; align-items: center; justify-content: flex-end; padding: 0 0.8rem; min-width: 0; position: relative; }
            .tf-topbar-right { display: flex; align-items: center; gap: 1.2rem; flex-shrink: 0; }
            .tf-topbar-right .top-user { display: flex; align-items: center; gap: 0.6rem; color: var(--tf-white); font-size: 0.9rem; }
            .tf-topbar-right .tf-avatar-sm {
                width: 34px; height: 34px; border-radius: 50%;
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight); display: flex; align-items: center; justify-content: center;
                font-weight: 700; font-size: 0.75rem;
            }
            .tf-topbar-right a {
                color: var(--tf-gray); text-decoration: none; font-size: 0.85rem;
                transition: color 0.2s; display: flex; align-items: center; gap: 0.3rem;
            }
            .tf-topbar-right a:hover { color: #e74c3c; }

            /* Theme toggle */
            .theme-toggle {
                background: none; border: 1px solid var(--tf-border); color: var(--tf-gray);
                width: 36px; height: 36px; border-radius: 50%; cursor: pointer;
                display: flex; align-items: center; justify-content: center;
                font-size: 1rem; transition: all 0.25s;
            }
            .theme-toggle:hover { border-color: var(--tf-gold); color: var(--tf-gold); background: rgba(212,168,67,0.08); }
            body.light-mode .theme-toggle { border-color: #dddfe2; color: #65676b; }
            body.light-mode .theme-toggle:hover { border-color: #2563eb; color: #2563eb; }

            .tf-main {
                margin-left: var(--sidebar-width);
                margin-top: 60px;
                padding: 2rem;
                min-height: calc(100vh - 60px);
            }

            .tf-widget {
                background: var(--tf-card-bg); border: 1px solid var(--tf-border);
                border-radius: 12px; padding: 1.5rem; display: flex; align-items: center;
                gap: 1.2rem; transition: transform 0.2s, box-shadow 0.2s;
            }
            .tf-widget:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3); }
            .tf-widget-icon {
                width: 55px; height: 55px; border-radius: 12px;
                display: flex; align-items: center; justify-content: center;
                font-size: 1.4rem; flex-shrink: 0;
            }
            .tf-widget-icon.gold { background: rgba(212, 168, 67, 0.15); color: var(--tf-gold); }
            .tf-widget-icon.blue { background: rgba(15, 52, 96, 0.4); color: #5dade2; }
            .tf-widget-icon.green { background: rgba(39, 174, 96, 0.15); color: #2ecc71; }
            .tf-widget-icon.red { background: rgba(192, 57, 43, 0.15); color: #e74c3c; }
            .tf-widget-icon.purple { background: rgba(142, 68, 173, 0.15); color: #9b59b6; }
            .tf-widget-info h3 { font-size: 1.8rem; font-weight: 700; color: var(--tf-white); margin: 0; line-height: 1; }
            .tf-widget-info p { font-size: 0.8rem; color: var(--tf-gray); margin: 0.2rem 0 0; }
            .tf-widget-info .trend { font-size: 0.75rem; font-weight: 600; margin-top: 0.2rem; }
            .tf-widget-info .trend.up { color: #2ecc71; }
            .tf-widget-info .trend.down { color: #e74c3c; }

            .tf-card {
                background: var(--tf-card-bg); border: 1px solid var(--tf-border);
                border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
            }
            .tf-card-header {
                display: flex; justify-content: space-between; align-items: center;
                margin-bottom: 1.2rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--tf-border);
            }
            .tf-card-header h3 {
                font-size: 1rem; font-weight: 700; color: var(--tf-gold); margin: 0;
                display: flex; align-items: center; gap: 0.5rem;
            }

            .tf-table { width: 100%; border-collapse: separate; border-spacing: 0; }
            .tf-table thead th {
                background: var(--tf-navy); color: var(--tf-gold); padding: 0.8rem 1rem;
                text-align: left; font-weight: 600; font-size: 0.8rem; text-transform: uppercase;
                letter-spacing: 0.5px; border-bottom: 2px solid var(--tf-gold); white-space: nowrap;
            }
            .tf-table tbody tr { transition: background 0.2s; }
            .tf-table tbody tr:hover { background: rgba(212, 168, 67, 0.05); }
            .tf-table tbody td {
                padding: 0.7rem 1rem; border-bottom: 1px solid var(--tf-border);
                vertical-align: middle; font-size: 0.88rem;
            }

            .badge-role { padding: 0.25rem 0.7rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
            .badge-admin { background: #c0392b; color: white; }
            .badge-rh { background: var(--tf-dark-blue); color: var(--tf-gold); border: 1px solid var(--tf-gold); }
            .badge-candidat { background: #27ae60; color: white; }

            .btn-gold {
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight); border: none; padding: 0.5rem 1.2rem; border-radius: 8px;
                font-weight: 600; transition: all 0.3s; text-decoration: none;
                display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.88rem; cursor: pointer;
            }
            .btn-gold:hover {
                background: linear-gradient(135deg, var(--tf-gold-light), var(--tf-gold));
                color: var(--tf-midnight); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(212, 168, 67, 0.3);
            }
            .btn-outline-gold {
                border: 1px solid var(--tf-gold); color: var(--tf-gold); background: transparent;
                padding: 0.5rem 1.2rem; border-radius: 8px; font-weight: 600; transition: all 0.3s;
                text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;
                font-size: 0.88rem; cursor: pointer;
            }
            .btn-outline-gold:hover { background: var(--tf-gold); color: var(--tf-midnight); }
            .btn-danger-tf {
                background: #c0392b; color: white; border: none; padding: 0.4rem 1rem;
                border-radius: 8px; font-weight: 600; transition: all 0.3s; cursor: pointer;
            }
            .btn-danger-tf:hover { background: #e74c3c; }
            .btn-sm-tf { padding: 0.3rem 0.7rem; font-size: 0.8rem; border-radius: 6px; }

            .tf-form .form-label { color: var(--tf-gold); font-weight: 600; margin-bottom: 0.3rem; font-size: 0.85rem; }
            .tf-form .form-control, .tf-form .form-select {
                background: var(--tf-navy); border: 1px solid var(--tf-border);
                color: var(--tf-white); border-radius: 8px; padding: 0.6rem 1rem;
            }
            .tf-form .form-control:focus, .tf-form .form-select:focus {
                border-color: var(--tf-gold); box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15);
                background: var(--tf-navy); color: var(--tf-white);
            }
            .tf-form .form-control::placeholder { color: var(--tf-gray); }
            .tf-form .form-control.is-invalid, .tf-form .form-select.is-invalid {
                border-color: #e74c3c; box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.15);
            }
            .tf-form .invalid-feedback, .tf-form ul li { color: #e74c3c; font-size: 0.8rem; margin-top: 0.25rem; }
            .form-hint { display: block; color: var(--tf-gray); font-size: 0.75rem; margin-top: 0.3rem; font-style: italic; }
            .form-hint i { margin-right: 0.2rem; }

            .tf-flash { padding: 0.8rem 1.2rem; border-radius: 8px; margin-bottom: 1rem; border-left: 4px solid; display: flex; align-items: center; gap: 0.5rem; }
            .tf-flash-success { background: rgba(39, 174, 96, 0.12); border-color: #27ae60; color: #2ecc71; }
            .tf-flash-error { background: rgba(192, 57, 43, 0.12); border-color: #c0392b; color: #e74c3c; }
            .tf-flash-warning { background: rgba(243, 156, 18, 0.12); border-color: #f39c12; color: #f1c40f; }

            .tf-avatar {
                width: 40px; height: 40px; border-radius: 50%;
                background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
                color: var(--tf-midnight); display: inline-flex; align-items: center;
                justify-content: center; font-weight: 700; font-size: 0.9rem;
            }

            .tf-detail dt { color: var(--tf-gold); font-weight: 600; margin-bottom: 0.2rem; }
            .tf-detail dd { color: var(--tf-white); margin-bottom: 1rem; padding-left: 0; }

            .tf-search { display: flex; gap: 0.8rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
            .tf-search input, .tf-search select {
                background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);
                padding: 0.6rem 1rem; border-radius: 8px; flex: 1; min-width: 200px;
            }
            .tf-search input:focus, .tf-search select:focus {
                border-color: var(--tf-gold); outline: none; box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15);
            }
            .tf-search input::placeholder { color: var(--tf-gray); }

            .tf-activity-item { display: flex; gap: 0.8rem; padding: 0.7rem 0; border-bottom: 1px solid var(--tf-border); }
            .tf-activity-item:last-child { border-bottom: none; }
            .tf-activity-dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
            .tf-activity-dot.green { background: #2ecc71; }
            .tf-activity-dot.gold { background: var(--tf-gold); }
            .tf-activity-dot.blue { background: #5dade2; }
            .tf-activity-dot.red { background: #e74c3c; }
            .tf-activity-text { font-size: 0.85rem; color: var(--tf-white); }
            .tf-activity-time { font-size: 0.72rem; color: var(--tf-gray); margin-top: 0.1rem; }

            .tf-quick-action {
                display: flex; flex-direction: column; align-items: center; justify-content: center;
                padding: 1.2rem; background: var(--tf-navy); border: 1px solid var(--tf-border);
                border-radius: 12px; text-decoration: none; color: var(--tf-white);
                transition: all 0.2s; text-align: center;
            }
            .tf-quick-action:hover {
                border-color: var(--tf-gold); background: rgba(212, 168, 67, 0.08);
                color: var(--tf-gold); transform: translateY(-2px);
            }
            .tf-quick-action i { font-size: 1.5rem; color: var(--tf-gold); margin-bottom: 0.5rem; }
            .tf-quick-action span { font-size: 0.8rem; font-weight: 600; }

            .tf-actions { display: flex; gap: 0.4rem; flex-wrap: nowrap; }
            .tf-actions a, .tf-actions button { padding: 0.35rem 0.7rem; font-size: 0.85rem; border-radius: 6px; }

            .tf-login-wrapper {
                display: flex; align-items: center; justify-content: center;
                min-height: 100vh; background: var(--tf-midnight);
            }
            .tf-login-card {
                background: var(--tf-card-bg); border: 1px solid var(--tf-border); border-radius: 16px;
                padding: 2.5rem; width: 100%; max-width: 420px; box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            }
            .brand-lg { text-align: center; margin-bottom: 2rem; }
            .brand-lg h1 { color: var(--tf-gold); font-size: 1.8rem; font-weight: 800; }
            .brand-lg p { color: var(--tf-gray); font-size: 0.85rem; }

            /* Form styles */
            .tf-form-group { margin-bottom: 1.2rem; }
            .tf-label { display: block; color: var(--tf-gold); font-weight: 600; font-size: 0.85rem; margin-bottom: 0.4rem; }
            .tf-input, .tf-input.form-control, .tf-input.form-select {
                background: var(--tf-navy); border: 1px solid var(--tf-border); color: var(--tf-white);
                padding: 0.65rem 1rem; border-radius: 8px; width: 100%; font-size: 0.9rem;
                transition: border-color 0.2s, box-shadow 0.2s;
            }
            .tf-input:focus { border-color: var(--tf-gold); outline: none; box-shadow: 0 0 0 3px rgba(212, 168, 67, 0.15); background: var(--tf-navy); color: var(--tf-white); }
            .tf-input::placeholder { color: var(--tf-gray); }
            textarea.tf-input { resize: vertical; min-height: 100px; }
            select.tf-input option { background: var(--tf-navy); color: var(--tf-white); }

            /* Detail list for show pages */
            .tf-detail-list { padding: 0; }
            .tf-detail-item { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid var(--tf-border); }
            .tf-detail-item:last-child { border-bottom: none; }
            .tf-detail-label { color: var(--tf-gray); font-size: 0.85rem; font-weight: 500; }
            .tf-detail-value { color: var(--tf-white); font-weight: 600; font-size: 0.9rem; text-align: right; }

            /* Topbar brand link (non-admin) */
            .tf-topbar-brand-link {
                text-decoration: none; display: flex; align-items: center; gap: 0.45rem; flex-shrink: 0;
            }
            .tf-topbar-brand-link i { color: var(--tf-gold); font-size: 1.15rem; }
            .tf-topbar-brand-link span { font-weight: 800; font-size: 1.05rem; color: var(--tf-gold); }
            body.light-mode .tf-topbar-brand-link span { color: #2563eb; }
            body.light-mode .tf-topbar-brand-link i { color: #2563eb; }

            /* Collapsible search icon */
            .topbar-search-toggle {
                background: none; border: 1px solid var(--tf-border); color: var(--tf-gray);
                width: 36px; height: 36px; border-radius: 50%; cursor: pointer;
                display: flex; align-items: center; justify-content: center;
                font-size: 0.9rem; transition: all 0.25s; flex-shrink: 0;
            }
            .topbar-search-toggle:hover { border-color: var(--tf-gold); color: var(--tf-gold); }
            body.light-mode .topbar-search-toggle { border-color: #dddfe2; color: #65676b; }
            body.light-mode .topbar-search-toggle:hover { border-color: #2563eb; color: #1d4ed8; }

            /* Expanded search bar (slides in, replaces center) */
            .topbar-search-expanded {
                display: none; align-items: center; gap: 0.6rem;
                background: var(--tf-card-bg); border: 1px solid var(--tf-border);
                border-radius: 30px; padding: 0.35rem 0.5rem 0.35rem 1rem;
                position: absolute; right: 0; top: 50%; transform: translateY(-50%);
                width: 100%; max-width: 680px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.25);
                animation: searchSlideIn 0.2s ease-out;
                z-index: 10;
            }
            .topbar-search-expanded.active { display: flex; }
            @keyframes searchSlideIn {
                from { opacity: 0; transform: translateY(-50%) scaleX(0.9); }
                to { opacity: 1; transform: translateY(-50%) scaleX(1); }
            }
            body.light-mode .topbar-search-expanded { background: #fff; border-color: #dddfe2; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }

            @media (max-width: 992px) {
                .tf-sidebar { display: none; }
                .tf-topbar { left: 0; }
                .tf-main { margin-left: 0; }
                .tf-topbar-nav a span { display: none; }
                .tf-topbar-nav a { padding: 0.45rem 0.6rem; }
            }
            @media (max-width: 576px) {
                .tf-topbar { padding: 0 0.8rem; }
                .tf-topbar-right .top-user span { display: none; }
                .tf-topbar-nav { display: none; }
                .topbar-search-expanded { max-width: calc(100vw - 120px); }
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="{{ not is_granted('ROLE_ADMIN') ? 'no-sidebar' : '' }}">
        {% if is_granted('ROLE_ADMIN') %}
        <aside class="tf-sidebar">
            <div class="tf-sidebar-brand">
                <a href="{{ path('app_dashboard') }}">
                    <i class="fas fa-briefcase"></i> TalentFlow
                </a>
                <small>Admin Connect</small>
            </div>

            <div class="tf-sidebar-section">Principal</div>
            <ul class="tf-sidebar-nav">
                <li>
                    <a href="{{ path('app_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="fas fa-tachometer-alt"></i> Tableau de bord
                    </a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                <div class="tf-sidebar-section">Administration</div>
                <li>
                    <a href="{{ path('app_user_index') }}" class="{% if 'app_user' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-users-cog"></i> Gestion Utilisateurs
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_user_new') }}">
                        <i class="fas fa-user-plus"></i> Nouvel Utilisateur
                    </a>
                </li>
                {% endif %}

                {% if is_granted('ROLE_RH') or is_granted('ROLE_ADMIN') %}
                <div class="tf-sidebar-section">Recrutement</div>
                <li>
                    <a href="#">
                        <i class="fas fa-clipboard-list"></i> Offres d'emploi
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-file-alt"></i> Candidatures
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-calendar-check"></i> Entretiens
                    </a>
                </li>
                {% endif %}

                <div class="tf-sidebar-section">Forum</div>
                <li>
                    <a href="{{ path('post_index') }}" class="{% if 'post' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-comments"></i> Posts
                    </a>
                </li>
                <li>
                    <a href="{{ path('message_index') }}" class="{% if 'message' in app.request.attributes.get('_route') %}active{% endif %}" style="position:relative">
                        <i class="fas fa-paper-plane"></i> Messages
                        <span class="dm-unread-badge" style="display:none;position:absolute;top:6px;right:8px;min-width:16px;height:16px;line-height:16px;background:var(--tf-gold);color:var(--tf-midnight);font-size:0.6rem;font-weight:700;border-radius:50%;text-align:center;padding:0 3px"></span>
                    </a>
                </li>

                {% if is_granted('ROLE_CANDIDAT') and not is_granted('ROLE_ADMIN') %}
                <div class="tf-sidebar-section">Mon Espace</div>
                <li>
                    <a href="#">
                        <i class="fas fa-paper-plane"></i> Mes Candidatures
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-search"></i> Offres disponibles
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-id-badge"></i> Mon Profil
                    </a>
                </li>
                {% endif %}

                <div class="tf-sidebar-section">Système</div>
                <li>
                    <a href="#">
                        <i class="fas fa-cog"></i> Paramètres
                    </a>
                </li>
            </ul>

            {% if app.user %}
            <div class="tf-sidebar-footer">
                <div class="user-info">
                    <div class="tf-avatar-sm">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                    <div class="user-details">
                        <div class="user-name">{{ app.user.fullName }}</div>
                        <div class="user-role">{{ app.user.roleLabel }}</div>
                    </div>
                </div>
            </div>
            {% endif %}
        </aside>
        {% endif %}

        <header class="tf-topbar">
            <div class="tf-topbar-left">
                {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_dashboard') }}" class="tf-topbar-brand-link">
                    <i class="fas fa-briefcase"></i>
                    <span>TalentFlow</span>
                </a>
                <div class="tf-topbar-sep"></div>
                <nav class="tf-topbar-nav">
                    <a href="{{ path('app_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a href="{{ path('post_index') }}" class="{% if 'post' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="fas fa-comments"></i> Posts
                    </a>
                    <a href="{{ path('message_index') }}" class="{% if 'message' in app.request.attributes.get('_route') %}active{% endif %}" style="position:relative">
                        <i class="fas fa-paper-plane"></i> Messages
                        <span class="dm-unread-badge" style="display:none;min-width:16px;height:16px;line-height:16px;background:var(--tf-gold);color:var(--tf-midnight);font-size:0.6rem;font-weight:700;border-radius:50%;text-align:center;padding:0 3px;margin-left:4px"></span>
                    </a>
                    {% if is_granted('ROLE_RH') %}
                    <a href="#">
                        <i class="fas fa-clipboard-list"></i> Offres
                    </a>
                    {% endif %}
                    {% if is_granted('ROLE_CANDIDAT') and not is_granted('ROLE_RH') %}
                    <a href="#">
                        <i class="fas fa-paper-plane"></i> Candidatures
                    </a>
                    <a href="#">
                        <i class="fas fa-search"></i> Offres
                    </a>
                    {% endif %}
                </nav>
                {% else %}
                <h1>{% block page_title %}Tableau de bord{% endblock %}</h1>
                {% endif %}
            </div>
            <div class="tf-topbar-center">
                {% block topbar_center %}{% endblock %}
            </div>
            <div class="tf-topbar-right">
                <button class="theme-toggle" id="themeToggle" title="Changer de thème">
                    <i class="fas fa-moon"></i>
                </button>
                {% if app.user %}
                <div class="top-user">
                    <div class="tf-avatar-sm">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                    <span>{{ app.user.fullName }}</span>
                </div>
                <a href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
                {% endif %}
            </div>
        </header>

        <main class="tf-main">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="tf-flash tf-flash-{{ label }}">
                        <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'warning' ? 'exclamation-triangle' : 'exclamation-circle') }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            // Theme toggle (persisted in localStorage)
            (function() {
                const toggle = document.getElementById('themeToggle');
                const icon = toggle ? toggle.querySelector('i') : null;

                function applyTheme(mode) {
                    if (mode === 'light') {
                        document.body.classList.add('light-mode');
                        if (icon) { icon.className = 'fas fa-sun'; }
                    } else {
                        document.body.classList.remove('light-mode');
                        if (icon) { icon.className = 'fas fa-moon'; }
                    }
                }

                // Load saved preference
                const saved = localStorage.getItem('tf-theme') || 'dark';
                applyTheme(saved);

                if (toggle) {
                    toggle.addEventListener('click', function() {
                        const isLight = document.body.classList.contains('light-mode');
                        const next = isLight ? 'dark' : 'light';
                        localStorage.setItem('tf-theme', next);
                        applyTheme(next);
                    });
                }
            })();
        </script>
        {% if app.user %}
        <script>
        (function(){
            let prevCount = -1;
            let audioCtx;
            function playChime() {
                try {
                    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    [0, 0.15].forEach((d,i) => {
                        const o = audioCtx.createOscillator(), g = audioCtx.createGain();
                        o.connect(g); g.connect(audioCtx.destination);
                        o.type='sine'; o.frequency.value = i?1050:830;
                        g.gain.setValueAtTime(0.15, audioCtx.currentTime+d);
                        g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+d+0.35);
                        o.start(audioCtx.currentTime+d); o.stop(audioCtx.currentTime+d+0.4);
                    });
                } catch(e){}
            }
            function poll() {
                fetch('/message/unread-count').then(r=>r.json()).then(data=>{
                    const c = data.count || 0;
                    document.querySelectorAll('.dm-unread-badge').forEach(b=>{
                        if(c>0){ b.textContent=c>99?'99+':c; b.style.display='inline-flex'; }
                        else { b.style.display='none'; }
                    });
                    if (prevCount >= 0 && c > prevCount) playChime();
                    prevCount = c;
                }).catch(()=>{});
            }
            // Don't poll on call pages — it blocks the single-threaded PHP dev server
            if (!window.location.pathname.startsWith('/call')) {
                poll();
                setInterval(poll, 8000);
            }
        })();
        </script>
        {% endif %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
