<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialiser le mot de passe - TalentFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        :root { --tf-midnight:#1a1a2e; --tf-navy:#16213e; --tf-dark-blue:#0f3460; --tf-gold:#d4a843; --tf-gold-light:#e8c96d; --tf-gold-dark:#b8922f; --tf-white:#f5f5f5; --tf-gray:#a0a0b0; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; min-height:100vh; background:linear-gradient(135deg,#0d1117 0%,#1a1a2e 30%,#16213e 60%,#0f3460 100%); display:flex; align-items:center; justify-content:center; }
        .bg-particles { position:fixed; top:0; left:0; width:100%; height:100%; overflow:hidden; z-index:0; }
        .bg-particles span { position:absolute; width:4px; height:4px; background:rgba(212,168,67,0.3); border-radius:50%; animation:float 15s infinite; }
        .bg-particles span:nth-child(1){left:10%;animation-delay:0s;animation-duration:20s} .bg-particles span:nth-child(2){left:20%;animation-delay:2s;width:6px;height:6px} .bg-particles span:nth-child(3){left:35%;animation-delay:4s;animation-duration:18s} .bg-particles span:nth-child(4){left:50%;animation-delay:1s;width:3px;height:3px} .bg-particles span:nth-child(5){left:65%;animation-delay:3s;animation-duration:22s} .bg-particles span:nth-child(6){left:75%;animation-delay:5s;width:5px;height:5px}
        @keyframes float { 0%{transform:translateY(100vh) rotate(0deg);opacity:0} 10%{opacity:1} 90%{opacity:1} 100%{transform:translateY(-100vh) rotate(720deg);opacity:0} }
        .page-container { position:relative; z-index:1; width:100%; max-width:460px; padding:1rem; }
        .page-card { background:rgba(22,33,62,0.85); backdrop-filter:blur(20px); border:1px solid rgba(212,168,67,0.2); border-radius:20px; padding:2.5rem 2rem; box-shadow:0 25px 60px rgba(0,0,0,0.5); animation:cardAppear 0.6s ease; }
        @keyframes cardAppear { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
        .brand-icon { width:70px; height:70px; border-radius:50%; background:linear-gradient(135deg,var(--tf-gold),var(--tf-gold-dark)); display:inline-flex; align-items:center; justify-content:center; font-size:1.8rem; color:var(--tf-midnight); margin-bottom:1rem; box-shadow:0 8px 25px rgba(212,168,67,0.3); }
        .form-label { color:var(--tf-gold); font-weight:600; font-size:0.85rem; display:flex; align-items:center; gap:0.4rem; }
        .form-control { background:rgba(26,26,46,0.8); border:1px solid rgba(212,168,67,0.15); color:var(--tf-white); border-radius:10px; padding:0.75rem 1rem; font-size:0.95rem; transition:all 0.3s; }
        .form-control:focus { background:rgba(26,26,46,0.95); border-color:var(--tf-gold); box-shadow:0 0 0 3px rgba(212,168,67,0.1); color:var(--tf-white); }
        .form-control::placeholder { color:#6a6a80; }
        .btn-gold-standalone { background:linear-gradient(135deg,var(--tf-gold),var(--tf-gold-dark)); color:var(--tf-midnight); border:none; padding:0.8rem; border-radius:10px; font-weight:700; font-size:1rem; width:100%; cursor:pointer; transition:all 0.3s; display:flex; align-items:center; justify-content:center; gap:0.5rem; }
        .btn-gold-standalone:hover { background:linear-gradient(135deg,var(--tf-gold-light),var(--tf-gold)); transform:translateY(-2px); box-shadow:0 8px 20px rgba(212,168,67,0.25); }
        .tf-alert { padding:0.8rem 1rem; border-radius:10px; margin-bottom:1rem; font-size:0.85rem; display:flex; align-items:flex-start; gap:0.5rem; }
        .tf-alert-success { background:rgba(39,174,96,0.12); border:1px solid rgba(46,204,113,0.3); color:#2ecc71; }
        .tf-alert-error { background:rgba(192,57,43,0.12); border:1px solid rgba(231,76,60,0.3); color:#e74c3c; }
        .back-link { color:var(--tf-gray); text-decoration:none; font-size:0.85rem; transition:color 0.2s; }
        .back-link:hover { color:var(--tf-gold); }
    </style>
</head>
<body>
    <div class="bg-particles"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="page-container">
        <div class="page-card">
            <div class="text-center mb-4">
                <div class="brand-icon"><i class="fas fa-lock"></i></div>
                <h2 style="font-size:1.4rem;font-weight:800;color:var(--tf-gold);margin-bottom:0.3rem;">Nouveau mot de passe</h2>
                <p style="font-size:0.78rem;color:var(--tf-gray);letter-spacing:1px;">Choisissez un mot de passe sécurisé</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="tf-alert tf-alert-{{ label }}">
                        <i class="fas fa-{% if label == 'success' %}check-circle{% else %}exclamation-circle{% endif %}"></i>
                        <div>{{ message|raw }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            <div style="color:#b0b0c0;font-size:0.88rem;margin-bottom:1.5rem;line-height:1.6;text-align:center;">
                <i class="fas fa-shield-alt" style="color:var(--tf-gold);"></i>
                Choisissez un nouveau mot de passe sécurisé.
            </div>

            <form method="post" novalidate>
                <div class="mb-3">
                    <label for="inputPassword" class="form-label"><i class="fas fa-lock"></i> Nouveau mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" placeholder="••••••••••••" required autofocus autocomplete="new-password">
                    <small style="color:#8a8aa0;font-size:0.8rem;margin-top:0.3rem;display:block;"><i class="fas fa-info-circle"></i> Min. 12 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial</small>
                </div>
                <div class="mb-3">
                    <label for="inputPasswordConfirm" class="form-label"><i class="fas fa-lock"></i> Confirmer le mot de passe</label>
                    <input type="password" name="password_confirm" id="inputPasswordConfirm" class="form-control" placeholder="••••••••••••" required autocomplete="new-password">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
                <button class="btn-gold-standalone mt-2" type="submit">
                    <i class="fas fa-save"></i> Réinitialiser le mot de passe
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="{{ path('app_login') }}" class="back-link"><i class="fas fa-arrow-left"></i> Retour à la connexion</a>
            </div>
        </div>
    </div>
</body>
</html>
