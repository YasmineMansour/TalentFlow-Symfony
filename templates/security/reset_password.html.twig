{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe - TalentFlow{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
<div class="tf-login-wrapper" style="margin: -2rem; min-height: 100vh; padding: 2rem;">
    <div class="tf-login-card">
        <div class="brand-lg">
            <h1><i class="fas fa-briefcase"></i> TalentFlow</h1>
            <p>Nouveau mot de passe</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="tf-flash tf-flash-{{ label }}">
                    <i class="fas fa-{% if label == 'success' %}check-circle{% elseif label == 'warning' %}exclamation-triangle{% else %}exclamation-circle{% endif %}"></i>
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        <div style="color: #b0b0c0; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
            <i class="fas fa-shield-alt" style="color: #d4a843;"></i>
            Choisissez un nouveau mot de passe sécurisé.
        </div>

        <form method="post" class="tf-form" novalidate>
            <div class="mb-3">
                <label for="inputPassword" class="form-label">
                    <i class="fas fa-lock"></i> Nouveau mot de passe
                </label>
                <input type="password" name="password" id="inputPassword"
                       class="form-control" placeholder="••••••••••••" required autofocus
                       autocomplete="new-password">
                <small class="form-hint" style="color: #8a8aa0; font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                    <i class="fas fa-info-circle"></i> Min. 12 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial
                </small>
            </div>

            <div class="mb-3">
                <label for="inputPasswordConfirm" class="form-label">
                    <i class="fas fa-lock"></i> Confirmer le mot de passe
                </label>
                <input type="password" name="password_confirm" id="inputPasswordConfirm"
                       class="form-control" placeholder="••••••••••••" required
                       autocomplete="new-password">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

            <button class="btn-gold w-100 mt-3" type="submit" style="justify-content: center; padding: 0.7rem;">
                <i class="fas fa-save"></i> Réinitialiser le mot de passe
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="{{ path('app_login') }}" style="color: #d4a843; text-decoration: none; font-size: 0.9rem;">
                <i class="fas fa-arrow-left"></i> Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
