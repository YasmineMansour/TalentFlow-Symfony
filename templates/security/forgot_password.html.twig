{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - TalentFlow{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
<div class="tf-login-wrapper" style="margin: -2rem; min-height: 100vh; padding: 2rem;">
    <div class="tf-login-card">
        <div class="brand-lg">
            <h1><i class="fas fa-briefcase"></i> TalentFlow</h1>
            <p>Réinitialisation du mot de passe</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="tf-flash tf-flash-{{ label }}">
                    <i class="fas fa-{% if label == 'success' %}check-circle{% elseif label == 'warning' %}exclamation-triangle{% else %}exclamation-circle{% endif %}"></i>
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if email_sent is not defined or not email_sent %}
            <div style="color: #b0b0c0; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                <i class="fas fa-info-circle" style="color: #d4a843;"></i>
                Entrez votre adresse email. Si un compte est associé, un lien de réinitialisation sera généré.
            </div>

            <form method="post" class="tf-form">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">
                        <i class="fas fa-envelope"></i> Adresse email
                    </label>
                    <input type="email" name="email" id="inputEmail"
                           class="form-control" placeholder="votre@email.com" required autofocus>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                <button class="btn-gold w-100 mt-3" type="submit" style="justify-content: center; padding: 0.7rem;">
                    <i class="fas fa-paper-plane"></i> Envoyer le lien
                </button>
            </form>
        {% endif %}

        <div class="text-center mt-3">
            <a href="{{ path('app_login') }}" style="color: #d4a843; text-decoration: none; font-size: 0.9rem;">
                <i class="fas fa-arrow-left"></i> Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
