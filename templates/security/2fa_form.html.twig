<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vérification 2FA - TalentFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --tf-midnight: #1a1a2e;
            --tf-navy: #16213e;
            --tf-dark-blue: #0f3460;
            --tf-gold: #d4a843;
            --tf-gold-light: #e8c96d;
            --tf-gold-dark: #b8922f;
            --tf-white: #f5f5f5;
            --tf-gray: #a0a0b0;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0d1117 0%, #1a1a2e 30%, #16213e 60%, #0f3460 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .bg-particles {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            overflow: hidden; z-index: 0;
        }
        .bg-particles span {
            position: absolute; width: 4px; height: 4px;
            background: rgba(212, 168, 67, 0.3); border-radius: 50%;
            animation: float 15s infinite;
        }
        .bg-particles span:nth-child(1) { left: 10%; animation-delay: 0s; animation-duration: 20s; }
        .bg-particles span:nth-child(2) { left: 20%; animation-delay: 2s; width: 6px; height: 6px; }
        .bg-particles span:nth-child(3) { left: 35%; animation-delay: 4s; animation-duration: 18s; }
        .bg-particles span:nth-child(4) { left: 50%; animation-delay: 1s; width: 3px; height: 3px; }
        .bg-particles span:nth-child(5) { left: 65%; animation-delay: 3s; animation-duration: 22s; }
        .bg-particles span:nth-child(6) { left: 75%; animation-delay: 5s; width: 5px; height: 5px; }
        .bg-particles span:nth-child(7) { left: 85%; animation-delay: 7s; }
        .bg-particles span:nth-child(8) { left: 90%; animation-delay: 6s; animation-duration: 25s; }
        @keyframes float {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
        }

        .tfa-container {
            position: relative; z-index: 1;
            width: 100%; max-width: 460px; padding: 1rem;
        }
        .tfa-card {
            background: rgba(22, 33, 62, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 168, 67, 0.2);
            border-radius: 20px;
            padding: 2.5rem 2rem;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5), 0 0 40px rgba(212,168,67,0.05);
            animation: cardAppear 0.6s ease;
        }
        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .shield-icon {
            width: 90px; height: 90px; border-radius: 50%;
            background: linear-gradient(135deg, rgba(212,168,67,0.2), rgba(15,52,96,0.4));
            border: 2px solid var(--tf-gold);
            display: inline-flex; align-items: center; justify-content: center;
            margin-bottom: 1.2rem;
            box-shadow: 0 0 30px rgba(212,168,67,0.15);
            animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 20px rgba(212,168,67,0.15); }
            50% { box-shadow: 0 0 40px rgba(212,168,67,0.3); }
        }
        .shield-icon i { font-size: 2.2rem; color: var(--tf-gold); }

        .brand-title {
            font-size: 1.4rem; font-weight: 800; color: var(--tf-gold); margin-bottom: 0.3rem;
        }
        .brand-subtitle {
            font-size: 0.85rem; color: var(--tf-gray); letter-spacing: 0.5px;
        }

        .info-text {
            color: #b0b0c0; font-size: 0.88rem; line-height: 1.6;
            margin: 1.2rem 0; text-align: center;
        }
        .info-text strong { color: var(--tf-gold-light); }
        .info-text small { color: #8a8aa0; }

        .form-label {
            color: var(--tf-gold); font-weight: 600; font-size: 0.85rem;
            display: flex; align-items: center; gap: 0.4rem;
        }
        .form-control {
            background: rgba(26,26,46,0.8);
            border: 1px solid rgba(212,168,67,0.15);
            color: var(--tf-gold-light); border-radius: 10px;
            padding: 0.85rem 1rem; font-size: 1.5rem;
            letter-spacing: 8px; font-weight: bold;
            text-align: center; transition: all 0.3s;
        }
        .form-control:focus {
            background: rgba(26,26,46,0.95);
            border-color: var(--tf-gold);
            box-shadow: 0 0 0 3px rgba(212,168,67,0.1);
            color: var(--tf-gold-light);
        }
        .form-control::placeholder { color: #4a4a60; letter-spacing: 12px; font-size: 1.2rem; }

        .btn-verify {
            background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
            color: var(--tf-midnight); border: none; padding: 0.8rem;
            border-radius: 10px; font-weight: 700; font-size: 1rem;
            width: 100%; cursor: pointer; transition: all 0.3s;
            display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .btn-verify:hover {
            background: linear-gradient(135deg, var(--tf-gold-light), var(--tf-gold));
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(212,168,67,0.25);
        }

        .tf-alert {
            padding: 0.8rem 1rem; border-radius: 10px; margin-bottom: 1rem;
            font-size: 0.85rem; display: flex; align-items: flex-start; gap: 0.5rem;
            background: rgba(192,57,43,0.12); border: 1px solid rgba(231,76,60,0.3); color: #e74c3c;
        }

        .logout-link {
            color: #e07070; text-decoration: none; font-size: 0.85rem; transition: color 0.2s;
        }
        .logout-link:hover { color: #ff6b6b; }

        .footer-divider {
            border-top: 1px solid rgba(212,168,67,0.1);
            margin-top: 1.5rem; padding-top: 1rem;
        }
    </style>
</head>
<body>
    <div class="bg-particles">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
    </div>

    <div class="tfa-container">
        <div class="tfa-card">
            <div class="text-center">
                <div class="shield-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h2 class="brand-title">Vérification de sécurité</h2>
                <p class="brand-subtitle">Authentification à deux facteurs</p>
            </div>

            {% if authenticationError %}
                <div class="tf-alert mt-3">
                    <i class="fas fa-exclamation-circle"></i>
                    <div>{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
                </div>
            {% endif %}

            <div class="info-text">
                <i class="fas fa-envelope" style="color: var(--tf-gold);"></i>
                Un code de vérification à <strong>6 chiffres</strong> a été envoyé à votre adresse email.
                <br><small>Vérifiez votre boîte de réception et vos spams.</small>
            </div>

            <form method="post" action="{{ path('2fa_login_check') }}">
                <div class="mb-3">
                    <label for="inputCode" class="form-label">
                        <i class="fas fa-key"></i> Code de vérification
                    </label>
                    <input type="text" name="_auth_code" id="inputCode"
                           class="form-control"
                           placeholder="● ● ● ●"
                           required autofocus
                           autocomplete="one-time-code"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           inputmode="numeric">
                </div>

                {% if isCsrfProtectionEnabled %}
                    <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                {% endif %}

                <button class="btn-verify mt-2" type="submit">
                    <i class="fas fa-check-circle"></i> Vérifier le code
                </button>
            </form>

            <div class="text-center footer-divider">
                <a href="{{ logoutPath }}" class="logout-link">
                    <i class="fas fa-sign-out-alt"></i> Annuler et se déconnecter
                </a>
            </div>
        </div>
    </div>

    <script>
        const codeInput = document.getElementById('inputCode');
        codeInput.addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
</body>
</html>
