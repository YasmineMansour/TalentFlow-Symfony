{% extends 'base.html.twig' %}

{% block title %}Vérification 2FA - TalentFlow{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
<div class="tf-login-wrapper" style="margin: -2rem; min-height: 100vh; padding: 2rem;">
    <div class="tf-login-card">
        <div class="brand-lg">
            <h1><i class="fas fa-briefcase"></i> TalentFlow</h1>
            <p>Authentification à deux facteurs</p>
        </div>

        {# Icône shield animée #}
        <div class="text-center mb-4">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, rgba(212,168,67,0.15), rgba(15,52,96,0.3)); border: 2px solid #d4a843;">
                <i class="fas fa-shield-alt" style="font-size: 2rem; color: #d4a843;"></i>
            </div>
        </div>

        {% if authenticationError %}
            <div class="tf-flash tf-flash-error">
                <i class="fas fa-exclamation-circle"></i> {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
            </div>
        {% endif %}

        <div style="color: #b0b0c0; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.6; text-align: center;">
            <i class="fas fa-envelope" style="color: #d4a843;"></i>
            Un code de vérification à <strong style="color: #e8c96d;">6 chiffres</strong> a été envoyé à votre adresse email.
            <br><small style="color: #8a8aa0;">Vérifiez votre boîte de réception et vos spams.</small>
        </div>

        <form method="post" class="tf-form" action="{{ path('2fa_login_check') }}">
            <div class="mb-3">
                <label for="inputCode" class="form-label">
                    <i class="fas fa-key"></i> Code de vérification
                </label>
                <input type="text" name="_auth_code" id="inputCode"
                       class="form-control text-center"
                       placeholder="● ● ● ● ● ●"
                       required autofocus
                       autocomplete="one-time-code"
                       maxlength="6"
                       pattern="[0-9]{6}"
                       inputmode="numeric"
                       style="font-size: 1.5rem; letter-spacing: 8px; font-weight: bold; color: #e8c96d;">
            </div>

            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}

            <button class="btn-gold w-100 mt-3" type="submit" style="justify-content: center; padding: 0.7rem;">
                <i class="fas fa-check-circle"></i> Vérifier
            </button>
        </form>

        <div class="text-center mt-4" style="border-top: 1px solid rgba(212,168,67,0.15); padding-top: 1rem;">
            <a href="{{ logoutPath }}" style="color: #e07070; text-decoration: none; font-size: 0.85rem;">
                <i class="fas fa-sign-out-alt"></i> Annuler et se déconnecter
            </a>
        </div>
    </div>
</div>
{% endblock %}
