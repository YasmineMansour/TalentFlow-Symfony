<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme="light">
<head>
    <script>(function(){var t=localStorage.getItem('tf-theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);if(t==='dark')document.documentElement.classList.add('dark');})()</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'login.page_title'|trans }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --tf-midnight: #1a1a2e;
            --tf-navy: #16213e;
            --tf-dark-blue: #0f3460;
            --tf-gold: #d4a843;
            --tf-gold-light: #e8c96d;
            --tf-gold-dark: #b8922f;
            --tf-white: #f5f5f5;
            --tf-gray: #a0a0b0;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; min-height: 100vh; background: #0d1117; color: var(--tf-white); overflow-x: hidden; }

        /* ─── NAVBAR ─── */
        .tf-navbar {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            background: rgba(13, 17, 23, 0.9); backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(212,168,67,0.1);
            padding: 0.8rem 2rem;
            display: flex; align-items: center; justify-content: space-between;
        }
        .tf-navbar-brand {
            display: flex; align-items: center; gap: 0.6rem;
            text-decoration: none; color: var(--tf-gold); font-weight: 800; font-size: 1.3rem;
        }
        .tf-navbar-brand i { font-size: 1.1rem; }
        .tf-navbar-links { display: flex; align-items: center; gap: 1.5rem; }
        .tf-navbar-links a {
            color: var(--tf-gray); text-decoration: none; font-size: 0.85rem;
            font-weight: 500; transition: color 0.2s;
        }
        .tf-navbar-links a:hover { color: var(--tf-gold); }

        /* ─── HERO SPLIT LAYOUT ─── */
        .tf-page { display: flex; min-height: 100vh; padding-top: 60px; }

        /* Left: Info Panel */
        .tf-info-panel {
            flex: 1; display: flex; flex-direction: column; justify-content: center;
            padding: 4rem 5rem;
            background: linear-gradient(160deg, #0d1117 0%, #1a1a2e 50%, #0f3460 100%);
            position: relative; overflow: hidden;
        }
        .tf-info-panel::before {
            content: ''; position: absolute; top: -50%; right: -30%;
            width: 600px; height: 600px; border-radius: 50%;
            background: radial-gradient(circle, rgba(212,168,67,0.06) 0%, transparent 70%);
        }
        .tf-info-panel::after {
            content: ''; position: absolute; bottom: -40%; left: -20%;
            width: 500px; height: 500px; border-radius: 50%;
            background: radial-gradient(circle, rgba(15,52,96,0.2) 0%, transparent 70%);
        }
        .tf-info-content { position: relative; z-index: 1; }
        .tf-info-content h1 {
            font-size: 2.8rem; font-weight: 900; line-height: 1.15; margin-bottom: 1rem;
        }
        .tf-info-content h1 span { color: var(--tf-gold); }
        .tf-info-content .tf-tagline {
            font-size: 1.1rem; color: var(--tf-gray); line-height: 1.7; margin-bottom: 2.5rem; max-width: 480px;
        }
        .tf-features { display: flex; flex-direction: column; gap: 1.2rem; }
        .tf-feature {
            display: flex; align-items: center; gap: 1rem;
            padding: 0.8rem 1.2rem; border-radius: 12px;
            background: rgba(22,33,62,0.5); border: 1px solid rgba(212,168,67,0.08);
            transition: all 0.3s;
        }
        .tf-feature:hover { border-color: rgba(212,168,67,0.2); background: rgba(22,33,62,0.7); }
        .tf-feature-icon {
            width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0;
            background: linear-gradient(135deg, rgba(212,168,67,0.15), rgba(15,52,96,0.3));
            display: flex; align-items: center; justify-content: center;
            color: var(--tf-gold); font-size: 1rem;
        }
        .tf-feature-text h4 { font-size: 0.85rem; font-weight: 700; color: var(--tf-white); margin-bottom: 0.15rem; }
        .tf-feature-text p { font-size: 0.75rem; color: var(--tf-gray); margin: 0; }

        /* Right: Login Form */
        .tf-login-panel {
            width: 520px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            padding: 2rem 3rem;
            background: rgba(22,33,62,0.4);
            border-left: 1px solid rgba(212,168,67,0.08);
        }
        .tf-login-box { width: 100%; max-width: 380px; }
        .tf-login-header { text-align: center; margin-bottom: 2rem; }
        .tf-login-header .icon-circle {
            width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 1rem;
            background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; color: var(--tf-midnight);
            box-shadow: 0 6px 20px rgba(212,168,67,0.25);
        }
        .tf-login-header h2 { font-size: 1.4rem; font-weight: 800; color: var(--tf-white); margin-bottom: 0.2rem; }
        .tf-login-header p { font-size: 0.8rem; color: var(--tf-gray); }

        .form-label {
            color: var(--tf-gold); font-weight: 600; font-size: 0.8rem;
            display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.4rem;
        }
        .form-control {
            background: rgba(13,17,23,0.7); border: 1px solid rgba(212,168,67,0.12);
            color: var(--tf-white); border-radius: 10px;
            padding: 0.7rem 1rem; font-size: 0.9rem; transition: all 0.3s;
        }
        .form-control:focus {
            background: rgba(13,17,23,0.9); border-color: var(--tf-gold);
            box-shadow: 0 0 0 3px rgba(212,168,67,0.08); color: var(--tf-white);
        }
        .form-control::placeholder { color: #5a5a70; }

        .btn-login {
            background: linear-gradient(135deg, var(--tf-gold), var(--tf-gold-dark));
            color: var(--tf-midnight); border: none; padding: 0.75rem;
            border-radius: 10px; font-weight: 700; font-size: 0.95rem;
            width: 100%; cursor: pointer; transition: all 0.3s;
            display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .btn-login:hover {
            background: linear-gradient(135deg, var(--tf-gold-light), var(--tf-gold));
            transform: translateY(-1px); box-shadow: 0 6px 18px rgba(212,168,67,0.2);
        }
        .btn-login:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .tf-alert {
            padding: 0.7rem 0.9rem; border-radius: 10px; margin-bottom: 0.8rem;
            font-size: 0.8rem; display: flex; align-items: flex-start; gap: 0.5rem;
        }
        .tf-alert-error { background: rgba(192,57,43,0.1); border: 1px solid rgba(231,76,60,0.25); color: #e74c3c; }
        .tf-alert-warning { background: rgba(212,168,67,0.08); border: 1px solid rgba(212,168,67,0.25); color: var(--tf-gold-light); }

        .forgot-link { color: var(--tf-gray); text-decoration: none; font-size: 0.8rem; transition: color 0.2s; }
        .forgot-link:hover { color: var(--tf-gold); }

        .input-group-icon { position: relative; }
        .input-group-icon i.field-icon {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            color: var(--tf-gray); cursor: pointer; z-index: 2; font-size: 0.9rem;
        }
        .input-group-icon i.field-icon:hover { color: var(--tf-gold); }

        .tf-divider { border-top: 1px solid rgba(212,168,67,0.08); margin: 1.2rem 0; }

        .tf-footer-login {
            text-align: center; color: var(--tf-gray); font-size: 0.72rem;
        }
        .tf-remember-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin: 0.9rem 0 1rem;
        }
        .tf-remember-check {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            color: var(--tf-gray);
            font-size: 0.82rem;
            cursor: pointer;
        }
        .tf-remember-check input {
            accent-color: var(--tf-gold);
            width: 16px;
            height: 16px;
        }

        /* ─── STATS BAR ─── */
        .tf-stats {
            display: flex; gap: 2rem; margin-top: 2.5rem; padding-top: 2rem;
            border-top: 1px solid rgba(212,168,67,0.08);
        }
        .tf-stat { text-align: center; }
        .tf-stat-num { font-size: 1.6rem; font-weight: 800; color: var(--tf-gold); }
        .tf-stat-label { font-size: 0.7rem; color: var(--tf-gray); text-transform: uppercase; letter-spacing: 1px; }

        /* ─── RESPONSIVE ─── */
        @media (max-width: 992px) {
            .tf-page { flex-direction: column; }
            .tf-info-panel { padding: 3rem 2rem; min-height: auto; }
            .tf-info-content h1 { font-size: 2rem; }
            .tf-login-panel { width: 100%; border-left: none; border-top: 1px solid rgba(212,168,67,0.08); padding: 2rem; }
            .tf-stats { gap: 1.2rem; }
        }

        /* ==================== LIGHT MODE ==================== */
        [data-theme="light"] body { background: #f4f6fb; color: #1a1a2e; }
        [data-theme="light"] .tf-navbar { background: rgba(255,255,255,0.95); border-bottom-color: #e2e6ef; }
        [data-theme="light"] .tf-navbar-brand { color: var(--tf-gold); }
        [data-theme="light"] .tf-navbar-links a { color: #5a5f7a; }
        [data-theme="light"] .tf-navbar-links a:hover { color: var(--tf-gold); }
        [data-theme="light"] .tf-info-panel { background: linear-gradient(135deg, #e8ecf4, #dfe3ed); }
        [data-theme="light"] .tf-info-panel h1 { color: #1a1a2e; }
        [data-theme="light"] .tf-info-panel p { color: #5a5f7a; }
        [data-theme="light"] .tf-form-panel { background: #ffffff; }
        [data-theme="light"] .tf-form-panel h2 { color: #1a1a2e; }
        [data-theme="light"] .tf-form-panel p { color: #5a5f7a; }
        [data-theme="light"] .tf-input-group input { background: #f4f6fb; border-color: #e2e6ef; color: #1a1a2e; }
        [data-theme="light"] .tf-input-group i { color: #8b90a5; }
        [data-theme="light"] .tf-alert-error { background: rgba(220,38,38,0.08); color: #dc2626; border-color: rgba(220,38,38,0.2); }
        [data-theme="light"] .tf-stat-card { background: rgba(0,0,0,0.03); border-color: #e2e6ef; }
        [data-theme="light"] .tf-stat-card span { color: #1a1a2e; }
        [data-theme="light"] .tf-footer-login { color: #5a5f7a; }

        .tf-theme-btn-login { width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(212,168,67,0.3); background: transparent; color: var(--tf-gray); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.95rem; transition: all 0.2s; }
        .tf-theme-btn-login:hover { background: rgba(212,168,67,0.1); color: var(--tf-gold); border-color: var(--tf-gold); transform: rotate(15deg); }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="tf-navbar">
        <a href="#" class="tf-navbar-brand">
            <i class="fas fa-briefcase"></i> TalentFlow
        </a>
        <div class="tf-navbar-links">
            <a href="{{ path('public_home') }}"><i class="fas fa-home"></i> {{ 'public.nav.home'|trans }}</a>
            <a href="{{ path('public_offres') }}"><i class="fas fa-briefcase"></i> {{ 'public.nav.offers_short'|trans }}</a>
            <a href="{{ path('app_switch_locale', {locale: 'fr'}) }}" class="{{ app.request.locale == 'fr' ? 'active' : '' }}">FR</a>
            <a href="{{ path('app_switch_locale', {locale: 'en'}) }}" class="{{ app.request.locale == 'en' ? 'active' : '' }}">EN</a>
            <button class="tf-theme-btn-login" onclick="TFTheme.toggle()" aria-label="{{ 'theme.change'|trans }}" title="{{ 'theme.toggle'|trans }}">
                <i class="fas fa-sun" id="theme-icon-sun"></i>
                <i class="fas fa-moon" id="theme-icon-moon" style="display:none;"></i>
            </button>
        </div>
    </nav>

    <div class="tf-page">
        <!-- LEFT: INFO PANEL -->
        <div class="tf-info-panel">
            <div class="tf-info-content">
                <h1>{{ 'login.welcome'|trans|raw }}</h1>
                <p class="tf-tagline">
                    {{ 'login.tagline'|trans }}
                </p>

                <div class="tf-features">
                    <div class="tf-feature">
                        <div class="tf-feature-icon"><i class="fas fa-bullhorn"></i></div>
                        <div class="tf-feature-text">
                            <h4>{{ 'login.feature.offers_title'|trans }}</h4>
                            <p>{{ 'login.feature.offers_text'|trans }}</p>
                        </div>
                    </div>
                    <div class="tf-feature">
                        <div class="tf-feature-icon"><i class="fas fa-file-alt"></i></div>
                        <div class="tf-feature-text">
                            <h4>{{ 'login.feature.applications_title'|trans }}</h4>
                            <p>{{ 'login.feature.applications_text'|trans }}</p>
                        </div>
                    </div>
                    <div class="tf-feature">
                        <div class="tf-feature-icon"><i class="fas fa-calendar-check"></i></div>
                        <div class="tf-feature-text">
                            <h4>{{ 'login.feature.interviews_title'|trans }}</h4>
                            <p>{{ 'login.feature.interviews_text'|trans }}</p>
                        </div>
                    </div>
                    <div class="tf-feature">
                        <div class="tf-feature-icon"><i class="fas fa-shield-alt"></i></div>
                        <div class="tf-feature-text">
                            <h4>{{ 'login.feature.security_title'|trans }}</h4>
                            <p>{{ 'login.feature.security_text'|trans }}</p>
                        </div>
                    </div>
                </div>

                <div class="tf-stats">
                    <div class="tf-stat">
                        <div class="tf-stat-num">3</div>
                        <div class="tf-stat-label">{{ 'login.stats.roles'|trans }}</div>
                    </div>
                    <div class="tf-stat">
                        <div class="tf-stat-num">5</div>
                        <div class="tf-stat-label">{{ 'login.stats.modules'|trans }}</div>
                    </div>
                    <div class="tf-stat">
                        <div class="tf-stat-num">2FA</div>
                        <div class="tf-stat-label">{{ 'login.stats.security'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: LOGIN FORM -->
        <div class="tf-login-panel">
            <div class="tf-login-box">
                <div class="tf-login-header">
                    <div class="icon-circle"><i class="fas fa-sign-in-alt"></i></div>
                    <h2>{{ 'page.login.title'|trans }}</h2>
                    <p>{{ 'login.access_space'|trans }}</p>
                </div>

                {% if lockout_minutes is not null %}
                    <div class="tf-alert tf-alert-error">
                        <i class="fas fa-ban"></i>
                        <div>{{ 'login.locked'|trans }}
                        <br><small>{{ 'login.retry_in'|trans({'%minutes%': lockout_minutes})|raw }}</small></div>
                    </div>
                {% endif %}

                {% if error %}
                    <div class="tf-alert tf-alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    </div>
                {% endif %}

                {% if remaining_attempts is not null and remaining_attempts > 0 %}
                    <div class="tf-alert tf-alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>{{ 'login.remaining_attempts'|trans({'%count%': remaining_attempts}) }}</div>
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">
                                     <i class="fas fa-envelope"></i> {{ 'page.login.email'|trans }}
                        </label>
                        <input type="email" value="{{ last_username }}" name="_username" id="inputEmail"
                                         class="form-control" placeholder="{{ 'login.email_placeholder'|trans }}" required autofocus
                               {% if lockout_minutes is not null %}disabled{% endif %}>
                    </div>

                    <div class="mb-3">
                        <label for="inputPassword" class="form-label">
                            <i class="fas fa-lock"></i> {{ 'page.login.password'|trans }}
                        </label>
                        <div class="input-group-icon">
                            <input type="password" name="_password" id="inputPassword"
                                class="form-control" placeholder="{{ 'login.password_placeholder'|trans }}" required
                                   {% if lockout_minutes is not null %}disabled{% endif %}>
                            <i class="fas fa-eye field-icon" id="togglePassword"></i>
                        </div>
                    </div>

                    <div class="tf-remember-row">
                        <label class="tf-remember-check" for="rememberMe">
                            <input type="checkbox" name="_remember_me" id="rememberMe" value="1">
                            <span>{{ 'page.login.remember_me'|trans }}</span>
                        </label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn-login mt-2" type="submit"
                            {% if lockout_minutes is not null %}disabled{% endif %}>
                        <i class="fas fa-arrow-right"></i> {{ 'page.login.submit'|trans }}
                    </button>
                </form>

                <div class="tf-divider"></div>

                <div class="text-center">
                    <a href="{{ path('app_forgot_password') }}" class="forgot-link">
                        <i class="fas fa-key"></i> {{ 'page.login.forgot_password'|trans }}
                    </a>
                </div>

                <div class="text-center mt-2">
                    <a href="{{ path('app_magic_link') }}" class="forgot-link">
                        <i class="fas fa-magic"></i> {{ 'login.magic_link'|trans }}
                    </a>
                </div>

                <div class="tf-divider"></div>

                <div class="tf-footer-login">
                    <i class="fas fa-lock"></i> {{ 'login.secure_footer'|trans }}
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function() {
            const input = document.getElementById('inputPassword');
            if (input.type === 'password') {
                input.type = 'text';
                this.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                this.classList.replace('fa-eye-slash', 'fa-eye');
            }
        });

        (function() {
            if (!window.sessionStorage) {
                return;
            }

            var saved = sessionStorage.getItem('tf-register-prefill');
            if (!saved) {
                return;
            }

            try {
                var data = JSON.parse(saved);
                var emailInput = document.getElementById('inputEmail');
                var passwordInput = document.getElementById('inputPassword');
                var rememberInput = document.getElementById('rememberMe');

                if (emailInput && !emailInput.value && data.email) {
                    emailInput.value = data.email;
                }

                if (passwordInput && !passwordInput.value && data.password) {
                    passwordInput.value = data.password;
                }

                if (rememberInput && data.remember) {
                    rememberInput.checked = true;
                }
            } catch (error) {
                sessionStorage.removeItem('tf-register-prefill');
            }
        })();

        document.querySelector('form[method="post"]').addEventListener('submit', function() {
            var rememberInput = document.getElementById('rememberMe');
            if (rememberInput && !rememberInput.checked && window.sessionStorage) {
                sessionStorage.removeItem('tf-register-prefill');
            }
        });

        var TFTheme={toggle:function(){var c=document.documentElement.getAttribute('data-theme')||'dark';var n=c==='dark'?'light':'dark';localStorage.setItem('tf-theme',n);document.documentElement.setAttribute('data-theme',n);document.documentElement.classList.toggle('dark',n==='dark');TFTheme._icons();},_icons:function(){var t=document.documentElement.getAttribute('data-theme');var s=document.getElementById('theme-icon-sun');var m=document.getElementById('theme-icon-moon');if(s&&m){s.style.display=t==='dark'?'':'none';m.style.display=t==='dark'?'none':'';}}};
        TFTheme._icons();
    </script>
</body>
</html>
