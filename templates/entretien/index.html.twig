{% extends is_granted('ROLE_ADMIN') ? 'base_dashboard.html.twig' : 'base_navbar.html.twig' %}

{% block title %}Gestion des Entretiens - TalentFlow{% endblock %}
{% block page_title %}Gestion des Entretiens{% endblock %}

{% block body %}
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon gold"><i class="fas fa-calendar-check"></i></div>
            <div class="tf-widget-info">
                <h3>{{ planifiesCount + realisesCount }}</h3>
                <p>Total visible</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon blue"><i class="fas fa-hourglass-half"></i></div>
            <div class="tf-widget-info">
                <h3>{{ planifiesCount }}</h3>
                <p>Planifiés</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon green"><i class="fas fa-check-double"></i></div>
            <div class="tf-widget-info">
                <h3>{{ realisesCount }}</h3>
                <p>Réalisés</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon purple"><i class="fas fa-gavel"></i></div>
            <div class="tf-widget-info">
                <h3>{{ pendingDecisions }}</h3>
                <p>Décisions en attente</p>
                <div class="trend up">{{ todayCount }} aujourd'hui</div>
            </div>
        </div>
    </div>
</div>

<div class="tf-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="tf-title mb-0"><i class="fas fa-calendar-days"></i> Liste des entretiens</h2>
        <div class="d-flex gap-2">
            <a href="{{ path('app_decision_finale_index') }}" class="btn-outline-gold"><i class="fas fa-gavel"></i> Décisions finales</a>
            <a href="{{ path('app_entretien_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvel entretien</a>
        </div>
    </div>

    <form method="get" action="{{ path('app_entretien_index') }}" id="entretien-search-form" autocomplete="off">
        <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:24px;">

            {# Champ texte #}
            <div style="flex:1; min-width:220px; position:relative;">
                <i class="fas fa-search" style="position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--tf-gray); pointer-events:none;"></i>
                <input type="text" name="search" id="entretien-search-input" value="{{ search }}"
                    placeholder="Rechercher par ID, lieu, commentaire..."
                    style="width:100%; padding:10px 14px 10px 38px; background:var(--tf-navy); border:1px solid var(--tf-border); border-radius:8px; color:var(--tf-white); font-size:0.9rem; outline:none; transition:border .2s;"
                    onfocus="this.style.borderColor='var(--tf-gold)'" onblur="this.style.borderColor='var(--tf-border)'">
            </div>

            {# Filtre statut — boutons toggle #}
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                {% set statuts = [['', 'Tous', 'fa-list'], ['PLANIFIE', 'Planifiés', 'fa-hourglass-half'], ['REALISE', 'Réalisés', 'fa-check-double'], ['ANNULE', 'Annulés', 'fa-ban']] %}
                {% for s in statuts %}
                <button type="button"
                    onclick="setFilter('statut','{{ s[0] }}')"
                    id="btn-statut-{{ s[0] ? s[0] : 'all' }}"
                    class="filter-btn {{ statut == s[0] ? 'filter-btn-active' : '' }}"
                    data-filter="statut" data-value="{{ s[0] }}">
                    <i class="fas {{ s[2] }}"></i> {{ s[1] }}
                </button>
                {% endfor %}
                <input type="hidden" name="statut" id="hidden-statut" value="{{ statut }}">
            </div>

            {# Filtre type — boutons toggle #}
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                {% set types = [['', 'Tous', 'fa-layer-group'], ['EN_LIGNE', 'En ligne', 'fa-video'], ['PRESENTIEL', 'Présentiel', 'fa-building'], ['TELEPHONIQUE', 'Tél.', 'fa-phone']] %}
                {% for t in types %}
                <button type="button"
                    onclick="setFilter('type','{{ t[0] }}')"
                    id="btn-type-{{ t[0] ? t[0] : 'all' }}"
                    class="filter-btn {{ type == t[0] ? 'filter-btn-active' : '' }}"
                    data-filter="type" data-value="{{ t[0] }}">
                    <i class="fas {{ t[2] }}"></i> {{ t[1] }}
                </button>
                {% endfor %}
                <input type="hidden" name="type" id="hidden-type" value="{{ type }}">
            </div>

            {# Effacer si filtre actif #}
            {% if search or statut or type %}
            <a href="{{ path('app_entretien_index') }}" title="Effacer les filtres"
               style="padding:9px 14px; border-radius:8px; border:1px solid var(--tf-border); color:var(--tf-gray); font-size:0.85rem; text-decoration:none; transition:all .2s; white-space:nowrap;"
               onmouseover="this.style.borderColor='var(--tf-gold)';this.style.color='var(--tf-gold)'"
               onmouseout="this.style.borderColor='var(--tf-border)';this.style.color='var(--tf-gray)'">
                <i class="fas fa-times"></i> Effacer
            </a>
            {% endif %}

        </div>
    </form>

    <style>
    .filter-btn {
        padding: 7px 13px;
        border-radius: 20px;
        border: 1px solid var(--tf-border);
        background: transparent;
        color: var(--tf-gray);
        font-size: 0.8rem;
        cursor: pointer;
        transition: all .18s;
        white-space: nowrap;
    }
    .filter-btn:hover { border-color: var(--tf-gold); color: var(--tf-gold); }
    .filter-btn-active { background: var(--tf-gold); border-color: var(--tf-gold); color: #1a2a4a !important; font-weight: 700; }
    </style>

    {% if entretiens|length > 0 %}
        <div class="tf-grid-cards" id="entretien-grid">
            {% for entretien in entretiens %}
            <div class="tf-item-card">
                <div class="tf-item-card-header">
                    <div>
                        <div class="tf-item-card-title">Entretien #{{ entretien.id }}</div>
                        <div class="tf-item-card-subtitle">
                            <i class="fas fa-file-alt"></i> Candidature #{{ entretien.candidatureId }}
                            <span style="display:block; font-size:0.78rem;">{{ candidatureLabels[entretien.candidatureId] ?? '—' }}</span>
                        </div>
                    </div>
                    {% if entretien.scoreFinal is not null %}
                    <div class="tf-score-circle {{ entretien.scoreFinal >= 14 ? 'tf-score-high' : (entretien.scoreFinal >= 10 ? 'tf-score-mid' : 'tf-score-low') }}">
                        {{ entretien.scoreFinal|number_format(1) }}
                    </div>
                    {% endif %}
                </div>
                <div class="tf-item-card-meta">
                    <span><i class="fas fa-calendar"></i> {{ entretien.dateHeure ? entretien.dateHeure|date('d/m/Y H:i') : '—' }}</span>
                    {% if entretien.lieu %}<span><i class="fas fa-map-marker-alt"></i> {{ entretien.lieu }}</span>{% endif %}
                    {% if entretien.lien %}<span><i class="fas fa-link"></i> En ligne</span>{% endif %}
                </div>
                <div class="tf-item-card-tags">
                    <span class="tf-tag-sm tf-tag-gold">{{ entretien.type ?: '—' }}</span>
                    {% set statColor = entretien.statut == 'REALISE' ? 'green' : (entretien.statut == 'ANNULE' ? 'red' : 'blue') %}
                    <span class="tf-tag-sm tf-tag-{{ statColor }}">{{ entretien.statut }}</span>
                    {% if entretien.scoreFinal is not null %}
                        <span class="tf-tag-sm tf-tag-gray">{{ entretien.niveau }}</span>
                    {% endif %}
                    {% if entretien.scoreFinal is not null %}
                        {% set sug = entretien.decisionSuggestion %}
                        {% set sugColor = sug == 'ACCEPTE' ? 'green' : (sug == 'REFUSE' ? 'red' : 'yellow') %}
                        <span class="tf-tag-sm tf-tag-{{ sugColor }}" title="Décision suggérée par le score">
                            <i class="fas fa-lightbulb"></i> {{ sug }}
                        </span>
                    {% endif %}
                </div>
                <div class="tf-item-card-meta" style="font-size:0.78rem;">
                    <span><i class="fas fa-laptop-code"></i> Tech: {{ entretien.noteTechnique ?? '—' }}</span>
                    <span><i class="fas fa-comments"></i> Com: {{ entretien.noteCommunication ?? '—' }}</span>
                </div>
                {% if entretien.type == 'EN_LIGNE' %}
                <div style="margin: 8px 0; display: flex; gap: 8px;">
                    <a href="{{ entretien.meetUrl }}" target="_blank" rel="noopener noreferrer"
                       class="btn btn-sm btn-outline-info" style="font-size:0.8rem; flex: 1;">
                        <i class="fas fa-video"></i> Rejoindre Meet
                    </a>
                    <a href="{{ path('app_live_coding_room', {'id': entretien.id}) }}"
                       class="btn btn-sm btn-outline-primary" style="font-size:0.8rem; flex: 1;">
                        <i class="fas fa-code"></i> Live Code
                    </a>
                </div>
                {% endif %}
                <div class="tf-item-card-actions">
                    {% if entretien.type == 'EN_LIGNE' %}
                    <a href="{{ path('app_mon_entretien', {'id': entretien.id}) }}" class="btn btn-sm btn-outline-info" title="Voir la salle Meet">
                        <i class="fas fa-video"></i>
                    </a>
                    <a href="{{ path('app_live_coding_room', {'id': entretien.id}) }}" class="btn btn-sm btn-outline-primary" title="Ouvrir Live Coding">
                        <i class="fas fa-code"></i> Live Code
                    </a>
                    {% endif %}
                    <a href="{{ path('app_entretien_edit', {'id': entretien.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Modifier</a>
                    <form method="post" action="{{ path('app_entretien_delete', {'id': entretien.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, 'entretien #{{ entretien.id }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_entretien_' ~ entretien.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="tf-card-empty">
            <i class="fas fa-calendar-xmark"></i>
            <p>Aucun entretien trouvé.</p>
        </div>
    {% endif %}
</div>
<script>
function setFilter(name, value) {
    document.getElementById('hidden-' + name).value = value;
    // Update active button style
    document.querySelectorAll('[data-filter="' + name + '"]').forEach(btn => {
        btn.classList.toggle('filter-btn-active', btn.dataset.value === value);
    });
    fetchEntretiens();
}

document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('entretien-search-input');
    const grid = document.getElementById('entretien-grid');
    let debounceTimer;

    function fetchEntretiens() {
        const form = document.getElementById('entretien-search-form');
        const params = new URLSearchParams(new FormData(form)).toString();
        fetch("{{ path('app_entretien_search') }}?" + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => { if(grid) grid.innerHTML = html; });
    }

    window.fetchEntretiens = fetchEntretiens;

    searchInput && searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(fetchEntretiens, 300);
    });
});
</script>
{% endblock %}