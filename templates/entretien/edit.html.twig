{% extends 'base_dashboard.html.twig' %}

{% block title %}Modifier Entretien - TalentFlow{% endblock %}
{% block page_title %}Modifier Entretien{% endblock %}

{% block body %}
<div class="tf-card" style="max-width: 860px; margin: 0 auto;">
    <h2 class="tf-title"><i class="fas fa-pen"></i> Modifier l'entretien #{{ entretien.id }}</h2>
    {{ include('entretien/_form.html.twig', {'button_label': 'Enregistrer', 'button_icon': 'fa-save'}) }}

    <div class="mt-3 d-flex gap-2">
        <a href="{{ path('app_entretien_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour</a>
        <a href="{{ path('app_decision_finale_index') }}" class="btn-outline-gold"><i class="fas fa-gavel"></i> Décisions</a>
    </div>
</div>
{% endblock %}