{% extends is_granted('ROLE_ADMIN') ? 'base_dashboard.html.twig' : 'base_navbar.html.twig' %}

{% block title %}Nouvel Entretien - TalentFlow{% endblock %}
{% block page_title %}Nouvel Entretien{% endblock %}

{% block body %}
<div class="tf-card" style="max-width: 860px; margin: 0 auto;">
    <h2 class="tf-title"><i class="fas fa-calendar-plus"></i> Planifier un entretien</h2>
    {{ include('entretien/_form.html.twig', {'button_label': 'Créer l\'entretien', 'button_icon': 'fa-calendar-plus', 'candidatures_dates': candidatures_dates}) }}

    <div class="mt-3">
        <a href="{{ path('app_entretien_index') }}" class="btn-outline-gold"><i class="fas fa-arrow-left"></i> Retour à la liste</a>
    </div>
</div>
{% endblock %}