{# Partial pour la grille AJAX des entretiens #}
{% for entretien in entretiens %}
<div class="tf-item-card">
    <div class="tf-item-card-header">
        <div>
            <div class="tf-item-card-title">Entretien #{{ entretien.id }}</div>
            <div class="tf-item-card-subtitle">
                <i class="fas fa-file-alt"></i> Candidature #{{ entretien.candidatureId }}
                <span style="display:block; font-size:0.78rem;">{{ candidatureLabels[entretien.candidatureId] ?? '—' }}</span>
            </div>
        </div>
        {% if entretien.scoreFinal is not null %}
        <div class="tf-score-circle {{ entretien.scoreFinal >= 14 ? 'tf-score-high' : (entretien.scoreFinal >= 10 ? 'tf-score-mid' : 'tf-score-low') }}">
            {{ entretien.scoreFinal|number_format(1) }}
        </div>
        {% endif %}
    </div>
    <div class="tf-item-card-meta">
        <span><i class="fas fa-calendar"></i> {{ entretien.dateHeure ? entretien.dateHeure|date('d/m/Y H:i') : '—' }}</span>
        {% if entretien.lieu %}<span><i class="fas fa-map-marker-alt"></i> {{ entretien.lieu }}</span>{% endif %}
        {% if entretien.lien %}<span><i class="fas fa-link"></i> {{ entretien.lien }}</span>{% endif %}
    </div>
    <div class="tf-item-card-tags">
        {% if entretien.type %}<span class="tf-tag-sm tf-tag-blue">{{ entretien.type }}</span>{% endif %}
        {% set sColor = entretien.statut == 'REALISE' ? 'green' : (entretien.statut == 'ANNULE' ? 'red' : 'blue') %}
        <span class="tf-tag-sm tf-tag-{{ sColor }}">{{ entretien.statut }}</span>
        {% if entretien.niveau %}<span class="tf-tag-sm tf-tag-gray">{{ entretien.niveau }}</span>{% endif %}
    </div>
    {% if entretien.noteTechnique is not null or entretien.noteCommunication is not null %}
    <div class="tf-item-card-body">
        {% if entretien.noteTechnique is not null %}Tech: {{ entretien.noteTechnique }}/20{% endif %}
        {% if entretien.noteCommunication is not null %} &bull; Com: {{ entretien.noteCommunication }}/20{% endif %}
    </div>
    {% endif %}
    <div class="tf-item-card-actions">
        <a href="{{ path('app_entretien_edit', {id: entretien.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
        <form method="post" action="{{ path('app_entretien_delete', {id: entretien.id}) }}" onsubmit="event.preventDefault(); confirmDelete(this, 'Entretien #' ~ entretien.id);" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_entretien_' ~ entretien.id) }}">
            <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
        </form>
    </div>
</div>
{% else %}
<div class="tf-card-empty">
    <i class="fas fa-inbox"></i>
    <p>Aucun entretien trouvé.</p>
</div>
{% endfor %}
