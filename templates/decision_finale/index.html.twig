{% extends is_granted('ROLE_ADMIN') ? 'base_dashboard.html.twig' : 'base_navbar.html.twig' %}

{% block title %}Décisions Finales - TalentFlow{% endblock %}
{% block page_title %}Décisions Finales{% endblock %}

{% block body %}
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon green"><i class="fas fa-check"></i></div>
            <div class="tf-widget-info"><h3>{{ acceptedCount }}</h3><p>Acceptées</p></div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon red"><i class="fas fa-times"></i></div>
            <div class="tf-widget-info"><h3>{{ refusedCount }}</h3><p>Refusées</p></div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon blue"><i class="fas fa-hourglass-half"></i></div>
            <div class="tf-widget-info"><h3>{{ pendingCount }}</h3><p>En attente</p></div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="tf-widget">
            <div class="tf-widget-icon gold"><i class="fas fa-arrows-rotate"></i></div>
            <div class="tf-widget-info"><h3>{{ realisedWithoutDecisionCount }}</h3><p>À générer</p></div>
        </div>
    </div>
</div>

<div class="tf-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="tf-title mb-0"><i class="fas fa-scale-balanced"></i> Liste des décisions finales</h2>
        <div class="d-flex gap-2">
            <a href="{{ path('app_entretien_index') }}" class="btn-outline-gold"><i class="fas fa-calendar-check"></i> Entretiens</a>
            <a href="{{ path('app_decision_finale_new') }}" class="btn-gold"><i class="fas fa-plus"></i> Nouvelle décision</a>
        </div>
    </div>

    {# ── Barre de recherche dynamique ── #}
    <form method="get" action="{{ path('app_decision_finale_index') }}" id="decision-search-form" autocomplete="off">
        <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:18px;">

            <div style="flex:1; min-width:220px; position:relative;">
                <i class="fas fa-search" style="position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--tf-gray); pointer-events:none;"></i>
                <input type="text" name="search" id="decision-search-input" value="{{ search }}"
                    placeholder="Rechercher par ID, motif..."
                    style="width:100%; padding:10px 14px 10px 38px; background:var(--tf-navy); border:1px solid var(--tf-border); border-radius:8px; color:var(--tf-white); font-size:0.9rem; outline:none; transition:border .2s;"
                    onfocus="this.style.borderColor='var(--tf-gold)'" onblur="this.style.borderColor='var(--tf-border)'">
            </div>

            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                {% set decisionFilters = [['', 'Toutes', 'fa-list'], ['ACCEPTE', 'Acceptées', 'fa-check'], ['REFUSE', 'Refusées', 'fa-times'], ['EN_ATTENTE', 'En attente', 'fa-hourglass-half']] %}
                {% for d in decisionFilters %}
                <button type="button"
                    onclick="setDecisionFilter('{{ d[0] }}')"
                    id="btn-dec-{{ d[0] ? d[0] : 'all' }}"
                    class="filter-btn {{ decisionFilter == d[0] ? 'filter-btn-active' : '' }}"
                    data-value="{{ d[0] }}">
                    <i class="fas {{ d[2] }}"></i> {{ d[1] }}
                </button>
                {% endfor %}
                <input type="hidden" name="decision" id="hidden-decision" value="{{ decisionFilter }}">
            </div>

            {% if search or decisionFilter %}
            <a href="{{ path('app_decision_finale_index') }}" title="Effacer"
               style="padding:9px 14px; border-radius:8px; border:1px solid var(--tf-border); color:var(--tf-gray); font-size:0.85rem; text-decoration:none; transition:all .2s;"
               onmouseover="this.style.borderColor='var(--tf-gold)';this.style.color='var(--tf-gold)'"
               onmouseout="this.style.borderColor='var(--tf-border)';this.style.color='var(--tf-gray)'">
                <i class="fas fa-times"></i> Effacer
            </a>
            {% endif %}
        </div>
    </form>

    <style>
    .filter-btn { padding:7px 13px; border-radius:20px; border:1px solid var(--tf-border); background:transparent; color:var(--tf-gray); font-size:0.8rem; cursor:pointer; transition:all .18s; white-space:nowrap; }
    .filter-btn:hover { border-color:var(--tf-gold); color:var(--tf-gold); }
    .filter-btn-active { background:var(--tf-gold); border-color:var(--tf-gold); color:#1a2a4a !important; font-weight:700; }
    </style>

    {# ── Actions : Générer + Auto-décision ── #}
    <div class="d-flex flex-wrap gap-2 align-items-end mb-4">
        <form method="post" action="{{ path('app_decision_finale_sync') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('decision_sync') }}">
            <button type="submit" class="btn-outline-gold"><i class="fas fa-arrows-rotate"></i> Générer</button>
        </form>
        <form method="post" action="{{ path('app_decision_finale_auto_decide') }}" class="d-flex gap-2 flex-wrap align-items-end">
            <input type="hidden" name="_token" value="{{ csrf_token('decision_auto_decide') }}">
            <div>
                <label style="display:block; color:var(--tf-gray); font-size:0.72rem; margin-bottom:4px;">Seuil acceptation</label>
                <input type="number" name="accept_threshold" value="14" step="0.5" min="0" max="20"
                    style="width:110px; padding:8px 10px; background:var(--tf-navy); border:1px solid var(--tf-border); border-radius:6px; color:var(--tf-white);">
            </div>
            <div>
                <label style="display:block; color:var(--tf-gray); font-size:0.72rem; margin-bottom:4px;">Seuil refus</label>
                <input type="number" name="reject_threshold" value="8" step="0.5" min="0" max="20"
                    style="width:110px; padding:8px 10px; background:var(--tf-navy); border:1px solid var(--tf-border); border-radius:6px; color:var(--tf-white);">
            </div>
            <button type="submit" class="btn-gold"><i class="fas fa-gears"></i> Auto</button>
        </form>
    </div>

    <div class="mb-3" style="color: var(--tf-gray); font-size: 0.82rem;">
        <i class="fas fa-circle-info"></i>
        <strong>Auto</strong> : accepte si score ≥ seuil acceptation, refuse si score &lt; seuil refus, sinon laisse en attente.
    </div>

    {% if decisions|length > 0 %}
        <div class="tf-grid-cards" id="decision-grid">
            {% for item in decisions %}
            <div class="tf-item-card">
                <div class="tf-item-card-header">
                    <div>
                        <div class="tf-item-card-title">Décision #{{ item.id }}</div>
                        <div class="tf-item-card-subtitle">
                            <i class="fas fa-calendar-check"></i> Entretien #{{ item.entretien.id }}
                            <span style="display:block;"><i class="fas fa-file-alt"></i> Candidature #{{ item.entretien.candidatureId }}</span>
                            <span style="display:block; font-size:0.78rem;">{{ candidatureEmails[item.entretien.candidatureId] ?? 'Email indisponible' }}</span>
                        </div>
                    </div>
                    {% if item.score is not null %}
                    <div class="tf-score-circle {{ item.score >= 14 ? 'tf-score-high' : (item.score >= 10 ? 'tf-score-mid' : 'tf-score-low') }}">
                        {{ item.score|number_format(1) }}
                    </div>
                    {% endif %}
                </div>
                <div class="tf-item-card-tags">
                    {% set decColor = item.decision == 'ACCEPTE' ? 'green' : (item.decision == 'REFUSE' ? 'red' : 'yellow') %}
                    <span class="tf-tag-sm tf-tag-{{ decColor }}">
                        <i class="fas {{ item.decision == 'ACCEPTE' ? 'fa-check' : (item.decision == 'REFUSE' ? 'fa-times' : 'fa-hourglass-half') }}"></i>
                        {{ item.decision }}
                    </span>
                    {% if item.score is not null %}
                        <span class="tf-tag-sm tf-tag-gray">{{ item.score|number_format(2) }}/20</span>
                        {% set sug = item.entretien ? item.entretien.decisionSuggestion : '' %}
                        {% if sug %}
                            {% set sugColor = sug == 'ACCEPTE' ? 'green' : (sug == 'REFUSE' ? 'red' : 'yellow') %}
                            <span class="tf-tag-sm tf-tag-{{ sugColor }}" title="Décision suggérée par le score">
                                <i class="fas fa-lightbulb"></i> {{ sug }}
                            </span>
                        {% endif %}
                    {% endif %}
                    {% if item.inconsistency %}
                        <span class="tf-tag-sm tf-tag-red" title="{{ item.inconsistencyMessage }}">
                            <i class="fas fa-triangle-exclamation"></i> Incohérence
                        </span>
                    {% endif %}
                </div>
                <div class="tf-item-card-meta">
                    <span><i class="fas fa-calendar"></i> {{ item.dateDecision ? item.dateDecision|date('d/m/Y H:i') : '—' }}</span>
                </div>
                {% if item.motif %}
                <div class="tf-item-card-body" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                    <i class="fas fa-quote-left" style="opacity:0.3; margin-right:0.3rem;"></i> {{ item.motif }}
                </div>
                {% endif %}
                {% if item.inconsistency %}
                <div style="margin:6px 0; padding:6px 10px; background:rgba(239,68,68,.12); border-left:3px solid #ef4444; border-radius:4px; font-size:0.78rem; color:#fca5a5;">
                    <i class="fas fa-triangle-exclamation"></i> {{ item.inconsistencyMessage }}
                </div>
                {% endif %}
                <div class="tf-item-card-actions">
                    {% if item.decision == 'EN_ATTENTE' %}
                        <form method="post" action="{{ path('app_decision_finale_update_status', {'id': item.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_status_decision_' ~ item.id) }}">
                            <input type="hidden" name="decision" value="ACCEPTE">
                            <button type="submit" class="btn btn-sm btn-outline-success"><i class="fas fa-check"></i> Accepter</button>
                        </form>
                        <form method="post" action="{{ path('app_decision_finale_update_status', {'id': item.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_status_decision_' ~ item.id) }}">
                            <input type="hidden" name="decision" value="REFUSE">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-times"></i> Refuser</button>
                        </form>
                    {% endif %}
                    <a href="{{ path('app_decision_finale_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                    <form method="post" action="{{ path('app_decision_finale_delete', {'id': item.id}) }}" style="display:inline;" onsubmit="event.preventDefault(); confirmDelete(this, 'décision #{{ item.id }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_decision_' ~ item.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="tf-card-empty">
            <i class="fas fa-scale-balanced"></i>
            <p>Aucune décision finale trouvée.</p>
        </div>
    {% endif %}
</div>
<script>
function setDecisionFilter(value) {
    document.getElementById('hidden-decision').value = value;
    document.querySelectorAll('[data-value]').forEach(btn => {
        btn.classList.toggle('filter-btn-active', btn.dataset.value === value);
    });
    fetchDecisions();
}

document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('decision-search-input');
    const grid = document.getElementById('decision-grid');
    let debounceTimer;

    function fetchDecisions() {
        const form = document.getElementById('decision-search-form');
        const params = new URLSearchParams(new FormData(form)).toString();
        fetch("{{ path('app_decision_finale_search') }}?" + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => { if(grid) grid.innerHTML = html; });
    }

    window.fetchDecisions = fetchDecisions;

    searchInput && searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(fetchDecisions, 300);
    });
});
</script>
{% endblock %}